<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_payment_plan_view_form_confirm" model="ir.ui.view">
    <field name="name">ifs.gar.payment.plan.view.form.confirm</field>
    <field name="model">ifs.gar.payment.plan</field>
    <field name="arch" type="xml">
      <form string="确认收款" class="o_galaxy_form_view" create="0" edit="0">
        <field name="currency_id" invisible="1"/>
        <sheet>
          <group string="银行账户信息">
            <group>
              <field name="account_name"/>
              <field name="account_no"/>
            </group>
            <group>
              <field name="deposit_bank"/>
            </group>
          </group>
          <group>
            <group colspan="2">
              <label for="payment_amount"/>
              <div class="oe_inline" style="display: inline;">
                <field name="payment_amount" class="oe_inline oe_monetary_lg"/>
                <span class="oe_monetary_uppercase">（大写）：<field name="payment_amount_uppercase" class="oe_inline"/></span>
              </div>
            </group>
          </group>
          <div class="o_ifs_center_img">
            <field name="payment_receipt" widget="image" nolabel="1" options="{'placeholder':'/galaxy_tdesign/static/src/img/plus.png', 'description': '转账凭据'}"/>
          </div>
        </sheet>
        <footer>
          <button name="action_settle" type="object" string="确认已收到" class="btn-primary" data-hotkey="c"/>
          <button string="取消" class="btn-default" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>