<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_repayment_order_view_search" model="ir.ui.view">
    <field name="name">ifs.gar.repayment.order.view.search</field>
    <field name="model">ifs.gar.repayment.order</field>
    <field name="arch" type="xml">
      <search>
        <field name="seq_code" string="还款单号"/>
        <field name="bill_code" string="账单编号"/>
        <field name="merchant_code"/>
        <field name="repay_amount"/>
        <field name="currency_id" groups="base.group_multi_currency"/>
        <separator/>
        <filter name="operate_type_refund" string="退款" domain="[('operate_type', '=', 'refund')]"/>
        <filter name="operate_type_repayment" string="还款" domain="[('operate_type', '=', 'repayment')]"/>
        <filter name="operate_type_fuse" string="熔断" domain="[('operate_type', '=', 'fuse')]"/>
        <group>
          <filter name="group_bill_code" context="{'group_by': 'bill_code'}" />
          <filter name="group_merchant_code" context="{'group_by': 'merchant_code'}" />
          <filter name="group_operate_type" context="{'group_by': 'operate_type'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="ifs_gar_repayment_order_view_tree" model="ir.ui.view">
    <field name="name">ifs.gar.repayment.order.view.tree</field>
    <field name="model">ifs.gar.repayment.order</field>
    <field name="arch" type="xml">
      <tree sample="1" create="0">
        <field name="currency_id" column_invisible="1"/>
        <field name="seq_code" string="还款单号"/>
        <field name="sub_loan_account_id" string="子账户"/>
        <field name="bill_id" string="账单"/>
        <field name="merchant_id"/>
        <field name="supplier_id"/>
        <field name="create_date"/>
        <field name="repay_amount" sum="总还款金额"/>
      </tree>
    </field>
  </record>

  <record id="ifs_gar_repayment_order_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.repayment.order.view.form</field>
    <field name="model">ifs.gar.repayment.order</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" class="o_galaxy_form_view">
        <field name="id" invisible="1"/>
        <field name="seq_code" invisible="1"/>
        <field name="currency_id" invisible="1"/>
        <sheet>
          <notebook>
            <page name="repayment_info" string="还款信息">
              <group string="基础信息" class="o_group_label_lg">
                <group>
                  <field name="seq_code" string="还款单号"/>
                  <field name="sub_loan_account_id" options="{'no_open': True}"/>
                  <field name="bill_id" options="{'no_open': True}"/>
                  <field name="repay_amount" string="还款金额"/>
                  <field name="create_date" string="还款日"/>
                </group>
                <group>
                  <field name="merchant_id"/>
                  <field name="supplier_id"/>
                  <field name="factor_id"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="ifs_gar_repayment_order_act_window" model="ir.actions.act_window">
    <field name="name">还款单</field>
    <field name="res_model">ifs.gar.repayment.order</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        未查询到还款单
      </p>
      <p>
        <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
      </p>
    </field>
  </record>
</odoo>
