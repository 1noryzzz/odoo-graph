<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_trade_order_payment_plan_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.trade.order.payment.plan.wizard.view.form</field>
    <field name="model">ifs.gar.trade.order.payment.plan.wizard</field>
    <field name="inherit_id" ref="ifs_gar_trade.ifs_gar_trade_order_wizard_view_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <xpath expr="//group[hasclass('o_ifs_gar_step_controller')]" position="before">
        <field name="currency_id" invisible="1"/>
        <field name="trade_order_id" invisible="1"></field>
        <div class="oe_button_box" name="button_box">
          <button class="oe_stat_button" icon="fa-credit-card" name="action_approved_quota" type="object">
            <div class="o_form_field o_stat_info">
              <span class="o_stat_text">授信额度</span>
              <field name="merchant_approved_quota"/>
            </div>
          </button>
          <button class="oe_stat_button" icon="fa-cny" name="action_available_quota" type="object">
            <div class="o_form_field o_stat_info">
              <span class="o_stat_text">可用额度</span>
              <field name="merchant_available_quota"/>
            </div>
          </button>
          <button class="oe_stat_button" icon="fa-inbox" name="action_used_quota" type="object">
            <div class="o_form_field o_stat_info">
              <span class="o_stat_text">已用额度</span>
              <field name="merchant_used_quota"/>
            </div>
          </button>
        </div>
        <group name="merchant_info" string="目标企业" class="o_group_label_lg">
          <group>
            <field name="merchant_name"/>
          </group>
          <group>
            <field name="merchant_code"/>
          </group>
        </group>
        <group name="withdrawal_info" string="提款要素" class="o_group_label_lg">
          <group>
            <field name="order_code" />
            <field name="trade_amount" />
            <field name="withdrawal_amount" />
            <field name="credit_term"/>
          </group>
          <group>
            <field name="trade_date" />
            <field name="trade_start_date" />
            <field name="repayment_date" />
            <field name="days_left"/>
          </group>
        </group>
        <group name="payment_plan" string="还款设置" class="o_group_label_lg">
          <group>
            <field name="payment_mode"/>
            <field name="period_count" widget="integer" readonly="payment_mode == 'single'" force_save="1"/>
          </group>
          <group>
            <field name="fee_payer" readonly="payment_mode == 'single'" force_save="1"/>
          </group>
          <group colspan="2">
            <field name="plan_ids" mode="tree" readonly="payment_mode == 'single'" force_save="1">
              <tree no_open="1" editable="bottom" create="0" delete="0">
                <field name="currency_id" invisible="1"/>
                <field name="trade_order_id" invisible="1" force_save="1"/>
                <field name="payment_period" readonly="1" force_save="1"/>
                <field name="repayment_date"/>
                <field name="days_left"/>
                <field name="period_amount" sum="本金合计"/>
                <!-- <field name="fee" sum="预估手续费合计"/> -->
              </tree>
            </field>
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
