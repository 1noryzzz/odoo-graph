<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="wechat_menu_gar_default_menu" model="wechat.menu">
      <field name="name">鸥贝云默认菜单</field>
    </record>
    <record id="wechat_menu_gar_inviter_menu" model="wechat.menu">
      <field name="name">鸥贝云供应商业务员菜单</field>
    </record>

    <record id="wechat_menu_item_view_binding" model="wechat.menu.item.view">
      <field name="name">用户绑定</field>
      <field name="url">https://ifs.yzbfp.com/wechat/ifs_gar_binding?is_mobile=1</field>
    </record>
    <record id="wechat_menu_item_view_index" model="wechat.menu.item.view">
      <field name="name">业务介绍</field>
      <field name="url">https://ifs.yzbfp.com</field>
    </record>
    <record id="wechat_menu_item_view_invite" model="wechat.menu.item.view">
      <field name="name">邀请采购方</field>
      <field name="url">https://ifs.yzbfp.com/ifs_gar_invite/create?is_mobile=1</field>
    </record>

    <record id="wechat_menu_item_binding" model="wechat.menu.item">
      <field name="name">用户绑定</field>
      <field name="sequence">1</field>
      <field name="menu_id" ref="ifs_prod_gar.wechat_menu_gar_default_menu"/>
      <field name="type" eval="'wechat.menu.item.view,' + str(ref('ifs_prod_gar.wechat_menu_item_view_binding'))"/>
    </record>
    <record id="wechat_menu_item_about_us" model="wechat.menu.item">
      <field name="name">关于我们</field>
      <field name="sequence">2</field>
      <field name="menu_id" ref="ifs_prod_gar.wechat_menu_gar_default_menu"/>
      <field name="type" eval="'wechat.menu.item.view,' + str(ref('ifs_prod_gar.wechat_menu_item_view_index'))"/>
    </record>

    <record id="wechat_menu_item_invite" model="wechat.menu.item">
      <field name="name">邀请采购方</field>
      <field name="sequence">1</field>
      <field name="menu_id" ref="ifs_prod_gar.wechat_menu_gar_inviter_menu"/>
      <field name="type" eval="'wechat.menu.item.view,'+ str(ref('ifs_prod_gar.wechat_menu_item_view_invite'))"/>
    </record>
    <record id="wechat_menu_item_about_us_supplier" model="wechat.menu.item">
      <field name="name">关于我们</field>
      <field name="sequence">2</field>
      <field name="menu_id" ref="ifs_prod_gar.wechat_menu_gar_inviter_menu"/>
      <field name="type" eval="'wechat.menu.item.view,' + str(ref('ifs_prod_gar.wechat_menu_item_view_index'))"/>
    </record>
  </data>
</odoo>
