<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="gar_s_four_columns" name="四列-功能介绍">
    <section class="o_cc o_cc2" data-vcss="002">
      <div class="four_columns_gar_container">
        <div class="gar_body_container">
          <div class="gar_card_body">
            <img class="gar_card_icon" src="/ifs_prod_gar/static/src/snippets/s_four_columns/img/2003.png"/>
            <div class="gar_card_title">经销商账期内免息</div>
            <p class="gar_card_text">经销商在与核心企业约定账期
还款时间内，由核心企业承担
利息，降低经销商用信成本</p>
          </div>

          <div class="gar_card_body">
            <img class="gar_card_icon" src="/ifs_prod_gar/static/src/snippets/s_four_columns/img/2000.png"/>
            <div class="gar_card_title">快速筛选客户</div>
            <p class="gar_card_text">通过应收保信用管理平台
风控模型迅速筛选您的目标客户</p>
          </div>

          <div class="gar_card_body">
            <img class="gar_card_icon" src="/ifs_prod_gar/static/src/snippets/s_four_columns/img/2001.png"/>
            <div class="gar_card_title">供应链状态实时掌握</div>
            <p class="gar_card_text">应收保每月提供供应链健康
报告给核心企业，核心
企业可以依据报告迅速调整
市场营销策略</p>
          </div>

          <div class="gar_card_body">
            <img class="gar_card_icon" src="/ifs_prod_gar/static/src/snippets/s_four_columns/img/2002.png"/>
            <div class="gar_card_title">信用积累</div>
            <p class="gar_card_text">核心企业及其经销商利用应收
保业务产生的交易积累的信用，
有利于后期与更多的金融机构
合作</p>
          </div>
        </div>
      </div>
    </section>
  </template>

  <record id="ifs_prod_gar.s_four_columns_002_scss" model="ir.asset">
    <field name="name">Four columns 002 SCSS</field>
    <field name="bundle">web.assets_frontend</field>
    <field name="path">ifs_prod_gar/static/src/snippets/s_four_columns/scss/001.scss</field>
    <field name="active" eval="True"/>
  </record>

</odoo>
