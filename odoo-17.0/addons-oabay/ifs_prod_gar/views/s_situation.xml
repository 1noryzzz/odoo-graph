<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="gar_s_situation" name="状况-企业现状">
    <section class="o_cc o_cc2" data-vcss="001">
      <div class="s_references o_mail_snippet_general" data-snippet="s_references">
        <div class="gar_container gar_situation_container">
          <div class="gar_title_body">
            <div class="gar_text_zh">企业的现状</div>
            <div class="gar_text_en">Current situation of the enterprise</div>
          </div>
          <div class="gar_situation_body">
            <div class="gar_body_sides gar_left">
              <div class="gar_body_sides_item gar_left_item_top">
                <div class="gar_text_padding">账款逾期严重</div>
                <img class="gar_circle" src="/ifs_prod_gar/static/src/snippets/s_situation/img/circle.png"/>
              </div>
              <div class="gar_body_sides_item">
                <div class="gar_text_padding">纠纷处理举证繁琐</div>
                <img class="gar_circle" src="/ifs_prod_gar/static/src/snippets/s_situation/img/circle.png"/>
              </div>
              <div class="gar_body_sides_item gar_left_item_bottom">
                <div class="gar_text_padding">诉讼周期长</div>
                <img class="gar_circle" src="/ifs_prod_gar/static/src/snippets/s_situation/img/circle.png"/>
              </div>
            </div>
            <img class="gar_img" src="/ifs_prod_gar/static/src/snippets/s_situation/img/2_objects.png"/>
            <div class="gar_body_sides gar_right">
              <div class="gar_body_sides_item gar_right_item_top">
                <img class="gar_circle" src="/ifs_prod_gar/static/src/snippets/s_situation/img/circle.png"/>
                <div class="gar_text_padding">供应链货款违约成本低</div>
              </div>
              <div class="gar_body_sides_item">
                <img class="gar_circle" src="/ifs_prod_gar/static/src/snippets/s_situation/img/circle.png"/>
                <div class="gar_text_padding">应收账款管理成本过高</div>
              </div>
              <div class="gar_body_sides_item gar_right_item_bottom">
                <img class="gar_circle" src="/ifs_prod_gar/static/src/snippets/s_situation/img/circle.png"/>
                <div class="gar_text_padding">催款容易破坏客群关系</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </template>

  <record id="ifs_prod_gar.gar_s_situation_001_scss" model="ir.asset">
    <field name="name">Situation 001 SCSS</field>
    <field name="bundle">web.assets_frontend</field>
    <field name="path">ifs_prod_gar/static/src/snippets/s_situation/scss/001.scss</field>
    <field name="active" eval="True"/>
  </record>

</odoo>
