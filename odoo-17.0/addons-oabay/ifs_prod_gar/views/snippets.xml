<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="place_into_bar" inherit_id="website.snippets" name="Place into bar">
    <xpath expr="//div[@id='snippet_structure']/div[@class='o_panel_body']" position="before">
      <div class="o_panel_body">
        <t t-snippet="ifs_prod_gar.gar_s_three_columns" t-thumbnail="/ifs_prod_gar/static/src/snippets/s_three_columns/img/1008.png"/>
        <t t-snippet="ifs_prod_gar.gar_s_four_columns" t-thumbnail="/ifs_prod_gar/static/src/snippets/s_four_columns/img/1006.png"/>
        <t t-snippet="ifs_prod_gar.gar_s_references" t-thumbnail="/ifs_prod_gar/static/src/snippets/s_references/img/1009.png"/>
        <t t-snippet="ifs_prod_gar.gar_s_situation" t-thumbnail="/ifs_prod_gar/static/src/snippets/s_situation/img/1001.png"/>
        <t t-snippet="ifs_prod_gar.gar_s_solutions" t-thumbnail="/ifs_prod_gar/static/src/snippets/s_solutions/img/25_objects.png"/>
        <t t-snippet="ifs_prod_gar.gar_s_footer" t-thumbnail="/website/static/src/img/snippets_options/footer_template_default.svg"/>
        <t t-snippet="ifs_prod_gar.gar_s_management_system" t-thumbnail="/ifs_prod_gar/static/src/snippets/s_management_system/img/5004.png"/>
      </div>
    </xpath>
  </template>
</odoo>
