<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="gar_s_three_columns" name="三列-业务介绍">
    <section class="s_three_columns o_cc o_cc2" data-vcss="001">
      <div class="gar_container">
        <div class="gar_title_body">
          <div class="gar_text_zh">业务支撑体系</div>
          <div class="gar_text_color">Business support system</div>
        </div>
        <div class="row d-flex align-items-stretch">
          <div class="col-lg-4 s_col_no_bgcolor pt16 pb16 gar_s_col">
            <div class="card bg-white h-100 gar_card">
              <div class="card-body gar_card_body">
                <img class="gar_card_icon" src="/ifs_prod_gar/static/src/snippets/s_three_columns/img/9898.png"/>
                <div class="card-title gar_card_title">律师事务所</div>
                <p class="card-text">湾区律师事务所为应收保指定法律服务机构，为应收保业务提供司法服务；湾区律所作为粤港澳大湾区品牌律所，联合深圳律协强大的律师群体及公检法纪检司长期办案经验丰富的退职专家顾问，打造高效协同的法律职业共同体。 
湾区律师充分运用卓有成效的法律工具和办案资源，精准制订策略及综合解决方案.</p>
              </div>
            </div>
          </div>
          <div class="col-lg-4 s_col_no_bgcolor pt16 pb16 gar_s_col">
            <div class="card bg-white h-100 gar_card">
              <div class="card-body gar_card_body">
                <img class="gar_card_icon" src="/ifs_prod_gar/static/src/snippets/s_three_columns/img/3434.png"/>
                <div class="card-title gar_card_title">技术支撑</div>
                <p class="card-text">应收保业务管理系统由开发多年商业保理系统开发经验 的云腾智慧技术有限公司开发， 根据业务的多样性不断迭代升级系统， 为该业务保驾护航；</p>
              </div>
            </div>
          </div>
          <div class="col-lg-4 s_col_no_bgcolor pt16 pb16 gar_s_col">
            <div class="card bg-white h-100 gar_card">
              <div class="card-body gar_card_body">
                <img class="gar_card_icon" src="/ifs_prod_gar/static/src/snippets/s_three_columns/img/2312.png"/>
                <div class="card-title gar_card_title">金融资质</div>
                <p class="card-text">鸥贝云信用科技（深圳）有限公司致力于小 微企业供应链管理业务多年，专注于企业 供应链研究并开发相应产品为企业解决供 应链账期问题；</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </template>

  <record id="ifs_prod_gar.s_three_columns_001_scss" model="ir.asset">
    <field name="name">Three columns 001 SCSS</field>
    <field name="bundle">web.assets_frontend</field>
    <field name="path">ifs_prod_gar/static/src/snippets/s_three_columns/scss/001.scss</field>
    <field name="active" eval="True"/>
  </record>

</odoo>
