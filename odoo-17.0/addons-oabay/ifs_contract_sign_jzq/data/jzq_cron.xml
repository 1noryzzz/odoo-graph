<?xml version="1.0" ?>
<odoo>
  <data>
    <record id="contract_download_cron" model="ir.cron">
      <field name="name">云腾智慧合同：刷新未成功下载的合同</field>
      <field name="model_id" ref="ifs_contract.model_ifs_contract_info"/>
      <field name="state">code</field>
      <field name="code">model.jzq_refresh()</field>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
    </record>

    <record id="refresh_commit_contract_cron" model="ir.cron">
      <field name="name">云腾智慧合同：刷新已提交到君子签的合同</field>
      <field name="model_id" ref="ifs_contract.model_ifs_contract_info"/>
      <field name="state">code</field>
      <field name="code">model.jzq_refresh_commit_contract()</field>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
    </record>
  </data>
</odoo>
