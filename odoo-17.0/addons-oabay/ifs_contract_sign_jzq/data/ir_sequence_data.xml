<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="seq_ifs_base_company_jzq_acc" model="ir.sequence">
      <field name="name">君子签账号</field>
      <field name="code">ifs.base.company.jzq_acc</field>
      <field name="prefix">JZQ%(year)s%(month)s%(day)s</field>
      <field name="padding">3</field>
      <field name="company_id" eval="False"/>
    </record>
    <record id="seq_ifs_contract_bus_code" model="ir.sequence">
      <field name="name">合同业务编号</field>
      <field name="code">ifs.contract.bus.code</field>
      <field name="prefix">%(year)s%(month)s%(day)s</field>
      <field name="padding">4</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>