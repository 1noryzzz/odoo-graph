<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record forcecreate="True" id="jzq_callback_action_sign" model="oa.callback.action">
      <field name="name">君子签：签约</field>
      <field name="model_id" ref="ifs_contract.model_ifs_contract_info"/>
      <field name="state">code</field>
      <field name="code">action = env['ifs.contract.info'].sign_sync()</field>
      <field name="value_code_ids" eval="[(6, 0, [ref('jzq_callback_code_event_sign')])]"/>
    </record>

    <record forcecreate="True" id="jzq_callback_action_organization" model="oa.callback.action">
      <field name="name">君子签：企业实名认证</field>
      <field name="model_id" ref="ifs_base.model_ifs_base_company_mixin"/>
      <field name="state">code</field>
      <field name="code">action = env['ifs.base.company.mixin'].organization_sync()</field>
      <field name="value_code_ids" eval="[(6, 0, [ref('jzq_callback_code_event_organization')])]"/>
    </record>

  </data>
</odoo>