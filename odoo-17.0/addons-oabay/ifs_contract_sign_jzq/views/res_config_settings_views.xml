<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.ifs.contract.sign.jzq</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="120"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//setting[@name='ifs_external_api_setting_container']" position="after">
        <setting name="ifs_contract_jzq_setting_container" string="君子签环境配置">
          <div class="text-muted">
            <field name="jzq_test_env"/>
              是否启用测试环境
          </div>
          <div invisible="not jzq_test_env">
            <div class="mt16">
              <label class="col-lg-3" for="jzq_service_url_test"/>
              <field name="jzq_service_url_test"/>
            </div>
            <div class="mt8">
              <label class="col-lg-3" for="jzq_app_key_test"/>
              <field name="jzq_app_key_test"/>
            </div>
            <div class="mt8">
              <label class="col-lg-3" for="jzq_app_secret_test"/>
              <field name="jzq_app_secret_test"/>
            </div>
            <div class="text-muted">
              <a href="http://web.sandbox.junziqian.com/login" target="_blank">测试环境控制台</a>
            </div>
          </div>
          <div invisible="jzq_test_env">
            <div class="mt16">
              <label class="col-lg-3" for="jzq_service_url"/>
              <field name="jzq_service_url"/>
            </div>
            <div class="mt8">
              <label class="col-lg-3" for="jzq_app_key"/>
              <field name="jzq_app_key"/>
            </div>
            <div class="mt8">
              <label class="col-lg-3" for="jzq_app_secret"/>
              <field name="jzq_app_secret"/>
            </div>
            <div class="text-muted">
              <a href="https://web.junziqian.com/login" target="_blank">生产环境控制台</a>
            </div>
          </div>
        </setting>
      </xpath>
    </field>
  </record>
</odoo>
