<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="oa_group_category" model="ir.module.category">
    <field name="name">OA</field>
    <field name="visible" eval="0"/>
    <field name="description">OA系统</field>
  </record>

  <record id="oa_integrated_group_category" model="ir.module.category">
    <field name="name">集成办公</field>
    <field name="parent_id" ref="oa_integrated.oa_group_category"/>
    <field name="visible" eval="0"/>
    <field name="description">OA系统与第三方软件集成</field>
  </record>

  <record id="group_oa_integrated_manager" model="res.groups">
    <field name="name">管理员</field>
    <field name="category_id" ref="oa_integrated.oa_integrated_group_category"/>
    <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_oa_integrated_push_service" model="res.groups">
    <field name="name">消息推送</field>
    <field name="category_id" ref="oa_integrated.oa_integrated_group_category"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="base.group_system" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('oa_integrated.group_oa_integrated_manager'))]"/>
  </record>
</odoo>
