<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ir.cron -->
  <record id="oa_callback_action_view_form" model="ir.ui.view">
    <field name="name">oa.callback.action.view.form</field>
    <field name="model">oa.callback.action</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="base.view_server_action_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='create_action']" position="replace">
      </xpath>
      <xpath expr="//button[@name='unlink_action']" position="replace">
      </xpath>
      <xpath expr="//button[@name='run']" position="replace">
      </xpath>
      <xpath expr="//group[@name='action_content']" position="inside">
        <field name="user_id"/>
        <field name="active" widget="boolean_toggle"/>
        <field name="value_code_ids" widget="many2many_tags" options="{'no_create': True}"/>
        <field name="value_from"/>
      </xpath>
      <field name="state" position="attributes">
        <attribute name="invisible">1</attribute>
      </field>
    </field>
  </record>

  <record id="oa_callback_action_view_tree" model="ir.ui.view">
    <field name="model">oa.callback.action</field>
    <field name="arch" type="xml">
      <tree string="回调事件" decoration-muted="(not active)">
        <field name="name"/>
        <field name="model_id"/>
        <field name="value_code_ids" widget="many2many_tags"/>
        <field name="value_from"/>
        <field name="user_id" column_invisible="1"/>
        <field name="active" widget="boolean_toggle"/>
      </tree>
    </field>
  </record>

  <record id="oa_callback_action_view_search" model="ir.ui.view">
    <field name="model">oa.callback.action</field>
    <field name="arch" type="xml">
      <search string="回调事件">
        <field name="name" string="回调事件名称"/>
        <field name="user_id"/>
        <field name="model_id"/>
        <field name="value_code_ids"/>
        <field name="value_from"/>
        <field name="active"/>
        <separator/>
        <filter string="All" name="all" domain="['|', ('active', '=', False), ('active', '=', True)]" />
        <separator/>
        <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
        <group expand="0" string="Group By">
          <filter string="User" name="user" domain="[]" context="{'group_by': 'user_id'}"/>
          <filter string="回调事件来源" name="value_from" domain="[]" context="{'group_by': 'value_from'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="oa_callback_action_act" model="ir.actions.act_window">
    <field name="name">回调事件</field>
    <field name="res_model">oa.callback.action</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_all': 1}</field>
    <field name="view_id" ref="oa_callback_action_view_tree"/>
  </record>

  <menuitem id="menu_oa_callback_action_act" action="oa_callback_action_act" parent="base.menu_automation"/>

</odoo>
