<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="oa_org_synchronous_form_view" model="ir.ui.view">
    <field name="name">oa.org.synchronous.form</field>
    <field name="model">oa.org.synchronous</field>
    <field name="arch" type="xml">
      <form>
        <div class="alert alert-info" role="alert">
          <p>选择需要同步的企业，同步开始后，此窗口会立即关闭，任务在后台运行，请稍后去相关界面查看同步结果。</p>
        </div>
        <group>
          <field name="company_ids" widget="many2many_tags" options="{'no_create':1, 'no_open':1}"/>
        </group>
        <group>
          <group string="同步内容">
            <field name="department" widget="boolean_toggle"/>
            <field name="employee" widget="boolean_toggle"/>
          </group>
          <group string="同步选项">
            <field name="synchronous_dept_detail" widget="boolean_toggle"
              invisible="department == False"/>
            <field name="repeat_type" widget="radio" options="{'horizontal': true}"/>
          </group>
        </group>
        <footer>
          <button string="立即同步" name="start_synchronous_data" type="object" class="oe_highlight"/>
          <button string="取消" class="btn btn-default" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="oa_organization_sync_act_window" model="ir.actions.act_window">
    <field name="name">组织结构同步</field>
    <field name="res_model">oa.org.synchronous</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
