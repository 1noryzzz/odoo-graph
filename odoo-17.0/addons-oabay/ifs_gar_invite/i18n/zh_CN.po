"        <tr>\n"
"          <td align=\"center\">\n"
"            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"padding: 16px; background-color: white; color: #454748; border-collapse:separate;\">\n"
"              <tbody>\n"
"                <!-- HEADER -->\n"
"                <tr>\n"
"                  <td style=\"min-width: 590px;\">\n"
"                    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                      致 <br/>\n"
"                      <t t-out=\"object.company_id.name\" data-oe-t-inline=\"true\" contenteditable=\"false\" oe-keep-contenteditable=\"\">\n"
"                        ***********有限公司</t>， <t t-out=\"object.name\" data-oe-t-inline=\"true\" contenteditable=\"false\" oe-keep-contenteditable=\"\">***</t>\n"
"                      <br/>\n"
"\n"
"\n"
"                    </p>\n"
"                  </td>\n"
"                </tr>\n"
