<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_gar_invite_supplier_act_window" model="ir.actions.act_window">
    <field name="name">供应方邀请</field>
    <field name="res_model">ifs.gar.invite.supplier</field>
    <field name="view_mode">tree,kanban,form</field>
    <field name="context">{ 'search_default_group_state': True }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
          点击左上角的“邀请”，让我们开始吧！
      </p>
      <p>
        <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
      </p>
    </field>
  </record>

  <record id="ifs_gar_invite_franchisee_act_window" model="ir.actions.act_window">
    <field name="name">合伙人邀请</field>
    <field name="res_model">ifs.gar.invite.franchisee</field>
    <field name="view_mode">tree,kanban,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
          点击左上角的“邀请”，让我们开始吧！
      </p>
      <p>
        <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
      </p>
    </field>
  </record>

  <record id="ifs_gar_invite_lawfirm_act_window" model="ir.actions.act_window">
    <field name="name">律师事务所邀请</field>
    <field name="res_model">ifs.gar.invite.lawfirm</field>
    <field name="view_mode">tree,kanban,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
          点击左上角的“邀请”，让我们开始吧！
      </p>
      <p>
        <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
      </p>
    </field>
  </record>

  <record id="ifs_gar_invite_merchant_act_window" model="ir.actions.act_window">
    <field name="name">采购方邀请</field>
    <field name="res_model">ifs.gar.invite.merchant</field>
    <field name="view_mode">tree,kanban,form</field>
    <field name="context">{ 'search_default_group_state': True }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
          点击左上角的“创建”邀请，让我们开始吧！
      </p>
      <p>
        <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
      </p>
    </field>
  </record>

  <menuitem id="ifs_gar_invite_menu" name="邀请合作伙伴" 
    groups="ifs_partner.group_ifs_partner_user" parent="ifs_partner.ifs_partner_menu" sequence="2"/>

  <menuitem id="ifs_gar_invite_supplier_menu" name="供应方" 
    action="ifs_gar_invite.ifs_gar_invite_supplier_act_window" groups="ifs_partner.group_ifs_partner_factor_user,ifs_gar_invite.group_ifs_gar_invite_supplier_franchisee" 
    parent="ifs_gar_invite_menu" sequence="1"/>

  <menuitem id="ifs_gar_invite_merchant_menu" name="采购方" 
    action="ifs_gar_invite.ifs_gar_invite_merchant_act_window" groups="ifs_gar_invite.group_ifs_gar_invite_merchant,ifs_partner.group_ifs_partner_factor_manager" 
    parent="ifs_gar_invite_menu" sequence="2"/>

  <menuitem id="ifs_gar_invite_franchisee_menu" name="合伙人" 
    action="ifs_gar_invite.ifs_gar_invite_franchisee_act_window" groups="ifs_gar_invite.group_ifs_gar_invite_franchisee" 
    parent="ifs_gar_invite_menu" sequence="3"/>

  <menuitem id="ifs_gar_invite_lawfirm_menu" name="律师事务所" 
    action="ifs_gar_invite.ifs_gar_invite_lawfirm_act_window" groups="ifs_gar_invite.group_ifs_gar_invite_lawfirm" 
    parent="ifs_gar_invite_menu" sequence="4"/>


</odoo>