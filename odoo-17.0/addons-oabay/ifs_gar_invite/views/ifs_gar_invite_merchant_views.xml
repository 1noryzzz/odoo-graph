<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_gar_invite_merchant_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.invite.merchant.view.form</field>
    <field name="model">ifs.gar.invite.merchant</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_base.ifs_base_company_view_form" />
    <field name="arch" type="xml">
      <form position="attributes">
        <attribute name="string">进件邀约</attribute>
        <attribute name="js_class">ifs_partner_form</attribute>
      </form>
      <header position="inside">
        <field name="can_send" invisible="1"/>
        <button name="action_reinvite" type="object" string="重发邀请信" class="btn-primary"
          invisible="not can_send"
          groups="ifs_gar_invite.group_ifs_gar_invite_merchant" />
        <field name="state" widget="statusbar"/>
      </header>
      <field name="company_id" position="after">
        <field name="ifs_company_id" invisible="1"/>
      </field>
      <span name="ifs_base_company_code" position="replace">
        <span invisible="not seq_code">受邀采购方编号：<field name="seq_code" class="oe_inline" /></span>
      </span>
      <field name="name" position="attributes">
        <attribute name="placeholder">采购方名称</attribute>
      </field>
      <group name="gp_account" position="replace"/>
      <group name="gp_docs" position="replace"/>
    </field>
  </record>

  <record id="ifs_gar_invite_merchant_view_tree" model="ir.ui.view">
    <field name="name">ifs.gar.invite.merchant.view.tree</field>
    <field name="model">ifs.gar.invite.merchant</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_base.ifs_base_company_view_tree" />
    <field name="arch" type="xml">
      <tree position="attributes">
        <attribute name="string">采购方列表</attribute>
        <attribute name="js_class">partner_invite</attribute>
        <attribute name="expand">1</attribute>
        <attribute name="decoration-muted">state in ['ready', 'rejected']</attribute>
        <attribute name="decoration-primary">state == 'auditing'</attribute>
        <attribute name="decoration-bf">state == 'tobesign'</attribute>
      </tree>
      <field name="company_code" position="before">
        <field name="seq_code" string="受邀采购方编号"/>
      </field>
      <field name="name" position="after">
        <field name="supplier_id" optional="show" groups="ifs_partner.group_ifs_partner_factor_user"/>
      </field>
      <field name="company_registry" position="attributes">
        <attribute name="optional">hide</attribute>
      </field>
      <field name="email" position="after">
        <field name="invite_date" widget="date"/>
        <field name="write_date" widget="date" string="最后修改日期" optional="show"/>
        <field name="write_uid" widget="many2one_avatar_user" string="最后修改人" optional="show"/>
        <field name="state" string="状态" widget="badge" 
          decoration-info="state == 'waiting'"
          decoration-primary="state == 'auditing'" 
          decoration-danger="state == 'rejected'"
          decoration-warning="state == 'tobesign'"
          decoration-success="state == 'ready'"/>
      </field>
    </field>
  </record>

  <record id="ifs_gar_invite_merchant_view_search" model="ir.ui.view">
    <field name="name">ifs.gar.invite.merchant.view.search</field>
    <field name="model">ifs.gar.invite.merchant</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_base.ifs_base_company_view_search" />
    <field name="arch" type="xml">
      <search position="attributes">
        <attribute name="string">采购方查询</attribute>
      </search>
      <search position="inside">
        <field name="seq_code" string="采购方编号"/>
        <field name="supplier_id" string="发出邀请的供应方" groups="ifs_partner.group_ifs_partner_factor_user"/>
        <searchpanel>
          <field name="supplier_id" hierarchize="0" icon="fa-building" enable_counters="1" groups="ifs_partner.group_ifs_partner_factor_user"/>
          <field name="state" expand="1" select="multi" icon="fa-folder-open" enable_counters="1"/>
        </searchpanel>
        <separator/>
        <filter name="filter_process_state" string="待处理" domain="[('state', '=', 'auditing')]"/>
        <filter name="filter_tobesign_state" string="待签约" domain="[('state', '=', 'tobesign')]"/>
        <filter name="filter_ready_state" string="已开通" domain="[('state', '=', 'ready')]"/>
        <group expand="1" string="Group By">
          <filter name="group_by_supplier" context="{'group_by': 'supplier_id'}"/>
          <filter name="group_state" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

</odoo>