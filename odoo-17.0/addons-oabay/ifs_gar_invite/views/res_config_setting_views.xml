<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form_inherit_ifs_gar_invite" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.ifs.gar.invite</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="88"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@name='galaxy_aliyun']" position="inside">
        <setting string="邀请短信" help="是否发送邀请短信" invisible="not module_galaxy_aliyun">
          <field name="is_send_sms"/>
        </setting>
      </xpath>

      <xpath expr="//setting[@name='ifs_external_api_setting_container']" position="after">
        <setting name="invite_send_email_setting_container" string="邮件发送管理" help="是否外发邀请邮件">
          <field name="is_send_mail"/>
          <div class="mt16" invisible="is_send_mail">
            <label class="col-lg-3" string="默认的邮件接收方" for="email_default_receiver"/>
            <field name="email_default_receiver" placeholder="默认指定的邀请邮件接收方"/>
          </div>
        </setting>
      </xpath>
    </field>
  </record>
</odoo>