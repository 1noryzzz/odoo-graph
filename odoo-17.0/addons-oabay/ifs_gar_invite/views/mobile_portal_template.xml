<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="frontend_layout" name="Main Mobile Frontend Layout" inherit_id="portal.frontend_layout" primary="True">
    <xpath expr="//header" position="replace">
    </xpath>
    <xpath expr="//footer" position="replace">
    </xpath>
    <xpath expr="//div[@id='wrapwrap']/main/t[@t-out='0']" position="replace">
      <div t-if="o_portal_fullwidth_header" class="rounded-0 fade show d-print-none css_editable_mode_hidden galaxy_mobile_header">
        <div class="container">
          <t t-out="o_portal_fullwidth_header"/>
        </div>
      </div>
      <form t-if="o_form_action" t-att-action="o_form_action" method="post">
        <div class="galaxy_inner_content">
          <t t-out="0"/>
        </div>
        <div t-if="o_portal_fullwidth_footer" class="rounded-0 fade show d-print-none css_editable_mode_hidden galaxy_mobile_footer">
          <div class="container">
            <t t-out="o_portal_fullwidth_footer"/>
          </div>
        </div>
      </form>
      <t t-else="">
        <div class="galaxy_inner_content">
          <t t-out="0"/>
        </div>
        <div t-if="o_portal_fullwidth_footer" class="rounded-0 fade show d-print-none css_editable_mode_hidden galaxy_mobile_footer">
          <div class="container">
            <t t-out="o_portal_fullwidth_footer"/>
          </div>
        </div>
      </t>
    </xpath>
  </template>

  <template id="portal_layout" inherit_id="portal.portal_layout" name="Mobile Portal Layout" primary="True">
    <xpath expr="//t[@t-call='portal.frontend_layout']" position="attributes">
      <attribute name="t-call">ifs_gar_invite.frontend_layout</attribute>
    </xpath>
    <xpath expr="//div[hasclass('o_portal_wrap')]/div" position="attributes">
      <attribute name="class">mb64</attribute>
    </xpath>
  </template>
</odoo>