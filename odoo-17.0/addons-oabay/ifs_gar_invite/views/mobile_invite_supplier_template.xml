<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="ifs_gar_invite_supplier_template" name="邀请核心企业" inherit_id="portal.portal_sidebar" primary="True">
    <xpath expr="//t[@t-call='portal.portal_layout']" position="attributes">
      <attribute name="t-call">ifs_gar_invite.portal_layout</attribute>
    </xpath>
    <xpath expr="//div" position="replace">
      <t t-set="no_breadcrumbs" t-value="1"/>
      <t t-set="o_portal_fullwidth_header">
        <div>邀请核心企业</div>
      </t>
      <t t-set="o_portal_fullwidth_footer">
        <input class="btn btn-primary btn-block galaxy-btn-primary" type="submit" value="发送邀请" disabled="disabled" />
      </t>
      <t t-set="o_form_action">/ifs_gar_invite/supplier/create</t>
      <div class="main gar_invite_main">
        <div>
          <div id="group_credit_no" class="galaxy_group form-inline">
            <input name="credit_no" class="form-control col-9 galaxy-form-control" placeholder="输入企业信用代码" required="required"/>
            <div class="col-3 galaxy_group_inner">
              <input id="galaxy_btn_primary" class="btn btn-primary galaxy-btn-primary" type="button" value="确认"/>
            </div>
          </div>
          <div class="galaxy_group form-inline">
            <div id="reg_info" class="galaxy_group_title">
              <img src="/ifs_gar_invite/static/src/img/company_check.png" />核对企业
            </div>
            <div class="form-inline galaxy_group_line v-align align-items-start">
              <div class="galaxy_desc_title col-5">企业信用代码</div>
              <div id="ck_credit_no" class="galaxy_desc_content col-7"></div>
            </div>
            <div class="form-inline galaxy_group_line v-align align-items-start">
              <div class="galaxy_desc_title col-5">执照名称</div>
              <div id="ck_company_name" class="galaxy_desc_content col-7"></div>
            </div>
            <div class="form-inline galaxy_group_line v-align align-items-start">
              <div class="galaxy_desc_title col-5">法定代表</div>
              <div id="ck_legal_person" class="galaxy_desc_content col-7"></div>
            </div>
            <div class="form-inline galaxy_group_line v-align align-items-start">
              <div class="galaxy_desc_title col-5">注册资本</div>
              <div id="ck_capital" class="galaxy_desc_content col-7"></div>
            </div>
            <div class="form-inline galaxy_group_line v-align align-items-start">
              <div class="galaxy_desc_title col-5">注册时间</div>
              <div id="ck_establish_date" class="galaxy_desc_content col-7"></div>
            </div>
            <div class="form-inline galaxy_group_line v-align align-items-start">
              <div class="galaxy_desc_title col-5">注册地址</div>
              <div id="ck_address" class="galaxy_desc_content col-7"></div>
            </div>
          </div>
          <div class="galaxy_group form-inline">
            <div class="galaxy_group_title">
              <img src="/ifs_gar_invite/static/src/img/invite_input.png" />输入邀请要素
            </div>
            <div class="form-inline galaxy_group_line">
              <div class="galaxy_label col-4">邮箱地址</div>
              <input name="email" class="form-control col-8 galaxy-form-control" placeholder="" required="required"/>
            </div>
            <div class="form-inline galaxy_group_line">
              <!-- <div class="galaxy_label col-8"> -->
                <div class="galaxy_label col-4">收费方式</div>
                <select class="form-control col-8 galaxy-form-control" name="supplier_fee">
                  <option value="月服务费+交易服务费">月服务费+交易服务费</option>
                  <option value="阶梯收费">阶梯收费</option>
                </select>
              <!-- </div> -->
              <!-- <input name="supplier_fee" class="form-control col-8 galaxy-form-control" placeholder="" required="required"/> -->
            </div>
            <div class="form-inline galaxy_group_line">
              <div class="galaxy_label col-4">企业联系人</div>
              <input name="contact" class="form-control col-8 galaxy-form-control" placeholder="" required="required"/>
            </div>
            <div class="form-inline galaxy_group_line">
              <div class="galaxy_label col-4">联系电话</div>
              <input name="phone" class="form-control col-8 galaxy-form-control" placeholder="" required="required"/>
            </div>
          </div>
        </div>
      </div>
    </xpath>
  </template>

  <template id="ifs_gar_invite_supplier_succ_template" name="邀请成功" inherit_id="portal.portal_sidebar" primary="True">
    <xpath expr="//t[@t-call='portal.portal_layout']" position="attributes">
      <attribute name="t-call">ifs_gar_invite.portal_layout</attribute>
    </xpath>
    <xpath expr="//div" position="replace">
      <t t-set="no_breadcrumbs" t-value="1"/>
      <!-- <t t-set="o_form_action">/ifs_gar_invite/supplier/create</t> -->
      <div class="main gar_invite_main">
        <div class="galaxy_message_center">
          <img src="/ifs_gar_invite/static/src/img/success_icon.png" />
          <div class="galaxy_desc_content mt-4">您已成功邀请</div>
          <div class="galaxy_content"><t t-esc="company_name"/></div>
          <div class="galaxy_desc_content">邀请信已发送到</div>
          <div class="galaxy_desc_content">您设定的核心企业供应商的电子信箱</div>
          <div class="galaxy_desc_content">请通知核心企业按照邮箱指引进行注册</div>
          <div class="galaxy_buttons">
            <form action="/ifs_gar_invite/supplier/create" method="get">
              <input class="btn btn-primary btn-block galaxy-btn-primary" type="submit" value="确定" />
            </form>
          </div>
        </div>
      </div>
    </xpath>
  </template>
</odoo>