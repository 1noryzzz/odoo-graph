<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="multi_company_res_company_factor_user" model="ir.rule">
      <field name="name">保理方用户可以跨公司操作res.company</field>
      <field name="model_id" ref="base.model_res_company"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="groups" eval="[Command.set([ref('ifs_partner.group_ifs_partner_factor_user')])]" />
    </record>

    <record id="multi_company_ifs_partner_factor_supplier_by_invite" model="ir.rule">
      <field name="name">进件的供应方能看到邀请自己的保理方</field>
      <field name="model_id" ref="ifs_partner.model_ifs_partner_factor"/>
      <field name="domain_force">[('invite_supplier_ids.company_id','in',company_ids)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_gar_invite.group_ifs_gar_supplier_entry'))]" />
    </record>
    
    <record id="multi_company_ifs_partner_factor_franchisee_by_invite" model="ir.rule">
      <field name="name">进件的合伙人能看到邀请自己的保理方</field>
      <field name="model_id" ref="ifs_partner.model_ifs_partner_factor"/>
      <field name="domain_force">[('invite_franchisee_ids.company_id','in',company_ids)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_gar_invite.group_ifs_gar_franchisee_entry'))]" />
    </record>

    <record id="multi_company_ifs_partner_factor_lawfirm_by_invite" model="ir.rule">
      <field name="name">进件的律师事务所能看到邀请自己的保理方</field>
      <field name="model_id" ref="ifs_partner.model_ifs_partner_factor"/>
      <field name="domain_force">[('invite_lawfirm_ids.company_id','in',company_ids)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_gar_invite.group_ifs_gar_lawfirm_entry'))]" />
    </record>

    <record id="multi_company_ifs_partner_supplier_merchant_by_invite" model="ir.rule">
      <field name="name">进件的采购方能看到邀请自己的供应方</field>
      <field name="model_id" ref="ifs_partner.model_ifs_partner_supplier"/>
      <field name="domain_force">[('invite_merchant_ids.company_id','in',company_ids)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_gar_invite.group_ifs_gar_merchant_entry'))]" />
    </record>

    <record id="multi_company_ifs_gar_invite_supplier_from_factor" model="ir.rule">
      <field name="name">邀请供应方的信息只有相关方才能看到</field>
      <field name="model_id" ref="ifs_gar_invite.model_ifs_gar_invite_supplier"/>
      <field name="domain_force">['|', '|', 
        ('factor_id.company_id','in',company_ids), ('franchisee_id.company_id','in',company_ids), ('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[
        Command.link(ref('ifs_gar_invite.group_ifs_gar_invite_supplier_factor')),
        Command.link(ref('ifs_gar_invite.group_ifs_gar_invite_supplier_franchisee')),
        Command.link(ref('ifs_gar_invite.group_ifs_gar_supplier_entry'))]" />
    </record>
    <record id="multi_company_ifs_gar_invite_supplier_from_factor_user" model="ir.rule">
      <field name="name">保理方用户只能查看和自己有关的受邀供应方信息</field>
      <field name="model_id" ref="ifs_gar_invite.model_ifs_gar_invite_supplier"/>
      <field name="domain_force">['&amp;', '|', '|', ('factor_id.company_id','in',company_ids), ('franchisee_id.company_id','in',company_ids), ('company_id', 'in', company_ids), ('create_uid', '=', user.id)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_partner.group_ifs_partner_factor_user'))]" />
    </record>

    <record id="multi_company_ifs_gar_invite_franchisee_from_factor" model="ir.rule">
      <field name="name">邀请合伙人的信息只有相关方才能看到</field>
      <field name="model_id" ref="ifs_gar_invite.model_ifs_gar_invite_franchisee"/>
      <field name="domain_force">['|', ('factor_id.company_id','in',company_ids), ('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[
        Command.link(ref('ifs_gar_invite.group_ifs_gar_invite_franchisee')),
        Command.link(ref('ifs_gar_invite.group_ifs_gar_franchisee_entry'))]" />
    </record>

    <record id="multi_company_ifs_gar_invite_lawfirm_from_factor" model="ir.rule">
      <field name="name">邀请律师事务所的信息只有相关方才能看到</field>
      <field name="model_id" ref="ifs_gar_invite.model_ifs_gar_invite_lawfirm"/>
      <field name="domain_force">['|', ('factor_id.company_id','in',company_ids), ('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[
        Command.link(ref('ifs_gar_invite.group_ifs_gar_invite_lawfirm')),
        Command.link(ref('ifs_gar_invite.group_ifs_gar_lawfirm_entry'))]" />
    </record>

    <record id="multi_company_ifs_gar_invite_merchant_from_supplier" model="ir.rule">
      <field name="name">邀请采购方的信息只有相关方才能看到</field>
      <field name="model_id" ref="ifs_gar_invite.model_ifs_gar_invite_merchant"/>
      <field name="domain_force">['|', '|', 
        ('factor_id.company_id','in',company_ids), ('supplier_id.company_id','in',company_ids), ('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[
        Command.link(ref('ifs_gar_invite.group_ifs_gar_invite_merchant')),
        Command.link(ref('ifs_partner.group_ifs_partner_factor_user')),
        Command.link(ref('ifs_gar_invite.group_ifs_gar_merchant_entry'))]"/>
    </record>
  </data>
</odoo>