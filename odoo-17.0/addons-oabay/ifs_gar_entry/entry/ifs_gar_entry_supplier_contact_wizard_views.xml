<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_gar_entry_supplier_contact_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.entry.supplier.contact.wizard.view.form</field>
    <field name="model">ifs.gar.entry.supplier.contact.wizard</field>
    <field name="inherit_id" ref="ifs_gar_entry_supplier_wizard_view_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <xpath expr="//form" position="attributes">
        <attribute name="class">o_galaxy_form_view</attribute>
      </xpath>
      <xpath expr="//group[hasclass('o_ifs_gar_step_controller')]" position="before">
        <div class="o_ifs_center_img" invisible="contact_front_image">
          <field name="contact_front_image" widget="image" options="{'placeholder':'/galaxy_tdesign/static/src/img/idcard_front_image.png'}"/>
        </div>
        <div class="o_ifs_center_img" invisible="not contact_front_image or contact_back_image">
          <field name="contact_back_image" widget="image" options="{'placeholder':'/galaxy_tdesign/static/src/img/idcard_back_image.png'}"/>
        </div>

        <group invisible="not contact_front_image or not contact_back_image">
          <group>
            <field name="contact_name" readonly="1" force_save="1"/>
            <field name="contact_id_number" readonly="1" force_save="1"/>
            <field name="contact_birthday" readonly="1" force_save="1"/>
            <field name="contact_start_date" readonly="1" force_save="1"/>
          </group>
          <group>
            <field name="contact_nationality" readonly="1" force_save="1"/>
            <field name="contact_gender" readonly="1" force_save="1"/>
            <field name="contact_authority" readonly="1" force_save="1"/>
            <field name="contact_end_date" readonly="1" force_save="1"/>
          </group>
          <group colspan="2">
            <field name="contact_address" readonly="1" force_save="1"/>
          </group>
          <group>
            <field name="contact_front_image" widget="image"/>
          </group>
          <group>
            <field name="contact_back_image" widget="image"/>
          </group>
        </group>

        <group string="财务联系人" invisible="not contact_front_image or not contact_back_image">
          <group>
            <field name="contact_finance_name" />
          </group>
          <group>
            <field name="contact_finance_phone" />
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>