<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_gar_entry_franchisee_doc_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.entry.franchisee.doc.wizard.view.form</field>
    <field name="model">ifs.gar.entry.franchisee.doc.wizard</field>
    <field name="inherit_id" ref="ifs_gar_entry_franchisee_wizard_view_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <xpath expr="//form" position="attributes">
        <attribute name="class">o_galaxy_form_view</attribute>
      </xpath>
      <xpath expr="//group[hasclass('o_ifs_gar_step_controller')]" position="before">
        <div class="o_ifs_center_img">
          <div class="o_ifs_img">
            <field name="reception_picture" widget='image' options="{'placeholder':'/galaxy_tdesign/static/src/img/plus.png', 'description': '前台照'}" nolabel="1"/>
            <div class="o_ifs_img_text">前台照</div>
          </div>
          <div class="o_ifs_img">
            <field name="office_area_picture" widget='image' options="{'placeholder':'/galaxy_tdesign/static/src/img/plus.png', 'description': '公司办公区照片'}" nolabel="1"/>
            <div class="o_ifs_img_text">公司办公区照片</div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>