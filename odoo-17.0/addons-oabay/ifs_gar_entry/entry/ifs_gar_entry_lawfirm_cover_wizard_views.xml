<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_entry_lawfirm_cover_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.entry.lawfirm.cover.wizard.view.form</field>
    <field name="model">ifs.gar.entry.lawfirm.cover.wizard</field>
    <field name="arch" type="xml">
      <form class="o_base_settings" js_class="ifs_gar_entry_form">
        <field name="current_step" invisible="1"/>
        <field name="has_prev_step" invisible="1"/>
        <field name="has_next_step" invisible="1"/>
        <field name="entry_id" invisible="1" force_save="1"/>
        <sheet>
          <div class="entry_column_item_inform_a">
            <img src="/ifs_gar_entry/static/img/attention.png" alt="告知"/>告知</div>
          <hr/>
          <div style="margin-top:20px;">
            尊敬的客户：<br/>
            为更好的维护您的合法权益，特向您告知如下事项：<br/>
            <span class="entry_column_item_inform">声明：本告知书项下所有内容，请仔细审阅并认可；</span>
          </div>
          <hr style="border: 1px dashed"/>
          <div style="margin-top:20px;">
            <span class="entry_column_item_inform">特别关注</span>
            <br/>
            接下来进件你需要准备以下材料：<br/>
            <div class="material_list_box">
              <div>
                <img src="/ifs_gar_entry/static/img/business_license.png" alt="营业执照"/>
                <span>营业执照</span>
              </div>
              <div>
                <img src="/ifs_gar_entry/static/img/idcard.png" alt="身份证"/>
                <span>身份证</span>
              </div>
            </div>
          </div>
          <div class="word_doc_inner_title" style="margin-top:45px;">
            <img src="/ifs_gar_entry/static/img/tips.png" alt="tips"/>
            <span class="entry_column_item_inform">“鸥贝云”品牌的归属权为鸥贝云信用科技（深圳）有限公司</span>
          </div>
          <group class="gp_next" col="3" style="margin-top:50px;">
            <group></group>
            <group>
              <button name="action_next" type="object" class="btn btn-primary btn-next">知晓并下一步</button>
            </group>
            <group></group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>