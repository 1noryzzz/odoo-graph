<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_gar_entry_merchant_contact_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.entry.merchant.contact.wizard.view.form</field>
    <field name="model">ifs.gar.entry.merchant.contact.wizard</field>
    <field name="inherit_id" ref="ifs_gar_entry_merchant_wizard_view_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <xpath expr="//form" position="attributes">
        <attribute name="class">o_galaxy_form_view</attribute>
      </xpath>
      <xpath expr="//group[hasclass('o_ifs_gar_step_controller')]" position="before">
        <field name="currency_id" invisible="1"/>
        <field name="legal_info_config_detail_id" invisible="1"/>
        <field name="other_info_config_detail_id" invisible="1"/>
        <field name="legal_info_definition_id" invisible="1"/>
        <field name="other_info_definition_id" invisible="1"/>
        <field name="legal_info_is_required" invisible="1"/>
        <field name="legal_info_visible" invisible="1"/>
        <field name="other_info_is_required" invisible="1"/>
        <field name="other_info_visible" invisible="1"/>
        <div class="o_ifs_center_img" invisible="legal_front_image">
          <field name="legal_front_image" widget="image" options="{'placeholder':'/galaxy_tdesign/static/src/img/idcard_front_image.png'}"/>
        </div>
        <div class="o_ifs_center_img" invisible="not legal_front_image or legal_back_image">
          <field name="legal_back_image" widget="image" options="{'placeholder':'/galaxy_tdesign/static/src/img/idcard_back_image.png'}"/>
        </div>

        <group string="法人基本信息" invisible="not legal_front_image or not legal_back_image">
          <group>
            <field name="legal_name" readonly="1" force_save="1"/>
            <field name="legal_id_number" readonly="1" force_save="1"/>
            <field name="legal_birthday" readonly="1" force_save="1"/>
            <field name="legal_start_date" readonly="1" force_save="1"/>
          </group>
          <group>
            <field name="legal_nationality" readonly="1" force_save="1"/>
            <field name="legal_gender" readonly="1" force_save="1"/>
            <field name="legal_authority" readonly="1" force_save="1"/>
            <field name="legal_end_date" readonly="1" force_save="1"/>
          </group>
          <group colspan="2">
            <field name="legal_address" readonly="1" force_save="1"/>
          </group>
          <field name="legal_info" widget="dynamic_properties" nolabel="1" columns="2"/>
          <group>
            <field name="legal_front_image" widget="image" />
          </group>
          <group>
            <field name="legal_back_image" widget="image" />
          </group>
        </group>

        <group string="法人财产相关" col="4" invisible="not legal_front_image or not legal_back_image">
          <group>
            <field name="is_has_legal_housing_assets" widget="radio" options="{'horizontal': true}"/>
          </group>
          <group colspan="3">
            <field name="legal_housing_assets" required="is_has_legal_housing_assets" invisible="not is_has_legal_housing_assets"/>
          </group>

          <group>
            <field name="is_has_legal_vehicle_assets" widget="radio" options="{'horizontal': true}"/>
          </group>
          <group colspan="3">
            <field name="legal_vehicle_assets"  required="is_has_legal_vehicle_assets" invisible="not is_has_legal_vehicle_assets"/>
          </group>

          <group>
            <field name="is_has_legal_other_assets" widget="radio" options="{'horizontal': true}"/>
          </group>
          <group>
            <field name="legal_other_assets"  required="is_has_legal_other_assets" invisible="not is_has_legal_other_assets"/>
          </group>
          <group colspan="2">
            <field name="legal_other_assets_remarks"  required="is_has_legal_other_assets" invisible="not is_has_legal_other_assets"/>
          </group>

          <group>
            <field name="is_has_legal_loan" widget="radio" options="{'horizontal': true}"/>
          </group>
          <group>
            <field name="legal_loan_amount"  required="is_has_legal_loan" invisible="not is_has_legal_loan"/>
          </group>
          <group colspan="2">
            <field name="legal_loan_remarks"  required="is_has_legal_loan" invisible="not is_has_legal_loan"/>
          </group>

          <group>
            <field name="is_has_legal_guarantee" widget="radio" options="{'horizontal': true}"/>
          </group>
          <group>
            <field name="legal_guarantee_amount"  required="is_has_legal_guarantee" invisible="not is_has_legal_guarantee"/>
          </group>
          <group colspan="2">
            <field name="legal_guarantee_remarks"  required="is_has_legal_guarantee" invisible="not is_has_legal_guarantee"/>
          </group>
        </group>

        <group string="其他相关" col="4" class="gp_contact" invisible="not legal_front_image or not legal_back_image">
          <group>
          </group>
          <field name="other_info" widget="dynamic_properties" nolabel="1" columns="3"/>
        </group>

        <group string="法人相关附件上传" class="gp_attachment" col="4" invisible="not legal_front_image or not legal_back_image">
          <group>
            <field name="legal_handle_image" widget='image' class="ifs_attachment" nolabel="1" colspan="2" options="{'placeholder':'/galaxy_tdesign/static/src/img/plus.png', 'description': '法人手持身份证照片'}"/>
          </group>
          <group>
            <field name="legal_person_property_certificate" widget='pdf_viewer' class="ifs_attachment" nolabel="1" colspan="2" options="{'placeholder':'/galaxy_tdesign/static/src/img/plus.png', 'description': '法人名下相关财产证明（如有请提供）','previewImage': 'legal_person_property_certificate_preview', 'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png'}"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>