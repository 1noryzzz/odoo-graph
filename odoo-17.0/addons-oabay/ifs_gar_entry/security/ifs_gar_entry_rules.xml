<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">

    <record id="multi_company_ifs_gar_entry_supplier" model="ir.rule">
      <field name="name">供应方进件信息的相关方才能看到</field>
      <field name="model_id" ref="ifs_gar_entry.model_ifs_gar_entry_supplier"/>
      <field name="domain_force">['|', '|', 
        ('factor_id.company_id','in',company_ids), ('franchisee_id.company_id','in',company_ids), ('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[
        Command.link(ref('ifs_partner.group_ifs_partner_factor_user')),
        Command.link(ref('ifs_partner.group_ifs_partner_franchisee_user')),
        Command.link(ref('ifs_partner.group_ifs_partner_supplier_user'))]" />
    </record>

    <record id="multi_company_ifs_gar_entry_franchisee" model="ir.rule">
      <field name="name">合伙人进件信息的相关方才能看到</field>
      <field name="model_id" ref="ifs_gar_entry.model_ifs_gar_entry_franchisee"/>
      <field name="domain_force">['|', ('factor_id.company_id','in',company_ids),
        ('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[
        Command.link(ref('ifs_partner.group_ifs_partner_factor_user')),
        Command.link(ref('ifs_partner.group_ifs_partner_franchisee_user'))]" />
    </record>

    <record id="multi_company_ifs_gar_entry_lawfirm" model="ir.rule">
      <field name="name">律师事务所进件信息的相关方才能看到</field>
      <field name="model_id" ref="ifs_gar_entry.model_ifs_gar_entry_lawfirm"/>
      <field name="domain_force">['|', ('factor_id.company_id','in',company_ids),
        ('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[
        Command.link(ref('ifs_partner.group_ifs_partner_factor_user')),
        Command.link(ref('ifs_partner.group_ifs_partner_lawfirm_user'))]" />
    </record>

    <record id="multi_company_ifs_gar_entry_merchant" model="ir.rule">
      <field name="name">采购方进件信息的相关方才能看到</field>
      <field name="model_id" ref="ifs_gar_entry.model_ifs_gar_entry_merchant"/>
      <field name="domain_force">['|', '|', ('factor_id.company_id','in',company_ids),
        ('supplier_id.company_id','in',company_ids),('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[
        Command.link(ref('ifs_partner.group_ifs_partner_factor_user')),
        Command.link(ref('ifs_partner.group_ifs_partner_supplier_user')), 
        Command.link(ref('ifs_partner.group_ifs_partner_merchant_user'))]" />
    </record>

    <record id="ifs_gar_partner_relationship.multi_company_ifs_partner_supplier_factor" model="ir.rule">
      <field name="name">保理方用户只能看到与自己有关联的供应方(或者这个供应方是自己)</field>
      <field name="model_id" ref="ifs_partner.model_ifs_partner_supplier"/>
      <field name="domain_force">['|', '&amp;', ('factor_ids.factor_id.ifs_company_id.company_id','in',company_ids), ('factor_ids.entry_id.invite_id.create_uid', '=', user.id), ('ifs_company_id.company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_partner.group_ifs_partner_factor_user'))]" />
    </record>
    <record id="multi_company_ifs_partner_supplier_factor_manager" model="ir.rule">
      <field name="name">保理方管理员可以看到自己所有有关联的供应方(或者这个供应方是自己)</field>
      <field name="model_id" ref="ifs_partner.model_ifs_partner_supplier"/>
      <field name="domain_force">['|', ('ifs_company_id.company_id', 'in', company_ids), ('factor_ids.factor_id.ifs_company_id.company_id','in',company_ids)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_partner.group_ifs_partner_factor_manager'))]" />
    </record>
  </data>
</odoo>