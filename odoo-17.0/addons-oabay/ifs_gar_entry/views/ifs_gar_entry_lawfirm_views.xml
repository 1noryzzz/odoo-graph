<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_entry_lawfirm_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.entry.lawfirm.view.form</field>
    <field name="model">ifs.gar.entry.lawfirm</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_base.ifs_base_company_view_form" />
    <field name="arch" type="xml">
      <form position="attributes">
        <attribute name="string">进件邀约</attribute>
        <attribute name="js_class">ifs_partner_form</attribute>
      </form>
      <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
        <button class="oe_stat_button" icon="fa-list" name="view_entrys" type="object">
          <div class="o_form_field o_stat_info">
            <span class="o_stat_text">进件记录</span>
          </div>
        </button>
      </xpath>
      <field name="company_id" position="after">
        <field name="ifs_company_id" invisible="1"/>
      </field>
      <span name="ifs_base_company_code" position="replace">
        <span invisible="not seq_code" name="ifs_base_company_code">进件律师事务所编号：          <field name="seq_code" class="oe_inline" />
        </span>
      </span>
      <field name="name" position="attributes">
        <attribute name="placeholder">律师事务所名称</attribute>
      </field>

      <field name="deposit_bank" position="replace">
        <field name="bank_id" options="{'no_open': True}"/>
      </field>
      <field name="account_no" position="replace">
        <field name="acc_number"/>
      </field>

      <xpath expr="//group[hasclass('gp_legal')]" position="replace">
        <group class="gp_legal" string="法人信息" invisible="legal_front_image and legal_back_image">
          <group>
            <field name="legal_id" readonly="1"/>
            <field name="legal_phone"/>
          </group>
          <group>
            <field name="legal_email"/>
          </group>
        </group>
        <group string="法人信息" invisible="not legal_front_image or not legal_back_image">
          <group>
            <field name="legal_name" readonly="1" />
            <field name="legal_email"/>
            <field name="legal_id_number" readonly="1" />
            <field name="legal_birthday" readonly="1" />
            <field name="legal_start_date" readonly="1" />
          </group>
          <group>
            <field name="legal_phone"/>
            <field name="legal_nationality" readonly="1" />
            <field name="legal_gender" readonly="1" />
            <field name="legal_authority" readonly="1" />
            <field name="legal_end_date" readonly="1" />
          </group>
          <group colspan="2">
            <field name="legal_address" readonly="1" />
          </group>
          <group>
            <field name="legal_front_image" widget="image"/>
          </group>
          <group>
            <field name="legal_back_image" widget="image"/>
          </group>
        </group>
      </xpath>

      <xpath expr="//page[hasclass('pg_contact')]" position="after">
        <page string="其他附件" class="pg_doc">
          <div class="o_ifs_center_img">
            <div class="o_ifs_img">
              <field name="reception_picture" widget='image' options="{'placeholder':'/web/static/img/placeholder.png', 'description': '前台照'}" nolabel="1"/>
              <div class="o_ifs_img_text">前台照</div>
            </div>
            <div class="o_ifs_img">
              <field name="office_area_picture" widget='image' options="{'placeholder':'/web/static/img/placeholder.png', 'description': '公司办公区照片'}" nolabel="1"/>
              <div class="o_ifs_img_text">公司办公区照片</div>
            </div>
          </div>
        </page>
      </xpath>
    </field>
  </record>

  <record id="ifs_gar_entry_lawfirm_view_tree" model="ir.ui.view">
    <field name="name">ifs.gar.entry.lawfirm.view.tree</field>
    <field name="model">ifs.gar.entry.lawfirm</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_base.ifs_base_company_view_tree" />
    <field name="arch" type="xml">
      <tree position="attributes">
        <attribute name="string">律师事务所进件列表</attribute>
      </tree>
      <field name="company_code" position="before">
        <field name="seq_code" string="进件编号"/>
      </field>
      <field name="email" position="after">
        <field name="state" string="状态" widget="badge" decoration-danger="state == 'rejected'" decoration-info="state == 'committed'" decoration-success="state == 'approval'"/>
      </field>
    </field>
  </record>

  <record id="ifs_gar_entry_lawfirm_view_search" model="ir.ui.view">
    <field name="name">ifs.gar.entry.lawfirm.view.search</field>
    <field name="model">ifs.gar.entry.lawfirm</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_base.ifs_base_company_view_search" />
    <field name="arch" type="xml">
      <search position="attributes">
        <attribute name="string">律师事务所进件查询</attribute>
      </search>
      <search position="inside">
        <field name="seq_code" string="进件编号"/>
      </search>
    </field>
  </record>
</odoo>