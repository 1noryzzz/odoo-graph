<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_entry_merchant_config_view_search" model="ir.ui.view">
    <field name="name">ifs.gar.entry.merchant.config.view.search</field>
    <field name="model">ifs.gar.entry.merchant.config</field>
    <field name="arch" type="xml">
      <search string="">
        <field name="factor_id"/>
        <field name="supplier_id"/>
      </search>
    </field>
  </record>
  <record id="ifs_gar_entry_merchant_config_view_tree" model="ir.ui.view">
    <field name="name">ifs.gar.entry.merchant.config.view.tree</field>
    <field name="model">ifs.gar.entry.merchant.config</field>
    <field name="arch" type="xml">
      <tree string="">
        <field name="factor_id"/>
        <field name="supplier_id"/>
        <field name="is_global"/>
      </tree>
    </field>
  </record>
  <record id="ifs_gar_entry_merchant_config_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.entry.merchant.config.view.form</field>
    <field name="model">ifs.gar.entry.merchant.config</field>
    <field name="arch" type="xml">
      <form string="采购方进件参数配置" class="o_galaxy_form_view">
        <field name="factor_id" invisible="1" force_save="1"/>
        <header>
          <button name="config_selector_supplier" type="object" string="以此为模板创建" 
            class="btn-primary" groups="ifs_partner.group_ifs_partner_factor_system" invisible="not id"/>
        </header>
        <sheet>
          <field name="id" invisible="1"/>
          <group>
            <group>
              <field name="supplier_id" options="{'no_create': True, 'no_open': True}"/>
            </group>
            <group>
              <field name="is_global"/>
            </group>
          </group>
          <notebook>
            <page name="details" string="进件流程参数设置明细">
              <field name="detail_ids" widget="one2many_list" context="{'default_factor_id': factor_id}" mode="tree">
                <tree>
                  <field name="sequence" widget="handle"/>
                  <field name="code"/>
                  <field name="name"/>
                  <field name="type"/>
                  <field name="is_required"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="ifs_gar_entry_merchant_config_detail_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.entry.merchant.config.detail.view.form</field>
    <field name="model">ifs.gar.entry.merchant.config.detail</field>
    <field name="arch" type="xml">
      <form string="采购方流程参数配置详情" class="o_galaxy_form_view">
        <field name="has_definition" invisible="1"/>
        <sheet>
          <group class="o_group_label_lg" string="基本参数">
            <group>
              <field name="code"/>
              <field name="name"/>
              <field name="is_visible"/>
            </group>
            <group>
              <field name="type"/>
              <field name="is_required"/>
            </group>
            <group colspan="2">
              <field name="remark"/>
            </group>
          </group>
          <group class="o_group_label_lg" string="动态表格">
            <group colspan="2">
              <field name="definition_id" options="{'no_open': True}"  invisible="not has_definition"/>
            </group>
            <field name="sample" widget="dynamic_properties" showAddButton="1"
              nolabel="1" columns="2" hideKanbanOption="1" showRequiredOption="1" invisible="not definition_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>