<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.ifs.gar.entry</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="120"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//setting[@name='ifs_external_api_setting_container']" position="after">
        <setting name="ifs_gar_entry_setting_container" string="进件流程">
          <div class="text-muted">
            <field name="verification_legalperson_name"/>
              验证法人姓名
          </div>
        </setting>
        <setting name="ifs_gar_entry_hezongyy_container" string="药易购参数配置">
          <div class="mt8">
            <label class="col-lg-3" string="secretKey" for="hezongyy_secret_key"/>
            <field name="hezongyy_secret_key"/>
          </div>
        </setting>
      </xpath>
    </field>
  </record>
</odoo> 
