<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_message_view_search" model="ir.ui.view">
      <field name="name">ifs.message.view.search</field>
      <field name="model">ifs.message</field>
      <field name="arch" type="xml">
        <search string="消息推送查询">
          <field name="open_app_id" string="应用"/>
          <searchpanel>
            <field name="message_type" icon="fa-folder-open" enable_counters="1"/>
          </searchpanel>
          <group expand="1" string="是否成功">
            <filter name="success" context="{'group_by': 'success'}"/>
          </group>
        </search>
      </field>
    </record>

  <record id="ifs_message_view_tree" model="ir.ui.view">
    <field name="name">ifs.message.view.tree</field>
    <field name="model">ifs.message</field>
    <field name="arch" type="xml">
      <tree string="消息推送列表" sample="1" default_order="create_date DESC">
        <field name="open_app_id" string="应用"/>
        <field name="message_type" />
        <field name="success"/>
        <field name="push_count"/>
        <field name="message_body" widget="json" optional="hide"/>
        <field name="response_data" widget="json" optional="hide"/>
        <field name="create_date" string="创建时间"/>
        <field name="write_date" string="更新时间"/>
      </tree>
    </field>
  </record>

  <record id="ifs_message_view_form" model="ir.ui.view">
    <field name="name">ifs.message.view.form</field>
    <field name="model">ifs.message</field>
    <field name="arch" type="xml">
      <form class="o_galaxy_form_view" create="0" edit="0">
        <header>
          <button name="push" type="object" string="发送" class="btn_primary"/>
        </header>
        <sheet>
          <group string="基本信息">
            <group >
              <field name="open_app_id" string="应用"/>
              <field name="success" />
            </group>
            <group >
              <field name="message_type"/>
              <field name="push_count" />
            </group>
          </group>

          <group string="发送记录" col="1">
            <group colspan="1">
              <field name="push_record_ids">
                <tree create="0" delete="0" edit="0" default_order="create_date DESC">
                  <field name="response_status_code"/>
                  <field name="create_date" string="发送时间"/>
                  <field name="response_text"/>
                  <field name="error_msg"/>
                </tree>
              </field>
            </group>
          </group>

          <group string="发送信息">
            <group colspan="2">
              <field name="message_body" widget="json"/>
            </group>
            <group colspan="2">
              <field name="response_data" widget="json"/>
            </group>
          </group>

        </sheet>
      </form>
    </field>
  </record>


  <record id="ifs_message_act_window" model="ir.actions.act_window">
    <field name="name">消息推送</field>
    <field name="res_model">ifs.message</field>
    <field name="view_mode">tree,kanban,form</field>
    <field name="view_id" ref="ifs_message_view_tree" />
  </record>

  <menuitem id="ifs_message_meun" name="消息推送" action="ifs_message_act_window" groups="ifs_base.group_ifs_user" parent="galaxy_open_api.galaxy_open_api_root_menu" sequence="2"/>

</odoo>