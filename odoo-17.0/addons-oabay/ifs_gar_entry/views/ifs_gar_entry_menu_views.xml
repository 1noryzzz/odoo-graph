  <menuitem id="ifs_gar_entry_menu" name="进件操作" sequence="1" 
    groups="ifs_gar_invite.group_ifs_gar_merchant_entry,ifs_gar_invite.group_ifs_gar_supplier_entry,ifs_gar_invite.group_ifs_gar_franchisee_entry,ifs_gar_invite.group_ifs_gar_lawfirm_entry" 
    web_icon="ifs_gar_entry,static/img/ifs_partner.png" />

  <menuitem id="ifs_gar_merchant_entry_menu" name="采购方进件" 
    action="ifs_gar_invite_merchant_entry_act" groups="ifs_gar_invite.group_ifs_gar_merchant_entry" 
    parent="ifs_gar_entry_menu" sequence="1"/>

  <menuitem id="ifs_gar_supplier_entry_menu" name="供应方进件" 
    action="ifs_gar_invite_supplier_entry_act" groups="ifs_gar_invite.group_ifs_gar_supplier_entry" 
    parent="ifs_gar_entry_menu" sequence="1"/>

  <menuitem id="ifs_gar_franchisee_entry_menu" name="事业合伙人进件" 
    action="ifs_gar_invite_franchisee_entry_act" groups="ifs_gar_invite.group_ifs_gar_franchisee_entry" 
    parent="ifs_gar_entry_menu" sequence="1"/>

  <menuitem id="ifs_gar_lawfirm_entry_menu" name="律师事务所进件" 
    action="ifs_gar_invite_lawfirm_entry_act" groups="ifs_gar_invite.group_ifs_gar_lawfirm_entry" 
