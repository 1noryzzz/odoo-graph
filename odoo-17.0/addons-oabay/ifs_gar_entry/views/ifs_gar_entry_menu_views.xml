  <menuitem id="ifs_gar_entry_entry_config_menu" name="进件配置" 
    parent="ifs_partner.ifs_partner_config_menu" sequence="1"/>

  <menuitem id="ifs_gar_entry_merchant_config_menu" name="采购方配置" 
