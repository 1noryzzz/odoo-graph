<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_entry_merchant_config_act" model="ir.actions.act_window">
    <field name="name">采购方进件配置</field>
    <field name="res_model">ifs.gar.entry.merchant.config</field>
    <field name="view_mode">tree,kanban,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
          点击左上角的“创建”邀请，让我们开始吧！
      </p>
      <p>
        <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
