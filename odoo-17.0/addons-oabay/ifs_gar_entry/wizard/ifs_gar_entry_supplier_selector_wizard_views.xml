<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_entry_supplier_selector_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.entry.supplier.selector.wizard.view.form</field>
    <field name="model">ifs.gar.entry.supplier.selector.wizard</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group col="1">
            <group>
              <field name="supplier_id" />
            </group>
          </group>
        </sheet>
        <footer>
          <button name="choice_supplier" type="object" string="确认" class="btn-primary" data-hotkey="c"/>
          <button string="取消" class="btn-default" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>