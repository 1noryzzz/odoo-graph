<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="Flat.SearchBar" t-inherit="web.SearchBar" t-inherit-mode="primary" owl="1">
    <xpath expr="//div[hasclass('o_searchview')]" position="replace">
      <div class="o_searchview align-self-center flex-grow-1 o_flat_searchview" role="search" aria-autocomplete="list">
        <div class="o_searchview_input_container o_flat_searchview_items">
          <t t-call="web.expand.SearchBar.Items"/>
          <div>
            <button type="button" class="btn btn-primary" t-on-click="onClickSearch">搜索</button>
          </div>
        </div>
      </div>
    </xpath>
  </t>

  <t t-name="web.expand.SearchBar.Items" owl="1">
    <div role="menu" class="o_flat_searchview_menu">
      <t t-foreach="items" t-as="item" t-key="item.id">
        <div class="o_flat_searchview_item">
          <t t-set="date" t-value="item.value ? item.value : False"/>
          <b t-esc="item.searchItemDescription"/>: 
          <t t-if="item.type === 'selection'">
            <select t-on-change="(ev) => this.onChangeChild(item.searchItemId, ev)" class="o_flat_searchview_select">
              <option value=""></option>
              <option t-foreach="item.childs" t-as="child" t-key="child.id" t-att-value="child.value" t-att-selected="child.label === item.label ? 'selected' : ''">
                <t t-esc="child.label"/>
              </option>
            </select>
          </t>
          <t t-elif="item.type === 'date'">
            <div class="o_flat_searchview_date">
              <DatePicker onDateTimeChanged="date => this.onDateTimeChanged(item.searchItemId, item.type, date)" date="date"/>
            </div>
          </t>
          <t t-elif="item.type === 'datetime'">
            <div class="o_flat_searchview_date">
              <DateTimePicker onDateTimeChanged="date => this.onDateTimeChanged(item.searchItemId, item.type, date)" date="date"/>
            </div>
          </t>
          <t t-else="">
            <input t-att-id="item.searchItemId" type="text" role="searchbox" t-on-input="onNewSearchInput" t-on-keydown="onNewSearchKeydown" t-att-value="item.label"/>
            <div t-if="item.childs and item.childs.length > 0 and item.type == 'many2one'" class="item_childs_expand">
              <t t-foreach="item.childs" t-as="child" t-key="child.id">
                <div t-esc="child.label" t-on-click="() => this.onClickChild(item.searchItemId, child.label)"/>
              </t>
            </div>
          </t>
        </div>
      </t>
    </div>
  </t>

</templates>
