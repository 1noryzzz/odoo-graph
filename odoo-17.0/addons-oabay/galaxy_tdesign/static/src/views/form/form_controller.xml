<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-create-button'][2]" position="replace">
            <t t-set-slot="control-panel-create-button">
                <t t-if="canCreate and !displaySaveButtons">
                    <button type="button" class="btn btn-outline-primary o_form_button_create" data-hotkey="c" t-on-click.stop="create">New</button>
                </t>
                <t t-if="canEdit">
                    <div t-att-class="'d-none' + ((model.root.isNew or displaySaveButtons) ? ' d-xl-inline-flex': '')">
                        <button
                            type="button"
                            class="o_form_button_save btn btn-primary o_form_button_create"
                            data-hotkey="s"
                            t-on-click.stop="saveButtonClicked"
                            data-tooltip="Save manually"
                            aria-label="Save manually"
                            t-ref="save">
                            <i class="fa fa-cloud-upload fa-fw" />保存
                        </button>
                        <button
                            type="button"
                            class="o_form_button_cancel btn btn-light o_form_button_create"
                            data-hotkey="j"
                            t-on-click.stop="discard"
                            data-tooltip="Discard changes"
                            aria-label="Discard changes">
                            <i class="fa fa-undo fa-fw" />丢弃
                        </button>
                    </div>
                </t>
            </t>
        </xpath>
    </t>
</templates>