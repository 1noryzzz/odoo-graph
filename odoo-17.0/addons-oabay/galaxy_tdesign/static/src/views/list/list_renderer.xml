<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-inherit="web.ListRenderer" t-inherit-mode="extension" owl="1">
    <xpath expr="//thead/tr/th[1]" position="before">
      <th class="o_list_row_count align-middle pe-1">#</th>
    </xpath>
    <xpath expr="//tfoot/tr/td[1]" position="before">
      <td></td>
    </xpath>
  </t>

  <t t-inherit="web.ListRenderer.Rows" t-inherit-mode="extension" owl="1">
    <xpath expr="//t[@t-if='!list.isGrouped']/tr/td[1]" position="before">
      <td></td>
    </xpath>
    <xpath expr="//tr[@t-as='emptyRowId']/td[1]" position="attributes">
      <attribute name="t-att-colspan">nbCols + 1</attribute>
    </xpath>
    <xpath expr="//t[@t-if='!group.isFolded']/tr/td[1]" position="before">
      <td></td>
    </xpath>
  </t>

  <t t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="extension" owl="1">
    <xpath expr="//tr/td[1]" position="before">
      <td class="o_list_row_count align-middle pe-1">
        <t t-esc="getColumnIndex(record)"/>
      </td>
    </xpath>
  </t>
</templates>