<templates id="template" xml:space="preserve">

    <!-- Template for the widget SignatureForm. -->
    <t t-name="galaxy_tdesign.galaxy_signature">
        <div t-ref="root">
            <div t-if="state.success" class="alert alert-success" role="status">
                <span t-if="state.success.message" t-esc="state.success.message"/>
                <span t-else="">Thank You!</span>
                <a t-if="state.success.redirect_url" t-att-href="state.success.redirect_url">
                    <t t-if="state.success.redirect_message" t-esc="state.success.redirect_message"/>
                    <t t-else="">Click here to see your document.</t>
                </a>
            </div>
            <t t-else="">
                <GalaxyMobileSignature t-props="nameAndSignatureProps"/>
                <form method="POST">
                    <input type="hidden" name="csrf_token" t-att-value="csrfToken"/>
                    <div class="o_web_sign_name_and_signature"/>
                    <div class="o_galaxy_sign_controls galaxy_btn">
                        <div class="text-left my-3">
                            <button class="o_galaxy_sign_clear btn btn-link" t-on-click.prevent="_onClearSign">清除</button>
                        </div>
                        <div class="text-right my-3 ml-5 galaxy_button_submit">
                            <button type="submit" class="o_galaxy_sign_submit btn btn-primary aaa" t-on-click.prevent="_onClickSignSubmit">
                                <i class="fa fa-check" hidden="hidden" />
                                <img id="galaxySignBtnIcon" class="o_animate icon" src="/galaxy_tdesign/static/src/img/check.png"/>
                                <t t-esc="sendLabel"/>
                            </button>
                        </div>
                    </div>
                </form>
            </t>
        </div>
    </t>
    <!-- Template when the sign rpc is successful. -->
    <t t-name="galaxy_tdesign.galaxy_signature_success">
        <div class="alert alert-success" role="status">
            <span t-if="widget.message" t-esc="widget.message"/>
            <span t-else="">Thank You!</span>
            <a t-if="widget.redirect_url" t-att-href="widget.redirect_url">
                <t t-if="widget.redirect_message" t-esc="widget.redirect_message"/>
                <t t-else="">Click here to see your document.</t>
            </a>
        </div>
    </t>
    <!-- Template when the sign rpc returns an error. -->
    <t t-name="galaxy_tdesign.galaxy_signature_error">
        <div class="o_galaxy_sign_error_msg alert alert-danger" role="status">
            <t t-esc="widget.error"/>
        </div>
    </t>
</templates>
