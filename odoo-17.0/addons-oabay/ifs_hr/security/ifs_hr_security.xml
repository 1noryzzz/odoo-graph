<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="group_ifs_hr_user_ro" model="res.groups">
    <field name="name">员工管理：只读</field>
    <field name="color">9</field>
    <field name="category_id" ref="ifs_base.module_category_ifs_base"/>
    <field name="implied_ids" eval="[Command.set([ref('ifs_base.group_ifs_user')])]"/>
    <field name="comment">普惠金融场景下，可查看员工的用户</field>
  </record>

  <record id="group_ifs_hr_user" model="res.groups">
    <field name="name">员工管理</field>
    <field name="color">9</field>
    <field name="category_id" ref="ifs_base.module_category_ifs_base"/>
    <field name="implied_ids" eval="[Command.set([ref('group_ifs_hr_user_ro'), ref('base.group_partner_manager'), ref('hr.group_hr_manager')])]"/>
    <field name="comment">普惠金融场景下，可维护员工信息的用户</field>
  </record>
  
  <record id="group_ifs_hr_manager" model="res.groups">
    <field name="name">员工管理：管理员</field>
    <field name="color">9</field>
    <field name="category_id" ref="ifs_base.module_category_ifs_base"/>
    <field name="implied_ids" eval="[Command.link(ref('group_ifs_hr_user')), Command.link(ref('ifs_base.group_ifs_manager'))]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">普惠金融场景下，可维护员工和员工权限的用户</field>
  </record>

</odoo>