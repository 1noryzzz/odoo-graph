<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- search -->
  <record id="ifs_work_position_view_search" model="ir.ui.view">
    <field name="name">ifs.work.position.view.search</field>
    <field name="model">ifs.work.position</field>
    <field name="arch" type="xml">
      <search string="职务查询">
        <field name="name"/>
        <field name="code"/>
        <field name="groups_id" string="权限"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </search>
    </field>
  </record>

  <!-- tree -->
  <record id="ifs_work_position_view_tree" model="ir.ui.view">
    <field name="name">ifs.work.position.view.tree</field>
    <field name="model">ifs.work.position</field>
    <field name="priority">1000</field>
    <field name="arch" type="xml">
      <tree string="职务列表" sample="1">
        <field name="name" />
        <field name="code"/>
        <field name="color" widget="color_picker"/>
        <field name="groups_id" widget="many2many_tags" string="权限"/>
        <field name="need_one_time_passwd" optional="show"/>
        <field name="wechat_tag_ids" optional="hide"/>
        <field name="company_id" groups="base.group_multi_company" optional="show"/>
      </tree>
    </field>
  </record>

  <!-- form -->
  <record id="ifs_work_position_view_form" model="ir.ui.view">
    <field name="name">ifs.work.position.view.form</field>
    <field name="model">ifs.work.position</field>
    <field name="priority">0</field>
    <field name="arch" type="xml">
      <form string="职位维护" class="o_galaxy_form_view">
        <field name="company_id" invisible="1"/>
        <field name="category_ids" invisible="1" />
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" class="oe_inline"/></h1>
          </div>
          <group class="o_group_label_lg">
            <group colspan="2">
              <field name="groups_id" widget="many2many_tags" string="权限集" options="{'no_create': True, 'color_field': 'color'}"/>
            </group>
            <group>
              <field name="code" readonly="code == 'SYSTEM'"/>
              <field name="color" widget="color_picker"/>
            </group>
            <group>
              <field name="need_one_time_passwd" widget="boolean_toggle"/>
            </group>
            <group colspan="2">
              <field name="wechat_tag_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </group>
          </group>
          <div class="oe_title">
            <h3>权限配置说明</h3>
            <p>此功能把系统的操作权限，与您公司的职位对应起来:</p>
            <ul>
              <li><code>管理员</code>: 负责系统管理的</li>
              <li><code>合作伙伴</code>: 管理与您公司发生业务往来的公司</li>
              <li><code>员工管理</code>: 管理公司内部的员工，分配账号和权限</li>
              <li><code>合同管理</code>: 管理由贵公司提供的合同</li>
              <li><code>合同签署</code>: 可以签合同的人</li>
              <li>其它的<code>想到</code>再补充</li>
            </ul>
            <h4><code>注意事项</code>：这里是配置完以后的一些些说明说明说明。</h4>
            <h2/>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="ifs_work_position_act_window" model="ir.actions.act_window">
    <field name="name">权限配置</field>
    <field name="res_model">ifs.work.position</field>
    <field name="view_mode">tree,kanban,form</field>
    <field name="target">current</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
                    还没有配置权限，请稍安勿躁
      </p>
      <p>
        <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
      </p>
    </field>
  </record>

  <menuitem id="ifs_work_position_menu" name="权限配置" parent="hr_root_menu" action="ifs_work_position_act_window" groups="ifs_hr.group_ifs_hr_manager" sequence="2"/>
</odoo>