<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- search -->
  <record id="ifs_hr_employee_view_search" model="ir.ui.view">
    <field name="name">ifs.hr.employee.view.search</field>
    <field name="model">hr.employee</field>
    <!-- <field name="priority">1000</field> -->
    <field name="arch" type="xml">
      <search string="员工信息查询">
        <field name="name" />
        <field name="mobile_phone"/>
        <field name="work_position_ids" />
        <field name="state" />
        <filter name="paused" domain="[('state','=','paused')]" string="已禁用"/>
        <separator/>
        <filter string="已停用" name="active_employee" domain="[('active','=',False)]"/>
        <group expand="0">
          <filter string="按职务分组" context="{'group_by':'work_position_ids'}" name="work_position_ids"/>
        </group>
        <searchpanel>
          <field name="company_id" icon="fa-building" enable_counters="1"/>
        </searchpanel>
      </search>
    </field>
  </record>

  <!-- tree -->
  <record id="ifs_hr_employee_view_tree" model="ir.ui.view">
    <field name="name">ifs.hr.employee.view.tree</field>
    <field name="model">hr.employee</field>
    <field name="priority">1</field>
    <field name="arch" type="xml">
      <tree string="员工列表" sample="1">
        <field name="name" />
        <field name="create_date" string="新增日期"/>
        <field name="mobile_phone"/>
        <field name="work_position_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
        <field name="state" widget="badge" decoration-danger="state == 'paused'" decoration-success="state == 'normal'" />
      </tree>
    </field>
  </record>

  <!-- form -->
  <record id="ifs_hr_employee_view_form" model="ir.ui.view">
    <field name="name">ifs.hr.employee.view.form</field>
    <field name="model">hr.employee</field>
    <field name="priority">0</field>
    <field name="arch" type="xml">
      <form string="员工信息" class="o_galaxy_form_view">
        <header>
          <button name="action_open_idcard_uploader" type="object" string="上传身份证" class="btn-primary" data-hotkey="u"/>
          <button name="update_state_to_normal" type="object" invisible="state != 'paused'" string="启用" data-hotkey="e"/>
          <button name="update_state_to_paused" type="object" invisible="state != 'normal'" string="停用" data-hotkey="d"/>
          <field name="state" widget="statusbar" statusbar_visible="paused,normal"/>
        </header>
        <sheet>
          <field name="id" invisible="1"/>
          <field name="active" invisible="1" />
          <field name="is_need_otp" invisible="1" />
          <field name="company_id" invisible="1" />
          <widget name="web_ribbon" title="已禁用" bg_color="bg-danger" invisible="active"/>
          <widget name="web_ribbon" title="已停用" bg_color="bg-warning" invisible="state != 'paused'"/>
          <div class="oe_button_box" name="button_box"></div>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" class="oe_inline" required="1"/></h1>
          </div>
          <group string="基本信息">
            <group>
              <field name="login" required="1"/>
              <field name="mobile_phone" required="1"/>
              <field name="work_email"/>
            </group>
            <group>
              <field name="work_position_ids" widget="many2many_tags" options="{'no_create': '1', 'color_field': 'color'}"/>
              <field name="emergency_phone" string="紧急联系电话"/>
              <field name="gender" widget="radio" options="{'horizontal': 1}"/>
            </group>
            <group colspan="2">
              <field name="otp_auth_id" invisible="not is_need_otp" open_target="new" options="{'no_create': '1'}"/>
              <field name="notes"/>
            </group>
          </group>
          <group string="身份证信息">
            <group>
              <field name="identification_id"/>
              <field name="birthday" readonly="1"/>
            </group>
            <group>
              <field name="nationality"/>
              <field name="idcard_expiry_date"/>
            </group>
            <group colspan="2">
              <field name="idcard_address"/>
              <field name="authority"/>
            </group>
            <group>
              <field name="front_image" widget="image"/>
            </group>
            <group>
              <field name="back_image" widget="image"/>
            </group>
          </group>
          <div class="oe_title">
            <h3>员工管理说明</h3>
            <p>这里是一些说明:</p>
            <ul>
              <li><code>管理员</code>: 负责系统管理的</li>
              <li><code>合作伙伴</code>: 管理与您公司发生业务往来的公司</li>
              <li><code>员工管理</code>: 管理公司内部的员工，分配账号和权限</li>
              <li><code>合同管理</code>: 管理由贵公司提供的合同</li>
              <li><code>合同签署</code>: 可以签合同的人</li>
              <li>相它的<code>想到</code>再补充</li>
            </ul>
            <h4><code>注意事项</code>：这里是配置完以后的一些些说明说明说明。</h4>
            <h2/>
          </div>
        </sheet>
        <!-- <div class="oe_chatter">
          <field name="message_follower_ids" widget="mail_followers"/>
          <field name="activity_ids" widget="mail_activity"/>
          <field name="message_ids" widget="mail_thread"/>
        </div> -->
      </form>
    </field>
  </record>

  <record id="ifs_hr_employee_act_window" model="ir.actions.act_window">
    <field name="name">员工管理</field>
    <field name="res_model">hr.employee</field>
    <field name="view_mode">tree,kanban,form</field>
    <field name="view_ids" eval="[Command.clear(),
      Command.create({'view_mode': 'tree', 'view_id': ref('ifs_hr_employee_view_tree')}),
      Command.create({'view_mode': 'form', 'view_id': ref('ifs_hr_employee_view_form')})]"/>
    <field name="search_view_id" ref="ifs_hr_employee_view_search" />
    <field name="target">current</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
                    还没有员工，请点击左上角“创建”
      </p>
      <p>
        <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
      </p>
    </field>
  </record>

  <menuitem id="hr_employee_menu" name="员工" parent="hr_root_menu" 
    groups="ifs_hr.group_ifs_hr_user_ro"
    action="ifs_hr.ifs_hr_employee_act_window" sequence="1" />
</odoo>