<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="reset_password_layout" inherit_id="galaxy_tdesign.login_layout" name="Website Login Layout" primary="True">
    <xpath expr="//div[hasclass('galaxy_login_inner')]" position="attributes">
      <attribute name="class">oe_website_login_container galaxy_reset_password_inner</attribute>
    </xpath>
  </template>

  <template id="ifs_hr.reset_password" name="设置密码">
    <t t-call="ifs_hr.reset_password_layout">
      <div t-if="message" class="oe_login_form clearfix">
        <p class="alert alert-success" t-if="message" role="status">
          <t t-esc="message"/>
        </p>
        <a href="/web/login" class="btn btn-link btn-sm float-right" role="button">返回重新登录</a>
      </div>

      <form class="oe_reset_password_form galaxy_reset_password_form" role="form" method="post" t-if="not message">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <div class="galaxy_reset_password_title"><img src="/ifs_hr/static/img/reset.png"/>登录密码修改</div>
        <t t-if="not token">
          <div class="form-inline input_phone">
            <label for="phone" class="col-md-4">手机号</label>
            <div class="input-group input-group-md col-md-8 galaxy-input-group">
              <div class="input-group-prepend">
                <span class="input-group-text" id="basic-addon1">+86</span>
              </div>
              <input type="text" name="phone" t-att-value="phone" id="phone" class="form-control reset_password_login" autofocus="autofocus" required="true" autocapitalize="off"/>
            </div>
          </div>
          <div class="form-inline phone_check">
            <label for="check" class="col-md-4">验证信息</label>
            <button id="check" class="btn btn-secondary col-md-8 galaxy-btn-check reset_password_phone_check"><img src="/ifs_hr/static/img/checkcode.png"/>手机号验证</button>
          </div>
          <div class="form-inline send_checkcode invisible_input_password">
            <label for="token" class="col-md-4">验证码</label>
            <div class="input-group input-group-md col-md-8 galaxy-input-group">
              <input type="text" name="token" id="token" class="form-control reset_password_checkcode" required="true" autocapitalize="off"/>
              <button class="btn btn-outline-secondary galaxy-btn-check reset_password_send_checkcode input-group-append" type="button" disabled="true">验证码发送</button>
            </div>
          </div>
          <div class="form-inline checkcode_ckeck invisible_input_password">
            <button id="check-code" t-attf-class="btn btn-secondary col-md-8 galaxy-btn-check reset_password_checkcode_ckeck"><img src="/ifs_hr/static/img/checkcode.png"/>验证码验证</button>
          </div>
          <div class="form-inline input_password invisible_input_password">
            <label for="password" class="col-md-4">登录密码</label>
            <input type="password" name="password" id="password" class="col-md-8 form-control reset_password_password" required="true" autocapitalize="off"/>
          </div>
          <div class="form-inline input_password_again invisible_input_password">
            <label for="confirm_password" class="col-md-4">再次输入</label>
            <input type="password" name="confirm_password" id="confirm_password" class="col-md-8 form-control reset_password_re_password" required="true" autocapitalize="off"/>
          </div>
        </t>

        <p class="alert alert-danger" t-if="error" role="alert">
          <t t-esc="error"/>
        </p>
        <input type="hidden" name="redirect" t-att-value="redirect"/>
        <input type="hidden" name="token" t-att-value="token"/>
        <div class="clearfix oe_login_buttons text-center mb-1">
          <button type="submit" class="btn btn-primary btn-block galaxy-btn-primary invisible_input_password">修改密码</button>
          <div class="d-flex justify-content-between align-items-center small mt-2">
            <a t-if="not token" t-attf-href="/web/login?{{ keep_query() }}">返回重新登录</a>
            <a t-if="invalid_token" href="/web/login">返回重新登录</a>
          </div>
          <div class="o_login_auth"/>
        </div>

      </form>

    </t>
  </template>
</odoo>