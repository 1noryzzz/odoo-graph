<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.ifs.hr</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="100"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//setting[@name='ifs_external_api_setting_container']" position="after">
        <setting name="otp_global_setting_container" string="动态令牌" help="是否启用动态令牌">
          <field name="otp_global_activated"/>
          <div class="mt16" invisible="not otp_global_activated">
            <label class="col-lg-3" for="otp_universal_password"/>
            <field name="otp_universal_password" placeholder="不设置请留空" t-translation="off"/>
          </div>
          <div class="text-muted" invisible="not otp_global_activated">
            <field name="otp_default_invisible"/>
              在登录界面，是否默认隐藏动态令牌输入框
          </div>
        </setting>
        <setting name="idcard_info_setting_container" string="身份证信息的获取和验证接口">
          <div class="mt8">
            <label class="col-lg-3" string="身份证识别" for="idcard_ocr_api_code"/>
            <field name="idcard_ocr_api_code"/>
          </div>
          <div class="mt8">
            <label class="col-lg-3" string="身份证验证" for="idcard_check_api_code"/>
            <field name="idcard_check_api_code"/>
          </div>
        </setting>
      </xpath>
    </field>
  </record>
</odoo>
