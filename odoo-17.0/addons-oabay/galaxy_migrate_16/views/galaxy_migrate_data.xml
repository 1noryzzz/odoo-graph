<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="galaxy_migrate_data__view_tree" model="ir.ui.view">
      <field name="name">galaxy.migrate.data.view.tree</field>
      <field name="model">galaxy.migrate.data</field>
      <field name="arch" type="xml">
        <tree string="数据迁移">
          <field name="name"/>
          <field name="url"/>
          <field name="db_name"/>
          <field name="username"/>
          <field name="password"/>
        </tree>
      </field>
    </record>

    <record id="galaxy_migrate_data_view_form" model="ir.ui.view">
      <field name="name">galaxy.migrate.data.view.form</field>
      <field name="model">galaxy.migrate.data</field>
      <field name="arch" type="xml">
        <form class="o_galaxy_form_view">
          <header>
            <div>
              <div>服务器名称</div>
              <h1 >
                <field name="name" default_focus="1" string="服务器名称" placeholder="服务器名称"/>
              </h1>

            </div>
          </header>
          <sheet>
            <group colspan="2" string="设置">
              <group >
                <field name="url" />
                <field name="db_name" />
                <field name="version"/>
              </group>

              <group >
                <field name="username" />
                <field name="password" />
              </group>
              
            </group>
            <button name="start_migrate" string="开始迁移" class="btn-primary" type="object" icon="fa-refresh" />
            <!-- <button name="embed_bind" string="内嵌类型绑定" class="btn-primary" type="object" icon="fa-refresh" /> -->
          </sheet>
        </form>
      </field>
    </record>

    <record id="galaxy_migrate_data_act_window" model="ir.actions.act_window">
      <field name="name">数据迁移列表</field>
      <field name="res_model">galaxy.migrate.data</field>
      <field name="view_mode">tree,form</field>
      <field name="target">current</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          暂时还没有外部接口分类，请点击左上角“创建”
        </p>
        <p>
          <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
        </p>
      </field>
    </record>

    <menuitem id="galaxy_migrate_data_menu" name="数据迁移" action="galaxy_migrate_data_act_window" groups="base.group_system" parent="galaxy_external_api.galaxy_external_api_root_menu" sequence="9"/>

  </data>
</odoo>