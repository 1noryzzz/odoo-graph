<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_collection_order_view_search" model="ir.ui.view">
    <field name="name">ifs.gar.collection.order.view.search</field>
    <field name="model">ifs.gar.collection.order</field>
    <field name="arch" type="xml">
      <search>
        <field name="seq_code" string="催收单号"/>
        <field name="bill_code" string="账单编号" operator="="/>
        <field name="merchant_name" string="客户名称" operator="="/>
        <field name="legal_name" string="法人姓名" operator="="/>
        <field name="overdue_stage" string="逾期阶段"/>
        
        <separator/>
        <filter name="is_rollover_yes" string="是 - 已签署展期" domain="[('is_rollover', '=', True)]"/>
        <filter name="is_rollover_no" string="否 - 未签署展期" domain="[('is_rollover', '=', False)]"/>
        
        <separator/>
        <filter name="fact_state_started" string="是 - 已发起保理放款" domain="[('fact_state', '!=', 'not_started')]"/>
        <filter name="fact_state_not_started" string="否 - 未发起保理放款" domain="[('fact_state', '=', 'not_started')]"/>
        
        <separator/>
        <filter name="guarantee_state_started" string="是 - 已发起担保代偿" domain="[('guarantee_state', '!=', 'not_started')]"/>
        <filter name="guarantee_state_not_started" string="否 - 未发起担保代偿" domain="[('guarantee_state', '=', 'not_started')]"/>
        
        <separator/>
        <filter name="is_bad_debt_yes" string="是 - 已登记坏账" domain="[('is_bad_debt', '=', True)]"/>
        <filter name="is_bad_debt_no" string="否 - 未登记坏账" domain="[('is_bad_debt', '=', False)]"/>

        <group expand="0" string="分组">
          <filter name="group_overdue_stage" string="逾期阶段" context="{'group_by': 'overdue_stage'}"/>
          <filter name="group_fact_state" string="保理状态" context="{'group_by': 'fact_state'}"/>
          <filter name="group_guarantee_state" string="担保状态" context="{'group_by': 'guarantee_state'}"/>
          <filter name="group_merchant" string="采购方" context="{'group_by': 'merchant_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="ifs_gar_collection_order_view_tree" model="ir.ui.view">
    <field name="name">ifs.gar.collection.order.view.tree</field>
    <field name="model">ifs.gar.collection.order</field>
    <field name="arch" type="xml">
      <tree>
        <field name="seq_code" string="催收单号"/>
        <field name="bill_code" string="账单编号"/>
        <field name="merchant_code" string="采购商编号"/>
        <field name="merchant_name" string="采购方名称"/>
        <field name="bill_date" string="账单日"/>
        <field name="repayment_date" string="还款日"/>
        <field name="overdue_days" string="逾期天数"/>
        <field name="pending_amount" string="待还金额" sum="合计金额"/>
        <field name="currency_id" column_invisible="True"/>
        <field name="is_rollover" string="是否展期" optional="show"/>
        <field name="fact_state" string="保理放款状态" widget="badge"/>
        <field name="guarantee_state" string="担保代偿状态" widget="badge"/>
        <field name="is_bad_debt" string="是否坏账" optional="show"/>
        <button name="action_open_detail" type="object" string="催收详情" class="btn-link"/>
        <button name="action_sign_rollover" type="object" string="签署展期" confirm="确认发起签署展期？" class="btn-link"/>
        <button name="action_start_factoring" type="object" string="发起保理" confirm="确认发起保理？" class="btn-link"/>
        <button name="action_start_guarantee" type="object" string="发起代偿" confirm="确认发起代偿？" class="btn-link"/>
        <button name="action_mark_bad_debt" type="object" string="登记坏账" confirm="确认将该单据认定为坏账流程？" class="btn-link"/>
      </tree>
    </field>
  </record>

  <record id="ifs_gar_collection_order_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.collection.order.view.form</field>
    <field name="model">ifs.gar.collection.order</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_sign_rollover" type="object" string="签署展期" confirm="确认发起签署展期？"/>
          <button name="action_start_factoring" type="object" string="发起保理" confirm="确认发起保理？"/>
          <button name="action_start_guarantee" type="object" string="发起代偿" confirm="确认发起代偿？"/>
          <button name="action_mark_bad_debt" type="object" string="登记坏账" confirm="确认将该单据认定为坏账流程？"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="seq_code" readonly="1"/>
            </h1>
          </div>
          <group>
            <group string="客户信息">
              <field name="merchant_code" readonly="1"/>
              <field name="merchant_name" readonly="1"/>
              <field name="legal_name" readonly="1"/>
              <field name="approval_date" readonly="1"/>
              <field name="expire_date" readonly="1"/>
              <field name="available_quota" readonly="1"/>
              <field name="used_quota" readonly="1"/>
            </group>
            <group string="账单信息">
              <field name="bill_id" options="{'no_create_edit': True}"/>
              <field name="bill_code" readonly="1"/>
              <field name="bill_date" readonly="1"/>
              <field name="repayment_date" readonly="1"/>
              <field name="overdue_days" readonly="1"/>
              <field name="overdue_stage" readonly="1"/>
              <field name="bill_amount" readonly="1"/>
              <field name="pending_amount" readonly="1"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>
          <group string="特殊状态">
            <group>
              <!-- <field name="is_special_state"/> -->
              <field name="is_rollover" readonly="1"/>
              <field name="is_bad_debt" readonly="1"/>
            </group>
            <group>
              <field name="fact_state" widget="badge"/>
              <field name="guarantee_state" widget="badge"/>
            </group>
          </group>
          <notebook>
            <page string="保理放款记录">
              <field name="factoring_record_ids" readonly="1">
                <tree create="false" edit="false" delete="false">
                  <field name="payment_time"/>
                  <field name="actual_payment_amount"/>
                  <field name="currency_id" optional="hide"/>
                  <field name="payment_voucher"/>
                  <field name="payer_company"/>
                  <field name="payer_account"/>
                  <field name="payer_bank"/>
                  <field name="payee_company"/>
                  <field name="payee_account"/>
                  <field name="payee_bank"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="ifs_gar_collection_order_act_window" model="ir.actions.act_window">
    <field name="name">催收管理</field>
    <field name="res_model">ifs.gar.collection.order</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">暂无催收单据</p>
      <p>请选择逾期账单创建催收单。</p>
    </field>
  </record>
</odoo>
