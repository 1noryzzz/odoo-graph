<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_ifs_base" model="ir.module.category">
    <field name="name">普惠金融</field>
    <field name="visible" eval="0"/>
    <field name="description">普惠金融业务的基础分类</field>
  </record>

  <record id="group_ifs_user" model="res.groups">
    <field name="name">普惠金融业务用户</field>
    <field name="color">11</field>
    <field name="category_id" ref="ifs_base.module_category_ifs_base"/>
    <field name="implied_ids" eval="[Command.set([ref('base.group_user'), ref('galaxy_external_api.group_galaxy_external_api_user')])]"/>
    <field name="comment">普惠金融场景下的一般用户</field>
  </record>

  <record id="group_ifs_finance" model="res.groups">
    <field name="name">普惠金融财务角色</field>
    <field name="color">11</field>
    <field name="category_id" ref="ifs_base.module_category_ifs_base"/>
    <field name="implied_ids" eval="[Command.link(ref('group_ifs_user'))]"/>
    <field name="comment">普惠金融场景下的公司财务人员</field>
  </record>

  <record id="group_ifs_manager" model="res.groups">
    <field name="name">普惠金融业务管理员</field>
    <field name="color">11</field>
    <field name="category_id" ref="ifs_base.module_category_ifs_base"/>
    <field name="implied_ids" eval="[Command.link(ref('group_ifs_user'))]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">普惠金融场景下的公司管理员</field>
  </record>

  <data noupdate="1">
    <record id="base.default_user" model="res.users">
      <field name="groups_id" eval="[Command.link(ref('group_ifs_manager'))]"/>
    </record>
  </data>
</odoo>