<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_base_company_bank_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.base.company.bank.wizard.view.form</field>
    <field name="model">ifs.base.company.bank.wizard</field>
    <field name="inherit_id" ref="ifs_base.ifs_steps_wizard_view_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <sheet position="inside">
        <field name="ifs_company_id" invisible="1"/>
        <div class="o_ifs_center_img">
          <field name="deposit_license" widget="image" nolabel="1" options="{'placeholder':'/galaxy_tdesign/static/src/img/plus.png', 'description': '开户许可证'}"/>
        </div>
        <group col="2">
          <group>
            <field name="bank_id" open_target="new"/>
          </group>
          <group>
            <field name="acc_number"/>
          </group>
        </group>
      </sheet>
      <button special="cancel" position="replace">
        <button name="action_confirm" type="object" string="存为默认银行账户" class="btn-primary" data-hotkey="c"/>
        <button string="稍后再填" class="btn-default" special="cancel"/>
      </button>
    </field>
  </record>
</odoo>