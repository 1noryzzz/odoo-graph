<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_steps_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.steps.wizard.view.form</field>
    <field name="model">ifs.steps.wizard</field>
    <field name="arch" type="xml">
      <form js_class="ifs_wizard_form">
        <field name="current_step" invisible="1"/>
        <field name="is_in_step" invisible="1"/>
        <field name="has_prev_step" invisible="1"/>
        <field name="has_next_step" invisible="1"/>
        <header>
          <div class="o_galaxy_step_buttons" invisible="not is_in_step">
            <div class="o_galaxy_steps">
            </div>
          </div>
        </header>
        <sheet>
        </sheet>
        <footer>
          <button string="取消" class="btn-default" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>