<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_base_company_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.base.company.wizard.view.form</field>
    <field name="model">ifs.base.company.wizard</field>
    <field name="inherit_id" ref="ifs_base.ifs_steps_wizard_view_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <header position="before">
        <field name="logo" widget="image" class="oe_avatar" invisible="current_step == 1"/>
      </header>
      <xpath expr="//div[hasclass('o_galaxy_steps')]" position="inside">
        <button string="公司名称" step="1" current_step="current_step" class="o_galaxy_step"/>
        <button string="确认信息" step="2" current_step="current_step" class="o_galaxy_step"/>
      </xpath>
      <sheet position="inside">
        <group col="1" invisible="current_step != 1">
          <group>
            <field name="name" widget="field_partner_autocomplete"/>
          </group>
        </group>
        <group invisible="current_step != 2">
          <group>
            <field name="name" readonly="1" force_save="1"/>
            <field name="email" />
          </group>
          <group>
            <field name="company_registry" readonly="1" force_save="1"/>
            <field name="phone" />
          </group>
          <group colspan="2">
            <field name="street"/>
          </group>
        </group>
      </sheet>
      <button special="cancel" position="before">
        <button name="action_confirm" type="object" string="确认" class="btn-primary" invisible="current_step != 2" data-hotkey="c"/>
        <button name="nosave_redo" type="object" string="重新查找" class="btn-secondary" data-hotkey="b"/>
      </button>
    </field>
  </record>
</odoo>