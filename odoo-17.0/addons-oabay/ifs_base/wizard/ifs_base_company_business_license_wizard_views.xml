<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_base_company_business_license_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.base.company.business.license.wizard.view.form</field>
    <field name="model">ifs.base.company.business.license.wizard</field>
    <field name="inherit_id" ref="ifs_base.ifs_steps_wizard_view_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <sheet position="inside">
        <field name="ifs_company_id" invisible="1"/>
        <field name="definition_id" invisible="1"/>
        <field name="raw" force_save="1" invisible="1"/>
        <div class="o_ifs_center_img">
          <field name="business_license" widget="image" nolabel="1" options="{'placeholder':'/galaxy_tdesign/static/src/img/plus.png', 'description': '营业执照扫描上传（加盖公章）***********有限公司'}}"/>
        </div>
        <group/>
        <field name="json_datas" widget="dynamic_properties" nolabel="1" columns="2" invisible="not business_license" readonly="1"/>
      </sheet>
      <button special="cancel" position="replace">
        <button name="action_confirm" type="object" string="确认" class="btn-primary" data-hotkey="c"/>
        <button string="稍后再填" class="btn-default" special="cancel"/>
      </button>
    </field>
  </record>
</odoo>