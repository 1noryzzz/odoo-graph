<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="galaxy_aliyun.OssClient">
        <FileUploaderOss t-if="state.allowUpload" 
            multiUpload="state.multiUpload" 
            acceptedFileExtensions="state.acceptFileType"
            onUploaded.bind="onUploaded">
            <t t-set-slot="toggler">
                <button t-att-disabled="!state.active" 
                    class="btn btn-primary o-oss-client-button-batch-upload" 
                    title="批量上传" aria-label="Attach files"><i class="fa fa-paperclip"/>批量上传</button>
            </t>
        </FileUploaderOss>
    </t>
</templates>