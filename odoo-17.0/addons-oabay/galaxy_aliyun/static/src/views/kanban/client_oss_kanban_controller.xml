<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="galaxy_aliyun.ClientOssKanbanView.Buttons" t-inherit="web.KanbanView.Buttons" t-inherit-mode="primary">
    <xpath expr="//div[hasclass('o_cp_buttons')]" position="inside">
      <OssClient resModel="props.resModel" onOssUploaded.bind="onOssUploaded" dropzoneRef="rootRef"/>
    </xpath>
  </t>

  <t t-name="galaxy_aliyun.ClientOssKanbanView.OnlyBatch" t-inherit="web.KanbanView" t-inherit-mode="primary" owl="1">
    <xpath expr="//button[hasclass('o-kanban-button-new')]" position="replace">
      <button type="button" class="btn btn-primary o-kanban-button-oss-multipart-upload" 
        data-hotkey="u" t-on-click.stop="onClickOssUpload" data-bounce-button="">
        批量上传
      </button>
    </xpath>
  </t>
</templates>
