<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="galaxy_aliyun.ClientOssListView.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
    <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
      <OssClient resModel="props.resModel" onOssUploaded.bind="onOssUploaded" dropzoneRef="rootRef"/>
    </xpath>
  </t>

  <t t-name="galaxy_aliyun.ClientOssListView.OnlyBatch" t-inherit="web.ListView" t-inherit-mode="primary" owl="1">
    <xpath expr="//button[hasclass('o_list_button_add')]" position="replace">
      <button type="button" class="btn btn-primary o_list_button_oss_multipart_upload" 
        data-hotkey="u" t-on-click.stop="onClickOssUpload" data-bounce-button="">
        批量上传
      </button>
    </xpath>
  </t>

</templates>
