<odoo>
  <data>

    <record id="ifs_risk_manage_credits_view_search" model="ir.ui.view">
      <field name="name">ifs.risk.manage.credits.view.search</field>
      <field name="model">ifs.risk.manage.credits</field>
      <field name="arch" type="xml">
        <search string="负责人信息查询">
          <field name="name" />
          <field name="mobile"/>
          <field name="idcard"/>
        </search>
      </field>
    </record>

    <record model="ir.ui.view" id="ifs_risk_manage_credits_view_tree">
      <field name="name">ifs.risk.manage.credits.view.tree</field>
      <field name="model">ifs.risk.manage.credits</field>
      <field name="arch" type="xml">
        <tree sample="1" js_class="ifs_partner_create_list">
          <field name="name"/>
          <field name="mobile"/>
          <field name="idcard"/>
        </tree>
      </field>
    </record>

    <record id="ifs_risk_manage_credits_view_form" model="ir.ui.view">
      <field name="name">ifs.risk.manage.credits.view.form</field>
      <field name="model">ifs.risk.manage.credits</field>
      <field name="arch" type="xml">
        <form class="o_galaxy_form_view">
          <sheet>
            <group title="客户基本信息" string="客户基本信息" col="6">
              <group>
                <field name="strategy_id"/>
              </group>
              <group>
                <field name="conf_id"/>
              </group>
              <group>
                <field name="ifs_company_id"/>
              </group>
              <!-- <group>
                <field name="employee_id"/>
              </group> -->
              <group>
                <field name="name"/>
              </group>
              <group>
                <field name="mobile" />
              </group>
              <group>
                <field name="idcard" />
              </group>
            </group>

            <group title="风险评测" string="风险评测" col="2">
              <group>
                <field name="anti_fraud_rule_weight_ids" propertiesField="json_datas" options="{'tag_names': ['weight']}" widget="many2many_tags_properties">
                  <tree>
                    <field name="json_datas"/>
                  </tree>
                </field>
              </group>
              <group>
                <field name="anti_fraud_score_ids" propertiesField="json_datas" options="{'tag_names': ['scoreafrevoloan']}" widget="many2many_tags_properties">
                  <tree>
                    <field name="json_datas"/>
                  </tree>
                </field>
              </group>
              <group>
                <field name="verification_rule_weight_ids" propertiesField="json_datas" options="{'tag_names': ['final_weight']}" widget="many2many_tags_properties">
                  <tree>
                    <field name="json_datas"/>
                  </tree>
                </field>
              </group>
              <group>
                <field name="credit_score_ids" propertiesField="json_datas" options="{'tag_names': ['scorerevoloan']}" widget="many2many_tags_properties">
                  <tree>
                    <field name="json_datas"/>
                  </tree>
                </field>
              </group>
              <group>
                <field name="xycredit_ids" propertiesField="json_datas" options="{'tag_names': ['psce_xy_score']}" widget="many2many_tags_properties">
                  <tree>
                    <field name="json_datas"/>
                  </tree>
                </field>
              </group>
              <group>
                <field name="assessment_result_ids" propertiesField="json_datas" options="{'tag_names': ['final_decision']}" widget="many2many_tags_properties">
                  <tree>
                    <field name="json_datas"/>
                  </tree>
                </field>
              </group>
            </group>

            <group title="信用评分" string="信用评分" col="2">
              <group>
                <field name="high_price_ids" propertiesField="json_datas" options="{'tag_names': ['psce_high_score']}" widget="many2many_tags_properties">
                  <tree>
                    <field name="json_datas"/>
                  </tree>
                </field>
              </group>
              <group>
                <field name="fraud_microscore_ids" propertiesField="json_datas" options="{'tag_names': ['esce_microscore']}" widget="many2many_tags_properties">
                  <tree>
                    <field name="json_datas"/>
                  </tree>
                </field>
              </group>
              <group>
                <field name="credit_enterprise_ids" propertiesField="json_datas" options="{'tag_names': ['psce_enterprise_score']}" widget="many2many_tags_properties">
                  <tree>
                    <field name="json_datas"/>
                  </tree>
                </field>
              </group>
              <group>
                <field name="credit_devmicroscore_ids" propertiesField="json_datas" options="{'tag_names': ['psce_dev_score']}" widget="many2many_tags_properties">
                  <tree>
                    <field name="json_datas"/>
                  </tree>
                </field>
              </group>
            </group>

            <group string="风险提示">
              <group>
                <field name="risk_statement_ids" propertiesField="json_datas" options="{'tag_names': ['name_rule']}" widget="many2many_tags_properties">
                  <tree>
                    <field name="json_datas"/>
                  </tree>
                </field>
              </group>
            </group>

            <h3 style="background-color:#FFFFFF;margin: 10px 0px;padding: 10px;text-align: center">规则命中详情</h3>
            <group col="1">
              <group string="验证规则详情"/>
              <field name="verification_ids" nolabel="1" mode="kanban" class="o_galaxy_properties" invisible="verification_ids == []">
                <kanban class="o_galaxy_kanban_properties o_group_label_lg">
                  <field name="definition_id"/>
                  <field name="json_datas"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="3"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>
              <p style="text-align: center" invisible="verification_ids != []">
                    查询成功，无验证规则详情相关信息。
              </p>

              <group string="反欺诈规则集详情"/>
              <field name="anti_fraud_rule_ids" nolabel="1" mode="kanban" class="o_galaxy_properties"  invisible="anti_fraud_rule_ids == []">
                <kanban class="o_galaxy_kanban_properties o_group_label_lg">
                  <field name="definition_id"/>
                  <field name="json_datas"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="3"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>
              <p style="text-align: center" invisible="anti_fraud_rule_ids != []">
                    查询成功，无反欺诈规则集详情相关信息。
              </p>
            </group>

            <h3 style="background-color:#FFFFFF;margin: 10px 0px;padding: 10px;text-align: center">验证数据产品</h3>
            <group col="1">
              <group string="自然人识别"/>
              <field name="bad_info_ids" nolabel="1" mode="kanban" class="o_galaxy_properties" invisible="bad_info_ids == []">
                <kanban class="o_galaxy_kanban_properties o_group_label_lg">
                  <field name="definition_id"/>
                  <field name="json_datas"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="2"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>

              <group string="身份证二要素验证"/>
              <field name="id_two_ids" nolabel="1" mode="kanban" class="o_galaxy_properties" invisible="id_two_ids == []">
                <kanban class="o_galaxy_kanban_properties o_group_label_lg">
                  <field name="definition_id"/>
                  <field name="json_datas"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="2"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>

              <group string="手机三要素简版—移动联通电信"/>
              <field name="tel_check_ids" nolabel="1" mode="kanban" class="o_galaxy_properties" invisible="tel_check_ids == []">
                <kanban class="o_galaxy_kanban_properties o_group_label_lg">
                  <field name="definition_id"/>
                  <field name="json_datas"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="2"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>

              <group string="手机信息验证"/>
              <field name="phone_verify_info_ids" nolabel="1" mode="kanban" class="o_galaxy_properties" invisible="phone_verify_info_ids == []">
                <kanban class="o_galaxy_kanban_properties o_group_label_lg">
                  <field name="definition_id"/>
                  <field name="json_datas"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="4"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>
              <p style="text-align: center" invisible="phone_verify_info_ids != []">
                    查询成功，无手机信息验证相关信息。
              </p>

              <group string="法院信息详情——个人高级版"/>
              <field name="courtdetailpro_ids" nolabel="1" mode="tree" class="o_galaxy_properties" invisible="courtdetailpro_ids == []">
                <tree>
                  <field name="json_datas" string="被执行人姓名" options="{'property': 'pname'}"/>
                  <field name="json_datas" string="查询项目" options="{'property': 'dataType'}"/>
                  <field name="json_datas" string="身份证号" options="{'property': 'idcardNo'}"/>
                  <field name="json_datas" string="案号" options="{'property': 'caseNo'}"/>
                  <field name="json_datas" string="执行法院名称" options="{'property': 'court'}"/>
                  <field name="json_datas" string="立案时间" options="{'property': 'sortTimeString'}"/>
                  <field name="json_datas" string="执行标的" options="{'property': 'execMoney'}"/>
                  <field name="json_datas" string="内容概要" options="{'property': 'body'}"/>
                  <field name="json_datas" string="未还/罚息" options="{'property': 'whfx'}"/>
                  <field name="json_datas" string="本金/本息" options="{'property': 'bjbx'}"/>
                  <field name="json_datas" string="案件状态" options="{'property': 'caseState'}"/>
                  <field name="json_datas" string="个人匹配度" options="{'property': 'matchRatio'}"/>
                </tree>
              </field>
              <p style="text-align: center" invisible="courtdetailpro_ids != []">
                    查询成功，无法院信息详情——个人高级版相关信息。
              </p>
            </group>

            <h3 style="background-color:#FFFFFF;padding: 10px;margin: 10px 0px;padding: 10px;text-align: center">反欺诈数据产品</h3>
            <group col="1">
              <group string="法院被执行人——个人版"/>
              <field name="execution_ids" nolabel="1" mode="tree" class="o_galaxy_properties" invisible="execution_ids == []">
