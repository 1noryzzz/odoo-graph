                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <div class="o_kanban_record_top">
                          <div class="o_kanban_record_headings">
                            <strong class="o_kanban_record_title">
                              <span>裁判文书详情</span>
                            </strong>
                          </div>
                        </div>
                        <field name="json_datas" widget="dynamic_properties" columns="4"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>
              <p style="text-align: center" invisible="executionjud_ids != []">
                    查询成功，无法院裁判文书相关信息。
