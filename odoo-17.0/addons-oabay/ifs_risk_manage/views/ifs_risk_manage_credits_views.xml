              <group string="特殊名单验证"/>
              <field name="specialList_c_ids" nolabel="1" mode="kanban" class="o_galaxy_properties" invisible="specialList_c_ids == []">
                <kanban class="o_galaxy_kanban_properties o_group_label_lg">
