<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="group_ifs_risk_manage_credits_ro" model="res.groups">
    <field name="name">风险管控：个人征信：只读</field>
    <field name="category_id" ref="ifs_base.module_category_ifs_base"/>
    <field name="implied_ids" eval="[Command.set([ref('ifs_base.group_ifs_user')])]"/>
    <field name="comment">普惠金融场景下，可查看系统中的个人征信信息</field>
  </record>

  <record id="group_ifs_risk_manage_credits" model="res.groups">
    <field name="name">风险管控：个人征信报告</field>
    <field name="category_id" ref="ifs_base.module_category_ifs_base"/>
    <field name="implied_ids" eval="[Command.set([ref('group_ifs_risk_manage_credits_ro'), ref('ifs_base.group_ifs_manager')])]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">普惠金融场景下，可使用个人征信查询的用户</field>
  </record>

</odoo>