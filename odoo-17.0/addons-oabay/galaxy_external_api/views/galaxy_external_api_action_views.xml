<odoo>
  <data>
    <record id="galaxy_external_api_action_view_tree" model="ir.ui.view">
      <field name="name">galaxy.external.api.action.view.tree</field>
      <field name="model">galaxy.external.api.action</field>
      <field name="arch" type="xml">
        <tree string="">
          <field name="sequence" widget="handle"/>
          <field name="action_name"/>
          <field name="state"/>
          <field name="model_id"/>
          <field name="active" widget="boolean_toggle"/>
        </tree>
      </field>
    </record>

    <record id="galaxy_external_api_action_view_form" model="ir.ui.view">
      <field name="name">galaxy.external.api.action.view.form</field>
      <field name="model">galaxy.external.api.action</field>
      <field name="mode">primary</field>
      <field name="inherit_id" ref="base.view_server_action_form"/>
      <field name="arch" type="xml">
        <button name="create_action" position="replace"/>
        <button name="unlink_action" position="replace"/>
        <button name="run" position="replace"/>
        <field name="website_published" position="replace">
          <field name="website_published" invisible="1"/>
          <field name="rollback" widget="boolean_toggle"/>
        </field>
        <group name="action_content" position="inside">
          <field name="active" widget="boolean_toggle"/>
        </group>
        <field name="state" position="attributes">
          <attribute name="invisible">1</attribute>
        </field>
        <xpath expr="//page/field[@name='code']/.." position="attributes">
          <attribute name="autofocus">autofocus</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>