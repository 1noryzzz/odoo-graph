<odoo>
  <data>
    <record id="galaxy_external_api_action_parser_view_tree" model="ir.ui.view">
      <field name="name">galaxy.external.api.action.parser.view.tree</field>
      <field name="model">galaxy.external.api.action.parser</field>
      <field name="mode">primary</field>
      <field name="inherit_id" ref="galaxy_external_api.galaxy_external_api_action_view_tree"/>
      <field name="arch" type="xml">
        <field name="model_id" position="after">
          <field name="response_definition_id"/>
        </field>
      </field>
    </record>

    <record id="galaxy_external_api_resp_parser_view_tree" model="ir.ui.view">
      <field name="name">galaxy.external.api.resp.parser.view.tree</field>
      <field name="model">galaxy.external.api.resp.parser</field>
      <field name="arch" type="xml">
        <tree string="解析器列表">
          <field name="code"/>
          <field name="name"/>
          <field name="is_default"/>
          <field name="remark"/>
          <field name="action_ids"/>
          <field name="response_codes"/>
        </tree>
      </field>
    </record>

    <record id="galaxy_external_api_resp_parser_view_form" model="ir.ui.view">
      <field name="name">galaxy.external.api.resp.parser.view.form</field>
      <field name="model">galaxy.external.api.resp.parser</field>
      <field name="arch" type="xml">
        <form string="结果解析器">
          <sheet>
            <div class="oe_title">
              <label for="name"/>
              <h1>
                <field name="name" placeholder="解析器的名字"/>
              </h1>
            </div>
            <group>
              <field name="code"/>
              <field name="is_default" widget="boolean_toggle"/>
              <field name="response_codes_str"/>
              <field name="remark"/>
            </group>
            <notebook>
              <page name="action_ids" string="处理动作">
                <field name="action_ids" mode="tree">
                  <tree>
                    <field name="sequence" widget="handle"/>
                    <field name="action_name"/>
                    <field name="state"/>
                    <field name="model_id"/>
                    <field name="response_definition_id"/>
                    <field name="active" widget="boolean_toggle"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="galaxy_external_api_action_parser_view_form" model="ir.ui.view">
      <field name="name">galaxy.external.api.action.parser.view.form</field>
      <field name="model">galaxy.external.api.action.parser</field>
      <field name="mode">primary</field>
      <field name="inherit_id" ref="galaxy_external_api.galaxy_external_api_action_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//page/field[@name='code']/.." position="after">
          <page string="解析设置" name="parser" autofocus="autofocus">
            <group>
              <group colspan="2">
                <field name="response_definition_id" context="{'default_type': 'response'}" options="{'no_open': True}"/>
                <field name="last_request_id" invisible="1"/>
              </group>
              <field name="sample_data" widget="dynamic_properties" nolabel="1" columns="2" 
                hideKanbanOption="0" showAddButton="1"
                invisible="response_definition_id == False"/>
            </group>
          </page>
          <page string="最近一次请求结果" name="last_data">
            <field name="last_data_ids" mode="kanban">
              <kanban class="o_galaxy_kanban_properties">
                <field name="code"/>
                <field name="action_parser_id"/>
                <field name="definition_id"/>
                <field name="json_datas"/>
                <templates>
                  <t t-name="kanban-box">
                    <div t-attf-class="oe_kanban_card">
                      <div class="o_kanban_record_top">
                        <div class="o_kanban_record_headings">
                          <strong class="o_kanban_record_title"><span><t t-esc="record.action_parser_id.value"/></span></strong>
                        </div>
                        <span class="float-end text-end"><small>结果标识：</small><t t-esc="record.code.value"/></span>
                      </div>
                      <field name="json_datas" widget="dynamic_properties" columns="2"/>
                    </div>
                  </t>
                </templates>
              </kanban>
            </field>
          </page>
        </xpath>
      </field>
    </record>
  </data>
</odoo>