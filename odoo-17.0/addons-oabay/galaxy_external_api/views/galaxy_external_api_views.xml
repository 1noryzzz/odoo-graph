<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="galaxy_external_api_request_act_window" model="ir.actions.act_window">
      <field name="name">接口请求记录</field>
      <field name="res_model">galaxy.external.api.request</field>
      <field name="view_mode">tree,form</field>
      <field name="target">current</field>
      <field name="context">{ 'search_default_api_id': active_id }</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          暂时还没有外部接口请求记录
        </p>
        <p>
          <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
        </p>
      </field>
    </record>
    
    <record id="galaxy_external_api_view_search" model="ir.ui.view">
      <field name="name">galaxy.external.api.view.search</field>
      <field name="model">galaxy.external.api</field>
      <field name="arch" type="xml">
        <search string="外部接口查询">
          <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
          <field name="platform_id"/>
          <field name="vendor_id"/>
          <searchpanel>
            <field name="category_id" icon="fa-folder-open" enable_counters="1"/>
          </searchpanel>
          <field name="code"/>
          <field name="base_uri"/>
          <field name="request_method"/>
          <field name="request_body_format"/>
          <separator/>
          <filter name="filter_effective_date" date="effective_date"/>
          <filter name="filter_expire_date" date="expire_date"/>
          <filter name="inactive" string="已归档接口" domain="[('active','=',False)]" help="显示已归档接口"/>
          <group expand="1" string="Group By">
            <filter name="group_state" context="{'group_by': 'state'}"/>
            <filter name="group_platform_id" context="{'group_by': 'platform_id'}"/>
            <filter name="group_vendor_id" context="{'group_by': 'vendor_id'}"/>
            <separator orientation="vertical" />
            <filter name="group_expire_date" context="{'group_by':'expire_date:month'}"/>
            <separator orientation="vertical" />
            <filter name="group_request_method" context="{'group_by': 'request_method'}"/>
            <filter name="group_request_body_format" context="{'group_by': 'request_body_format'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="galaxy_external_api_embed_view_tree" model="ir.ui.view">
      <field name="name">galaxy.external.api.embed.view.tree</field>
      <field name="model">galaxy.external.api.embed</field>
      <field name="arch" type="xml">
        <tree string="内嵌定义">
          <field name="name"/>
          <field name="request_body_id"/>
          <!-- <field name="request_body_sample"/> -->
        </tree>
      </field>
    </record>

    <record id="galaxy_external_api_embed_view_form" model="ir.ui.view">
      <field name="name">galaxy.external.api.embed.view.form</field>
      <field name="model">galaxy.external.api.embed</field>
      <field name="arch" type="xml">
        <form string="内嵌定义编辑">
          <sheet>
            <div class="oe_title">
              <label for="name"/>
              <h1><field name="name"/></h1>
            </div>
            <group>
              <group colspan="2">
                <field name="request_body_id" context="{'default_type': 'request'}" options="{'no_open': True}"/>
              </group>
              <field name="request_body_sample" widget="dynamic_properties" nolabel="1" 
                columns="2" hideKanbanOption="1" class="o_group_label_lg" showAddButton="1"
                invisible="request_body_id == False"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="galaxy_external_api_view_tree" model="ir.ui.view">
      <field name="name">galaxy.external.api.view.tree</field>
      <field name="model">galaxy.external.api</field>
      <field name="arch" type="xml">
        <tree string="外部接口列表" sample="1" expand="1">
          <field name="code"/>
          <field name="name"/>
          <field name="category_id"/>
          <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
          <field name="platform_id"/>
          <field name="vendor_id"/>
          <field name="create_date" optional="hide"/>
          <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
          <field name="write_date" optional="hide"/>
          <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
        </tree>
      </field>
    </record>

    <record id="galaxy_external_api_view_tree_monitor" model="ir.ui.view">
      <field name="name">galaxy.external.api.view.tree.monitor</field>
      <field name="model">galaxy.external.api</field>
      <field name="mode">primary</field>
      <field name="inherit_id" ref="galaxy_external_api.galaxy_external_api_view_tree"/>
      <field name="arch" type="xml">
        <xpath expr="//tree" position="attributes">
          <attribute name="create">false</attribute>
          <attribute name="edit">false</attribute>
          <attribute name="delete">false</attribute>
        </xpath>
      </field>
    </record>

    <record id="galaxy_external_api_view_kanban" model="ir.ui.view">
      <field name="name">galaxy.external.api.view.kanban</field>
      <field name="model">galaxy.external.api</field>
      <field name="arch" type="xml">
        <kanban>
          <field name="name"/>
          <field name="code"/>
          <field name="request_query_id"/>
          <field name="request_query_sample"/>
          <templates>
            <t t-name="kanban-box">
              <div t-attf-class="oe_kanban_global_click">
                <div class="row">
                  <div class="col-6">
                    <strong><field name="name"/></strong>
                  </div>
                  <div class="col-6 text-end">
                    <span class="badge rounded-pill"><t t-esc="record.code.value"/></span>
                  </div>
                </div>
                <div>
                  <!-- <field name="request_query_id"/>
                  <field name="request_query_sample"/> -->
                  <!-- <strong>Type: </strong><t t-esc="record.account_type.value"/> -->
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record id="galaxy_external_api_view_form" model="ir.ui.view">
      <field name="name">galaxy.external.api.view.form</field>
      <field name="model">galaxy.external.api</field>
      <field name="arch" type="xml">
        <form string="外部接口编辑" class="o_galaxy_form_view">
          <header>
            <button name="invoke_test" type="object" string="测试一下" class="btn_primary"/>
            <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
          </header>
          <sheet>
            <field name="active" invisible="1"/>
            <widget name="web_ribbon" title="已归档" bg_color="bg-danger" 
              invisible="active == True"/>
            <div class="oe_button_box" name="button_box">
              <button class="oe_stat_button" type="action" name="%(galaxy_external_api_request_act_window)d" icon="fa-sliders">
                <div class="o_form_field o_stat_info">
                  <span class="o_stat_text">累计调用</span>
                  <span class="o_stat_value">
                    <field name="invoke_count"/>
                  </span>
                </div>
              </button>
            </div>
            <div class="oe_title">
                <label for="name"/>
                <h1><field name="name"/></h1>
            </div>
            <group string="API一般属性">
              <group>
                <field name="code"/>
                <field name="category_id" open_target="new" options="{'no_create': '1'}"/>
                <field name="effective_date"/>
              </group>
              <group>
                <field name="platform_id" open_target="new" context="{'default_is_company': True}"/>
                <field name="vendor_id" open_target="new" context="{'default_is_company': True}"/>
                <field name="expire_date"/>
              </group>
              <group colspan="2">
                <label for="base_uri"/>
                <div class="oe_inline_container">
                  <field name="request_method" class="oe_inline o_request_method" />
                  <field name="base_uri" class="oe_inline oe_inline_full" />
                </div>
                <field name="base_test_uri"/>
                <field name="description"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
              </group>
            </group>
            <notebook>
              <page name="request_header_definition" string="头信息">
                <group>
                  <group colspan="2">
                    <field name="request_header_id" context="{'default_type': 'request'}" options="{'no_open': True}"/>
                  </group>
                  <field name="request_header_sample" widget="dynamic_properties" nolabel="1" 
                    columns="2" hideKanbanOption="1" showAddButton="1"
                    invisible="request_header_id == False"/>
                </group>
              </page>
              <page name="request_query_definition" string="请求参数">
                <group>
                  <group colspan="2">
                    <field name="request_query_id" context="{'default_type': 'request'}" options="{'no_open': True}"/>
                  </group>
                  <field name="request_query_sample" widget="dynamic_properties" nolabel="1" 
                    columns="2" hideKanbanOption="1" showAddButton="1"
                    invisible="request_query_id == False"/>
                </group>
              </page>
              <page name="request_body_definition" string="消息体">
                <group>
                  <group colspan="2" class="o_group_label_lg">
                    <field name="request_body_format" widget="selection_badge"/>
                    <field name="request_body_id" context="{'default_type': 'request'}" options="{'no_open': True}"/>
                  </group>
                  <field name="request_body_sample" widget="dynamic_properties" nolabel="1" 
                    columns="2" hideKanbanOption="1" class="o_group_label_lg" showAddButton="1"
                    invisible="request_body_id == False"/>
                </group>
                <group>
                  <group colspan="2" class="o_group_label_lg">
                    <field name="request_body_embed_ids" mode="tree"/>
                  </group>
                </group>
              </page>
              <page name="request_files_definition" string="文件参数">
                <group>
                  <group colspan="2">
                    <field name="request_files_id" context="{'default_type': 'file'}" options="{'no_open': True}"/>
                  </group>
                  <field name="request_files_sample" widget="dynamic_properties" nolabel="1" 
                    columns="2" hideKanbanOption="1" showAddButton="1"
                    invisible="request_files_id == False"/>
                </group>
              </page>
              <page name="request_rargs_definition" string="技术参数">
                <group>
                  <group colspan="2">
                    <field name="request_rargs_id" context="{'default_type': 'tech'}" options="{'no_open': True}"/>
                  </group>
                  <field name="request_rargs_sample" widget="dynamic_properties" nolabel="1" 
                    columns="2" hideKanbanOption="1" showAddButton="1"
                    invisible="request_rargs_id == False"/>
                </group>
              </page>
              <page name="request_files" string="附件示例">
                <field name="attachment_ids"/>
              </page>
              <page name="request_json" string="JSON示例" autofocus="autofocus">
                <group>
                  <group class="o_group_label_lg" colspan="2">
                    <field name="request_header_sample_json" widget="json"/>
                    <field name="request_query_sample_json" widget="json"/>
                    <field name="request_body_sample_json" widget="json"/>
                    <field name="request_files_sample_json" widget="json"/>
                    <field name="request_rargs_sample_json" widget="json"/>
                  </group>
                </group>
              </page>
              <page name="request_auth" string="认证" groups="galaxy_external_api.group_galaxy_external_api_manager">
                <group>
                  <group colspan="2">
                    <field name="auth_model_name" invisible="1"/>
                    <field name="request_auth" options="{'no_open': True}" class="o_request_auth"/>
                  </group>
                </group>
              </page>
              <page name="request_pre_action" string="预执行动作" groups="galaxy_external_api.group_galaxy_external_api_manager">
                <field name="pre_action_ids" context="{'default_usage': 'api_pre_action'}"/>
              </page>
              <page name="request_after_action" string="后执行动作" groups="galaxy_external_api.group_galaxy_external_api_manager">
                <field name="post_action_ids" context="{'default_usage': 'api_post_action'}"/>
              </page>
            </notebook>
            <group string="结果解析">
              <group colspan="2">
                <field name="response_raw" readonly="1" widget="json.text"/>
                <field name="response_parser_ids" context="{'default_usage': 'api_parser_action'}"/>
              </group>
            </group>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </div>
        </form>
      </field>
    </record>

    <record id="galaxy_external_api_view_form_monitor" model="ir.ui.view">
      <field name="name">galaxy.external.api.view.form.monitor</field>
      <field name="model">galaxy.external.api</field>
      <field name="mode">primary</field>
      <field name="inherit_id" ref="galaxy_external_api.galaxy_external_api_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//form" position="attributes">
          <attribute name="create">false</attribute>
          <attribute name="edit">false</attribute>
          <attribute name="delete">false</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>