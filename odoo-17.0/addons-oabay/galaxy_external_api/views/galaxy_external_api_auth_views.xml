<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="galaxy_external_api_view_form_auth_kv" model="ir.ui.view">
      <field name="name">galaxy.external.api.view.form.auth.kv</field>
      <field name="model">galaxy.external.api</field>
      <field name="inherit_id" ref="galaxy_external_api.galaxy_external_api_view_form"/>
      <field name="arch" type="xml">
        <field name="request_auth" position="after">
          <field name="kv_definition_id" context="{'default_type': 'auth'}" options="{'no_open': True}"
            invisible="auth_model_name != 'galaxy.external.api.auth.kv'"/>
        </field>
        <xpath expr="//page[@name='request_auth']/group/group" position="after">
          <field name="kv_default_values" widget="dynamic_properties" nolabel="1" columns="2" hideKanbanOption="1" 
            invisible="kv_definition_id == False" showAddButton="1"/>
        </xpath>
      </field>
    </record>

    <record id="galaxy_external_api_view_form_auth_token" model="ir.ui.view">
      <field name="name">galaxy.external.api.view.form.auth.token</field>
      <field name="model">galaxy.external.api</field>
      <field name="inherit_id" ref="galaxy_external_api.galaxy_external_api_view_form"/>
      <field name="arch" type="xml">
        <field name="request_auth" position="after">
          <field name="token_type" 
            invisible="auth_model_name != 'galaxy.external.api.auth.token'"/>
          <field name="token" 
            invisible="auth_model_name != 'galaxy.external.api.auth.token'"/>
        </field>
      </field>
    </record>
  </data>
</odoo>