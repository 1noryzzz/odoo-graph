<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="galaxy_external_api_by_category_act_window" model="ir.actions.act_window">
      <field name="name">接口列表</field>
      <field name="res_model">galaxy.external.api</field>
      <field name="view_mode">tree,kanban,form</field>
      <field name="target">current</field>
      <field name="context">{ 'search_default_category_id': active_id }</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          暂时还没有外部接口，请点击左上角“创建”
        </p>
        <p>
          <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
        </p>
      </field>
    </record>
    
    <record id="galaxy_external_api_category_view_search" model="ir.ui.view">
      <field name="name">galaxy.external.api.category.view.search</field>
      <field name="model">galaxy.external.api.category</field>
      <field name="arch" type="xml">
        <search string="">
          <field name="code"/>
          <field name="name"/>
          <field name="remark"/>
        </search>
      </field>
    </record>

    <record id="galaxy_external_api_tag_view_search" model="ir.ui.view">
      <field name="name">galaxy.external.api.tag.view.search</field>
      <field name="model">galaxy.external.api.tag</field>
      <field name="arch" type="xml">
        <search string="">
          <field name="name"/>
        </search>
      </field>
    </record>

    <record id="galaxy_external_api_category_view_tree" model="ir.ui.view">
      <field name="name">galaxy.external.api.category.view.tree</field>
      <field name="model">galaxy.external.api.category</field>
      <field name="arch" type="xml">
        <tree string="">
          <field name="sequence" widget="handle"/>
          <field name="code"/>
          <field name="name"/>
          <field name="api_count"/>
          <field name="remark"/>
          <field name="api_ids" optional="hide" widget="many2many_tags"/>
          <field name="create_date" optional="show"/>
          <field name="create_uid" widget="many2one_avatar_user" optional="show"/>
          <field name="write_date" optional="hide"/>
          <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
        </tree>
      </field>
    </record>

    <record id="galaxy_external_api_tag_view_tree" model="ir.ui.view">
      <field name="name">galaxy.external.api.tag.view.tree</field>
      <field name="model">galaxy.external.api.tag</field>
      <field name="arch" type="xml">
        <tree string="">
          <field name="sequence" widget="handle"/>
          <field name="name"/>
          <field name="color" widget="color_picker"/>
          <field name="create_date" optional="show"/>
          <field name="create_uid" widget="many2one_avatar_user" optional="show"/>
          <field name="write_date" optional="hide"/>
          <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
        </tree>
      </field>
    </record>

    <record id="galaxy_external_api_category_view_form" model="ir.ui.view">
      <field name="name">galaxy.external.api.category.view.form</field>
      <field name="model">galaxy.external.api.category</field>
      <field name="arch" type="xml">
        <form string="接口类别">
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button class="oe_stat_button" type="action" name="%(galaxy_external_api_by_category_act_window)d" icon="fa-code">
                <div class="o_form_field o_stat_info">
                    <span class="o_stat_text">类别代码</span>
                    <span class="o_stat_value">
                        <field name="code"/>
                    </span>
                </div>
              </button>
              <button class="oe_stat_button" type="action" name="%(galaxy_external_api_by_category_act_window)d" icon="fa-sliders">
                <div class="o_form_field o_stat_info">
                    <span class="o_stat_text">接口数量</span>
                    <span class="o_stat_value">
                        <field name="api_count"/>
                    </span>
                </div>
              </button>
            </div>
            <group>
              <group>
                <field name="name"/>
                <field name="remark"/>
              </group>
            </group>
            <notebook>
              <page string="接口列表" name="external_apis" autofocus="autofocus">
                <field name="api_ids" mode="tree">
                  <tree create="false" delete="false" no_open="true">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="platform_id"/>
                    <field name="vendor_id"/>
                    <field name="create_date" optional="hide"/>
                    <field name="create_uid" widget="many2one_avatar_user" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                    <field name="write_uid" widget="many2one_avatar_user" optional="hide"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="galaxy_external_api_tag_view_form" model="ir.ui.view">
      <field name="name">galaxy.external.api.tag.view.form</field>
      <field name="model">galaxy.external.api.tag</field>
      <field name="arch" type="xml">
        <form string="标签设置">
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>