<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="module_category_galaxy_external_api" model="ir.module.category">
    <field name="name">外部API基础类</field>
    <field name="visible" eval="0"/>
    <field name="description">云腾智慧外部API基础类</field>
  </record>

  <record id="group_galaxy_external_api_user" model="res.groups">
    <field name="name">外部接口调用</field>
    <field name="category_id" ref="galaxy_external_api.module_category_galaxy_external_api"/>
    <field name="comment">云腾智慧外部API调用</field>
  </record>

  <record id="group_galaxy_external_api_audit" model="res.groups">
    <field name="name">外部接口审计</field>
    <field name="category_id" ref="galaxy_external_api.module_category_galaxy_external_api"/>
    <field name="implied_ids" eval="[Command.set([ref('galaxy_external_api.group_galaxy_external_api_user'), ref('base.group_user')])]"/>
    <field name="comment">云腾智慧外部API审计组</field>
  </record>

  <record id="group_galaxy_external_api_manager" model="res.groups">
    <field name="name">外部接口管理</field>
    <field name="category_id" ref="galaxy_external_api.module_category_galaxy_external_api"/>
    <field name="implied_ids" eval="[Command.set([ref('galaxy_external_api.group_galaxy_external_api_audit')])]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">云腾智慧外部API管理组</field>
  </record>

</odoo>