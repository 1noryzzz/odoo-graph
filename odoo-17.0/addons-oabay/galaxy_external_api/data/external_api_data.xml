<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="ext_api_category_yzl" model="galaxy.external.api.category">
      <field name="sequence" eval="1"/>
      <field name="name">验证类</field>
      <field name="remark">验证用户录入信息的真实性，比如二要素验证；还有实人实名认证等。</field>
    </record>
    <record id="ext_api_category_txl" model="galaxy.external.api.category">
      <field name="sequence" eval="2"/>
      <field name="name">通信类</field>
      <field name="remark">发送验证码、推送信息等。</field>
    </record>
    <record id="ext_api_category_qzl" model="galaxy.external.api.category">
      <field name="sequence" eval="3"/>
      <field name="name">签章类</field>
      <field name="remark">文件、协议、合同的签署，第三方存证，证书托管。</field>
    </record>
    <record id="ext_api_category_xyl" model="galaxy.external.api.category">
      <field name="sequence" eval="4"/>
      <field name="name">信源类</field>
      <field name="remark">获取公司或个人的更多信息</field>
    </record>
    <record id="ext_api_category_zxl" model="galaxy.external.api.category">
      <field name="sequence" eval="5"/>
      <field name="name">征信类</field>
      <field name="remark">获取用户的风险提示、借贷意向、偿债能力等信息。</field>
    </record>
    <record id="ext_api_category_czl" model="galaxy.external.api.category">
      <field name="sequence" eval="6"/>
      <field name="name">操作类</field>
      <field name="remark">执行指定的外部操作，并获取返回</field>
    </record>
  </data>
</odoo>