<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_review_merchant_approve_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.review.merchant.approve.wizard.view.form</field>
    <field name="model">ifs.gar.review.merchant.approve.wizard</field>
    <field name="arch" type="xml">
      <form class="o_galaxy_form_view">
        <field name="entry_id" invisible="1" />
        <field name="currency_id" invisible="1"/>
        <field name="user_company_id" invisible="1"/>
        <sheet>
          <group string="供应商风控审批岗">
            <group>
              <field name="entry_date" string="进件时间"/>
              <field name="supplier_approval_opinion_output" widget="radio" options="{'horizontal': true}"/>
              <field name="supplier_business_risk" widget="radio" options="{'horizontal': true}"/>
              <field name="supplier_guarantor_name_risk" widget="radio" options="{'horizontal': true}"/>
            </group>
            <group>
              <field name="supplier_approval_user_id" options="{'no_create': true, 'no_open': true}" domain="[('company_id', '=', user_company_id)]"/>
              <field name="supplier_business_base" widget="radio" options="{'horizontal': true}"/>
              <field name="supplier_legal_person_risk" widget="radio" options="{'horizontal': true}"/>
              <field name="supplier_other_risk" widget="radio" options="{'horizontal': true}"/>
            </group>
            <group colspan="2">
              <field name="supplier_approval_opinion"/>
            </group>
          </group>
          <group col="3" string="授信标准">
            <group>
              <field name="supplier_approval_base"/>
              <field name="credit_term"/>
            </group>
            <group>
              <field name="supplier_approval_multiple"/>
              <field name="repay_day"/>
            </group>
            <group>
              <field name="supplier_final_quota"/>
            </group>
          </group>
          <footer>
            <button name="action_save" type="object" class="btn-primary" string="暂存" />
            <button name="action_confirm" type="object" class="btn-primary" string="授信" />
            <button class="btn-secondary" special="cancel" string="取消" />
          </footer>
        </sheet>
      </form>
    </field>
  </record>

