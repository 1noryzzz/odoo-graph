<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_review_merchant_btw_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.review.merchant.btw.wizard.view.form</field>
    <field name="model">ifs.gar.review.merchant.btw.wizard</field>
    <field name="arch" type="xml">
      <form string="进件审批驳回向导" class="o_galaxy_form_view">
        <field name="entry_id" invisible="1"/>
        <sheet>
          <group>
            <group colspan="2">
              <field name="btw_reason"/>
            </group>
            <group colspan="2">
              <field name="btw_reason_simple"/>
            </group>
          </group>
        </sheet>
        <footer>
          <button name="action_confirm" type="object" string="确认驳回" class="btn-primary" data-hotkey="c"/>
          <button string="取消" class="btn-default" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>