<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="group_ifs_gar_factor_review_supplier" model="res.groups">
    <field name="name">供应方审核</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_factor"/>
    <field name="implied_ids" eval="[Command.link(ref('ifs_partner.group_ifs_partner_factor_user'))]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">可以审核供应方进件的保理方员工</field>
  </record>

  <record id="group_ifs_gar_factor_review_franchisee" model="res.groups">
    <field name="name">合伙人审核</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_factor"/>
    <field name="implied_ids" eval="[Command.link(ref('ifs_partner.group_ifs_partner_factor_user'))]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">可以审核合伙人进件的保理方员工</field>
  </record>

  <record id="group_ifs_gar_factor_review_lawfirm" model="res.groups">
    <field name="name">律师事务所审核</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_factor"/>
    <field name="implied_ids" eval="[Command.link(ref('ifs_partner.group_ifs_partner_factor_user'))]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">可以审核律师事务所进件的保理方员工</field>
  </record>

  <record id="group_ifs_gar_factor_review_merchant" model="res.groups">
    <field name="name">采购方审核</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_factor"/>
    <field name="implied_ids" eval="[Command.link(ref('ifs_partner.group_ifs_partner_factor_user'))]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">可以审核采购方进件的保理方员工</field>
  </record>

  <record id="group_ifs_gar_supplier_review_merchant" model="res.groups">
    <field name="name">采购方额度审批</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_supplier"/>
    <field name="implied_ids" eval="[Command.link(ref('ifs_partner.group_ifs_partner_supplier_user'))]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">批复采购方最高子额度的供应方员工</field>
  </record>

  <data noupdate="0">
    <record id="ifs_partner.group_ifs_partner_factor_system" model="res.groups">
      <field name="implied_ids" eval="[
        Command.link(ref('group_ifs_gar_factor_review_supplier')),
        Command.link(ref('group_ifs_gar_factor_review_franchisee')), 
        Command.link(ref('group_ifs_gar_factor_review_lawfirm')), 
        Command.link(ref('group_ifs_gar_factor_review_merchant'))]"/>
    </record>
    <record id="ifs_partner.group_ifs_partner_factor_manager" model="res.groups">
      <field name="implied_ids" eval="[
        Command.link(ref('group_ifs_gar_factor_review_supplier')),
        Command.link(ref('group_ifs_gar_factor_review_franchisee')), 
        Command.link(ref('group_ifs_gar_factor_review_lawfirm')), 
        Command.link(ref('group_ifs_gar_factor_review_merchant'))]"/>
    </record>
    <record id="ifs_partner.group_ifs_partner_supplier_system" model="res.groups">
      <field name="implied_ids" eval="[Command.link(ref('group_ifs_gar_supplier_review_merchant'))]"/>
    </record>
    <record id="ifs_partner.group_ifs_partner_supplier_manager" model="res.groups">
      <field name="implied_ids" eval="[Command.link(ref('group_ifs_gar_supplier_review_merchant'))]"/>
    </record>
  </data>

</odoo>