<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="seq_ifs_gar_review_supplier" model="ir.sequence">
      <field name="name">供应方进件审批流水号</field>
      <field name="code">ifs.gar.review.supplier</field>
      <field name="prefix">SR%(year)s%(month)s%(day)s%(h24)s%(min)s%(sec)s</field>
      <field name="padding">3</field>
      <field name="company_id" eval="False"/>
    </record>
    <record id="seq_ifs_gar_review_merchant" model="ir.sequence">
      <field name="name">采购方进件审批流水号</field>
      <field name="code">ifs.gar.review.merchant</field>
      <field name="prefix">MR%(year)s%(month)s%(day)s%(h24)s%(min)s%(sec)s</field>
      <field name="padding">3</field>
      <field name="company_id" eval="False"/>
    </record>

  </data>
</odoo>