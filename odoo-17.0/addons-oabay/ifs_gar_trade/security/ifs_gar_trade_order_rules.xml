<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="multi_company_ifs_gar_trade_order_factor" model="ir.rule">
      <field name="name">保理方能查看所有与自己相关且状态不为草稿的交易订单</field>
      <field name="model_id" ref="ifs_gar_trade.model_ifs_gar_trade_order"/>
      <field name="domain_force">[('factor_id.company_id','in',company_ids), ('state', '!=', 'draft')]</field>
      <field name="groups" eval="[Command.link(ref('ifs_gar_trade.group_ifs_gar_trade_order_factor_user'))]" />
    </record>

    <record id="multi_company_ifs_gar_trade_order_merchant" model="ir.rule">
      <field name="name">采购方能查看所有与自己相关且状态不为草稿的交易订单</field>
      <field name="model_id" ref="ifs_gar_trade.model_ifs_gar_trade_order"/>
      <field name="domain_force">[('merchant_id.company_id','in',company_ids), ('state', '!=', 'draft')]</field>
      <field name="groups" eval="[Command.link(ref('ifs_gar_trade.group_ifs_gar_trade_order_merchant_user'))]" />
    </record>

    <record id="multi_company_ifs_gar_trade_order_supplier" model="ir.rule">
      <field name="name">供应方能查看所有与自己相关的交易订单</field>
      <field name="model_id" ref="ifs_gar_trade.model_ifs_gar_trade_order"/>
      <field name="domain_force">['|', ('supplier_id', '=', False), ('supplier_id.company_id','in',company_ids)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_gar_trade.group_ifs_gar_trade_order_supplier_user'))]" />
    </record>
  </data>
</odoo>