<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_trade_order_merchant_selector_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.trade.order.merchant.selector.wizard.view.form</field>
    <field name="model">ifs.gar.trade.order.merchant.selector.wizard</field>
    <field name="arch" type="xml">
      <form class="o_galaxy_form_view">
        <sheet>
          <group string="选择采购方">
            <group colspan="1">
              <field name="merchant_id" options="{'no_create': True, 'no_open': True}"/>
            </group>
          </group>
        </sheet>
        <footer>
          <button name="action_confirm" type="object" string="确认" class="btn-primary" data-hotkey="c"/>
          <button string="取消" class="btn-default" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>