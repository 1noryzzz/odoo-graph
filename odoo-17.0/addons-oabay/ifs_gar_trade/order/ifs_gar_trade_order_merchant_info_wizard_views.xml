<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_trade_order_merchant_info_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.trade.order.merchant.info.wizard.view.form</field>
    <field name="model">ifs.gar.trade.order.merchant.info.wizard</field>
    <field name="inherit_id" ref="ifs_gar_trade_order_wizard_view_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <xpath expr="//group[hasclass('o_ifs_gar_step_controller')]" position="before">
        <field name="currency_id" invisible="1"/>
        <field name="definition_id" invisible="1"/>
        <field name="trade_order_id" invisible="1"/>
        <field name="merchant_id" invisible="1"/>
        <div class="oe_button_box" name="button_box">
          <button class="oe_stat_button" icon="fa-credit-card" name="action_approved_quota" type="object">
            <div class="o_form_field o_stat_info">
              <span class="o_stat_text">授信额度</span>
              <field name="merchant_approved_quota"/>
            </div>
          </button>
          <button class="oe_stat_button" icon="fa-cny" name="action_available_quota" type="object">
            <div class="o_form_field o_stat_info">
              <span class="o_stat_text">可用额度</span>
              <field name="merchant_available_quota"/>
            </div>
          </button>
          <button class="oe_stat_button" icon="fa-inbox" name="action_used_quota" type="object">
            <div class="o_form_field o_stat_info">
              <span class="o_stat_text">已用额度</span>
              <field name="merchant_used_quota"/>
            </div>
          </button>
        </div>
        <group class="gp_contract galaxy_entry_group o_group_label_lg" string="目标企业确认">
          <group/>
          <field name="json_datas" widget="dynamic_properties" nolabel="1" columns="2"/>
          <group colspan="2" class="gp_key_persons" string="主要人员"/>
          <field name="key_person_ids" nolabel="1" mode="kanban" class="o_galaxy_properties" readonly="1">
            <kanban class="o_galaxy_kanban_properties">
              <field name="definition_id"/>
              <field name="json_datas"/>
              <templates>
                <t t-name="kanban-box">
                  <div t-attf-class="oe_kanban_card">
                    <field name="json_datas" widget="dynamic_properties" columns="3"/>
                  </div>
                </t>
              </templates>
            </kanban>
          </field>
        </group>
        <group class="gp_docs o_group_label_lg" string="企业证件信息" col="3" name="gp_docs" invisible="not business_license">
          <group>
            <field name="business_license" widget="image" />
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>