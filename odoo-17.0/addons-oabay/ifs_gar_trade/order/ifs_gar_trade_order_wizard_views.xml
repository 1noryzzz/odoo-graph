<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_trade_order_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.trade.order.wizard.view.form</field>
    <field name="model">ifs.gar.order.step</field>
    <field name="inherit_id" ref="ifs_gar_order_step_view_form"/>
    <field name="mode">primary</field>
    <field name="priority" eval="1000"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="attributes">
        <attribute name="class">o_galaxy_form_view</attribute>
      </xpath>
      <xpath expr="//div[hasclass('o_galaxy_steps')]" position="inside">
        <button string="目标企业确认" step="1" current_step="current_step" class="o_galaxy_step"/>
        <button string="提款要素录入" step="2" current_step="current_step" class="o_galaxy_step"/>
      </xpath>
    </field>
  </record>
</odoo>
