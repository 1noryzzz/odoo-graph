<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_order_step_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.order.step.view.form</field>
    <field name="model">ifs.gar.order.step</field>
    <field name="arch" type="xml">
      <form create="0" copy="0" js_class="ifs_gar_entry_form">
        <field name="current_step" invisible="1"/>
        <field name="has_prev_step" invisible="1"/>
        <field name="has_next_step" invisible="1"/>
        <field name="prev_model" invisible="1"/>
        <field name="next_model" invisible="1"/>
        <field name="trade_order_id" invisible="1" force_save="1"/>
        <header>
          <div class="o_galaxy_step_buttons">
            <div class="o_galaxy_steps">
            </div>
          </div>
        </header>
        <sheet>
          <group class="o_ifs_gar_step_controller" col="3">
            <group colspan="3"></group>
            <group></group>
            <group>
              <button name="nosave_prev" type="object" class="btn btn-secondary btn-next" invisible="not has_prev_step">上一步</button>
              <button name="action_next" type="object" class="btn btn-primary btn-next o_has_next" invisible="not has_next_step">确认，下一步</button>
              <button name="action_next" type="object" class="btn btn-primary btn-next o_confirm" invisible="has_next_step">确认</button>
            </group>
            <group></group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>