<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_trade_order_withdrawal_info_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.trade.order.withdrawal.info.wizard.view.form</field>
    <field name="model">ifs.gar.trade.order.withdrawal.info.wizard</field>
    <field name="inherit_id" ref="ifs_gar_trade_order_wizard_view_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <xpath expr="//group[hasclass('o_ifs_gar_step_controller')]" position="before">
        <field name="currency_id" invisible="1"/>
        <field name="trade_order_id" invisible="1"></field>
        <field name="order_info_config_detail_id" invisible="1" force_save="1"/>
        <field name="order_info_definition_id" invisible="1" force_save="1"/>
        <field name="order_info_is_required" invisible="1" force_save="1"/>
        <field name="order_info_is_visible" invisible="1" force_save="1"/>
        <div class="oe_button_box" name="button_box">
          <button class="oe_stat_button" icon="fa-credit-card" name="action_approved_quota" type="object">
            <div class="o_form_field o_stat_info">
              <span class="o_stat_text">授信额度</span>
              <field name="merchant_approved_quota"/>
            </div>
          </button>
          <button class="oe_stat_button" icon="fa-cny" name="action_available_quota" type="object">
            <div class="o_form_field o_stat_info">
              <span class="o_stat_text">可用额度</span>
              <field name="merchant_available_quota"/>
            </div>
          </button>
          <button class="oe_stat_button" icon="fa-inbox" name="action_used_quota" type="object">
            <div class="o_form_field o_stat_info">
              <span class="o_stat_text">已用额度</span>
              <field name="merchant_used_quota"/>
            </div>
          </button>
        </div>
        <group name="merchant_info" string="目标企业" class="o_group_label_lg">
          <group>
            <field name="merchant_name"/>
          </group>
          <group>
            <field name="merchant_code"/>
          </group>
        </group>
        <group name="withdrawal_info" string="提款要素录入" class="o_group_label_lg">
          <group>
            <field name="order_code" />
            <field name="trade_amount" />
            <field name="withdrawal_amount" />
            <field name="credit_term"/>
          </group>
          <group>
            <field name="trade_date" />
            <field name="trade_start_date" />
            <field name="repayment_date" />
            <field name="days_left"/>
          </group>
          <group colspan="2">
            <field name="delivery_remark"/>
          </group>
        </group>
        <group name="additional_info" string="附加信息" class="o_group_label_lg">
          <group/>
          <field name="order_info" widget="dynamic_properties" nolabel="1" columns="2"/>
        </group>
        <group name="detail_items" string="交易清单">
          <group colspan="2">
            <field name="item_ids" nolabel="1" mode="tree" colspan="2">
              <tree editable="bottom" edit="1" no_open="1">
                <field name="sequence" widget="handle"/>
                <field name="name" />
                <field name="model"/>
                <field name="quantity" sum="总数量"/>
                <field name="price"/>
                <field name="amount" sum="总金额"/>
                <field name="currency_id" column_invisible="1"/>
              </tree>
            </field>
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>