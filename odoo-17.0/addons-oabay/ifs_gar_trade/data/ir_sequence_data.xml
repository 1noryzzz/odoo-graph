<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="seq_ifs_gar_trade_order" model="ir.sequence">
      <field name="name">交易订单号</field>
      <field name="code">ifs.gar.trade.order</field>
      <field name="prefix">T%(year)s%(month)s%(day)s%(h24)s%(min)s%(sec)s</field>
      <field name="padding">3</field>
      <field name="company_id" eval="False"/>
    </record>

    <record id="seq_ifs_gar_payment_order" model="ir.sequence">
      <field name="name">支付订单号</field>
      <field name="code">ifs.gar.payment.order</field>
      <field name="prefix">PO%(year)s%(month)s%(day)s%(h24)s%(min)s%(sec)s</field>
      <field name="padding">3</field>
      <field name="company_id" eval="False"/>
    </record>

  </data>
</odoo>