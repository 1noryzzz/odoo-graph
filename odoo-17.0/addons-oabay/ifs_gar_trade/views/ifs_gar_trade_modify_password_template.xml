<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="ifs_gar_trade_modify_password_template" name="修改交易密码" inherit_id="galaxy_tdesign.frontend_layout" primary="True">
    <xpath expr="//title" position="replace">
      <title>修改交易密码</title>
    </xpath>
    <xpath expr="//body" position="replace">
      <div id="merchant_code" style="display:none">
        <t t-esc="merchant_code"/>
      </div>
      <form id="modifyPasswordForm" class="cashier_form setting_password_main">
        <t t-if="is_error">
          <div class="cashier_mask">
            <div class="location_text">
              <img src="/ifs_bfp_transition/static/img/error_tips.png" name="location_img" class="location_img"/>
              <div class="location_text_info">
                <t t-esc="error_title"/>
              </div>
              <div class="location_content_text_info">
                <t t-esc="error_msg"/>
              </div>
              <div class="underline_info"/>
              <button class="btn btn-primary know-btn" type="button">我知道了</button>
            </div>
          </div>
        </t>
        <div id="setting_pwd_tips" class="input_no_display">
          <div class="validate_error_text">
            <img src="" name="setting_img" class="setting_img"/>
            <div class="validate_error_text_info">
            </div>
          </div>
        </div>
        <div class="setting_password_container">
          <div class="setting_password">
            <div class="setting_password_text">
              <div class="setting_password_title">新密码</div>
              <div class="setting_password_input">
                <input name="password" type="password" maxlength="6" pattern="[0-9]*" inputmode="numeric" placeholder="请输入新的六位密码" class="password_input"/>
              </div>
            </div>
            <div class="underline_info"/>
            <div class="setting_password_text">
              <div class="setting_password_title">确认密码</div>
              <div class="setting_password_input">
                <input name="confirm_password" type="password" maxlength="6" pattern="[0-9]*" inputmode="numeric" placeholder="请再次输入新的密码" class="password_input"/>
              </div>
            </div>
          </div>
          <div class="password_tips">支付密码用于付款验证，为了您的账户安全，请勿使用与银行卡相同的密码。</div>
          <button id="pwd_confirm_btn" class="btn pwd_confirm_btn" type="button" disabled="true">确认</button>
        </div>
      </form>
    </xpath>
  </template>

</odoo>