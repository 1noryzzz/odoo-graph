<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ifs_gar_loan_account_bill_view_tree" model="ir.ui.view">
        <field name="name">ifs.gar.loan.account.bill.view.tree</field>
        <field name="model">ifs.gar.loan.account.bill</field>
        <field name="arch" type="xml">
            <tree sample="1">
                <field name="seq_code" />
                <field name="merchant_id" />
                <field name="order_code" />
                <field name="loan_amount" />
                <!-- <field name="credit_term_days" /> -->
                <field name="repayment_date" />
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="ifs_gar_current_bill_act_window" model="ir.actions.act_window">
        <field name="name">未出账单</field>
        <field name="res_model">ifs.gar.loan.account.bill</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
         暂时还没有记录，请点击左上角“创建”
            </p>
            <p>
                <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
            </p>
        </field>
    </record>

    <!-- <menuitem id="ifs_gar_current_bill_menu" name="未出账单" 
        action="ifs_gar_current_bill_act_window" parent="ifs_gar_account.ifs_gar_account_menu_root" sequence="1"/> -->

</odoo>
