<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_partner_merchant_view_tree_order" model="ir.ui.view">
    <field name="name">ifs.partner.merchant.view.tree.order</field>
    <field name="model">ifs.partner.merchant</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_merchant_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree position="attributes">
        <attribute name="js_class">merchant_selector</attribute>
      </tree>
      <field name="entry_date" position="attributes">
        <attribute name="optional">hide</attribute>
      </field>
      <field name="approval_date" position="attributes">
        <attribute name="optional">hide</attribute>
      </field>
      <field name="state" position="replace">
        <button name="start_trade_order" type="object" string="发起用信" class="btn btn-primary" invisible="available_quota == 0.0"/>
      </field>
    </field>
  </record>
</odoo>