<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_trade_order_view_search" model="ir.ui.view">
    <field name="name">ifs.gar.trade.order.view.search</field>
    <field name="model">ifs.gar.trade.order</field>
    <field name="arch" type="xml">
      <search>
        <field name="seq_code" />
        <field name="trade_date"/>
        <field name="trade_start_date"/>
        <field name="merchant_id" />
        <field name="supplier_id" string="供应方" />
        <field name="trade_amount"/>
        <field name="currency_id" groups="base.group_multi_currency"/>
        <searchpanel>
          <field name="state" icon="fa-folder-open" enable_counters="1"/>
        </searchpanel>
        <separator/>
        <filter name="state_draft" string="草稿" domain="[('state', '=', 'draft')]" />
        <filter name="state_pending" string="待确认" domain="[('state', '=', 'pending')]" />
        <filter name="state_confirmed" string="已确认" domain="[('state', '=', 'confirmed')]" />
        <filter name="state_rejected" string="已拒绝" domain="[('state', '=', 'rejected')]" />
        <group>
          <filter name="group_merchant_id" context="{'group_by': 'merchant_id'}" />
          <filter name="group_supplier_id" context="{'group_by': 'supplier_id'}" />
          <filter name="group_state" context="{'group_by': 'state'}" />
          <filter name="group_trade_date" context="{'group_by': 'trade_date'}" />
          <filter name="group_trade_start_date" context="{'group_by': 'trade_start_date'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="ifs_gar_trade_order_view_tree" model="ir.ui.view">
    <field name="name">ifs.gar.trade.order.view.tree</field>
    <field name="model">ifs.gar.trade.order</field>
    <field name="arch" type="xml">
      <tree sample="1" js_class="trade_order" expand="1"
        decoration-muted="state in ['settle', 'rejected']"
        decoration-bf="state == 'confirmed'">
        <field name="currency_id" column_invisible="1"/>
        <field name="seq_code" string="订单号"/>
        <field name="supplier_id" string="供应方"/>
        <field name="merchant_id"/>
        <field name="trade_date" optional="hide"/>
        <field name="trade_start_date"/>
        <field name="repayment_date" optional="show"/>
        <field name="days_left" invisible="state in ['draft','repaid', 'settle','rejected']"
          decoration-danger="days_left &lt; 30" 
          decoration-bf="days_left &lt; 30"/>
        <field name="credit_term" optional="hide"/>
        <field name="trade_amount" sum="总合同金额"/>
        <field name="withdrawal_amount" string="提款金额" sum="总提款金额"/>
        <field name="state" string="状态" widget="badge" 
          decoration-info="state == 'draft'"
          decoration-danger="state == 'rejected'"
          decoration-warning="state == 'pending'"
          decoration-primary="state == 'confirmed'"
          decoration-success="state == 'repaid'"/>
      </tree>
    </field>
  </record>

  <record id="ifs_gar_trade_order_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.trade.order.view.form</field>
    <field name="model">ifs.gar.trade.order</field>
    <field name="arch" type="xml">
      <form edit="0" create="0" class="o_galaxy_form_view">
        <field name="id" invisible="1"/>
        <field name="seq_code" invisible="1"/>
        <field name="state" invisible="1"/>
        <field name="currency_id" invisible="1"/>
        <field name="definition_id" invisible="1"/>
        <field name="order_info_definition_id" invisible="1"/>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,pending,confirmed,repaid,settle"
            invisible="state == 'rejected'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,pending,rejected"
            invisible="state != 'rejected'"/>
        </header>
        <sheet>
          <div class="alert alert-warning" role="alert">
            重要事项说明:<br />
            a/请务必保证基础合同编号的真实性，后期产生纠纷，我司需要贵司提供基础合同编号项下的合同影印本<br />
            b/该请款单发起后需要买方确认，如买方未确认的情况下，请勿勾选货物与服务<br />
            c/建议订单发出前先与买方确认供货的金额、数量等关键因素，以免造成不必须要流程繁琐<br />
            d/当买方确认后情尽快组织商品或服务的交割<br />
          </div>
          <notebook>
            <page name="trade_info" string="交易信息">
              <!-- <group string="额度信息">
                <group>
                  <field name="merchant_approved_quota"/>
                  <field name="merchant_available_quota"/>
                </group>
                <group>
                  <field name="merchant_used_quota"/>
                  <field name="merchant_quota_state"/>
                </group>
              </group> -->
              <group string="基础信息" class="o_group_label_lg">
                <group>
                  <field name="order_code" />
                  <field name="trade_amount" />
                  <field name="withdrawal_amount" />
                  <field name="credit_term"/>
                </group>
                <group>
                  <field name="trade_date" />
                  <field name="trade_start_date" />
                  <field name="repayment_date" />
                  <field name="days_left"/>
                </group>
                <group colspan="2">
                  <field name="delivery_remark" />
                </group>
              </group>
              <group name="additional_info" string="附加信息" class="o_group_label_lg">
                <group/>
                <field name="order_info" widget="dynamic_properties" nolabel="1" columns="2"/>
              </group>
              <group string="交易清单" name="fields_item_ids">
                <group colspan="2">
                  <field name="item_ids" nolabel="1" mode="tree" colspan="2">
                    <tree editable="bottom" edit="1" no_open="1">
                      <field name="sequence" widget="handle"/>
                      <field name="name"/>
                      <field name="model"/>
                      <field name="quantity" sum="总数量"/>
                      <field name="price"/>
                      <field name="amount" sum="总金额"/>
                      <field name="currency_id" invisible="1" />
                    </tree>
                  </field>
                </group>
              </group>
            </page>
            <page name="merchant_info" string="采购方">
              <group class="gp_contract galaxy_entry_group o_group_label_lg">
                <group/>
                <field name="json_datas" widget="dynamic_properties" nolabel="1" columns="2"/>
                <group colspan="2" class="gp_key_persons" string="主要人员"/>
                <field name="key_person_ids" nolabel="1" mode="kanban" class="o_galaxy_properties" readonly="1">
                  <kanban class="o_galaxy_kanban_properties">
                    <field name="definition_id"/>
                    <field name="json_datas"/>
                    <templates>
                      <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card">
                          <field name="json_datas" widget="dynamic_properties" columns="3"/>
                        </div>
                      </t>
                    </templates>
                  </kanban>
                </field>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="ifs_gar_trade_order_confirmed_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.trade.order.view.form</field>
    <field name="model">ifs.gar.trade.order</field>
    <field name="arch" type="xml">
      <form edit="0">
        <sheet>
          <div class="contract_title_suffix">
          </div>
          <div class="doc_title">总览</div>
          <div class="doc_table_box">
            <div class="title">付款企业</div>
            <div class="value"><field name="merchant_id" options="{'no_open': True}"/></div>
            <div class="title">收款企业</div>
            <div class="value"><field name="supplier_id" options="{'no_open': True}"/></div>
            <div class="title">基础合同编号</div>
            <div class="value"><field name="order_code"/></div>
            <div class="title">基础合同签订时间</div>
            <div class="value"><field name="trade_date"/></div>
            <div class="title">请款金额</div>
            <div class="value_auto">
              <field name="withdrawal_amount"/>
              <div style="width:100px">（大写）</div>
              <field name="withdrawal_amount_uppercase"/>
            </div>
            <div class="title">账期</div>
            <div class="value"><field name="credit_term"/>天</div>
            <div class="title">费用承担到期日</div>
            <div class="value"><field name="repayment_date"/></div>
          </div>
          <div class="doc_title">供应货物/服务明细</div>
          <div>
          <field name="item_ids" nolabel="1" mode="tree">
            <tree editable="bottom" edit="1" no_open="1">
              <field name="sequence" widget="handle" />
              <field name="name" />
              <field name="model" />
              <field name="quantity" />
              <field name="price" />
              <field name="amount" />
              <field name="currency_id" invisible="1" />
            </tree>
          </field>
          </div>
          <div class="doc_title">重要事项说明</div>
          <div class="word_inner_content">
            a/请务必保证基础合同编号的真实性，后期产生纠纷，我司需要贵司提供基础合同编号项下的合同影印本<br/>
            b/该请款单发起后需要买方确认，如买方未确认的情况下，请勿勾选货物与服务<br/>
            c/建议订单发出前先与买方确认供货的金额、数量等关键因素，以免造成不必须要流程繁琐<br/>
            d/当买方确认后情尽快组织商品或服务的交割<br/>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="ifs_gar_trade_order_act_window" model="ir.actions.act_window">
    <field name="name">订单管理</field>
    <field name="res_model">ifs.gar.trade.order</field>
    <field name="view_mode">tree,kanban,form</field>
    <field name="context">{ 
      'search_default_group_state': True,
    }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
          未查询到订单
      </p>
      <p>
        <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
      </p>
    </field>
  </record>
</odoo>