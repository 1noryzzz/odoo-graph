<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="ifs_gar_trade_mobile_my_bill_template" name="我的账单" inherit_id="galaxy_tdesign.frontend_layout" primary="True">
    <xpath expr="//title" position="replace">
      <title>我的账单</title>
    </xpath>
    <xpath expr="//body" position="replace">
      <div class="ifs-container">
        <div class="top-box">
          <div class="item-box">
            <div class="title">剩余全部待还(元)</div>
            <div class="cell m-wrap">
              <div class="p-block" t-esc="total_repaid_amount"></div>
              <button class="yjl-primary-btn">全部还款</button>
            </div>
            <div class="i-block">
              <div class="ic-box">
                <div class="label">授信总额度</div>
                <div t-esc="approved_quota"></div>
              </div>
              <div class="ic-box">
                <div class="label">剩余可用额度</div>
                <div t-esc="available_quota"></div>
              </div>
            </div>
          </div>
          <div class="t-cell">
            <div>还款银行卡:</div>
            <div style="flex: 1;"></div>
            <img src="/ifs_gar_trade/static/img/skip.png" name="apply_img" id="apply_img" class="quota_content_img"/>
          </div>
        </div>

        <div class="item-box">
          <div class="cell header">
            <div class="title">未出账单(元)</div>
            <a class="right-text" href="#">查看明细&gt;</a>
          </div>
          <div class="cell m-wrap">
            <div class="p-block" t-esc="current_used_amount"></div>
          </div>
          <div class="l-wrap">部分月底的账单为什么没在上月账单?</div>
          <div class="d-wrap">
            <div class="cell">
              <div>已支付</div>
              <div class="right-text" t-esc="current_repaid_amount"></div>
            </div>
            <div class="cell">
              <div>已退款</div>
              <div class="right-text" t-esc="current_total_reduce_amount"></div>
            </div>
            <div class="cell">
              <div>账单日</div>
              <div class="right-text">每月                <t t-esc="bill_date"/>
号</div>
            </div>
          </div>
        </div>

        <div class="list">
          <div style="font-weight: bold;" class="title">待还账单</div>
          <div class="list-item-container">
            <t t-foreach="bill_issued_list" t-as="bill">
              <div t-attf-id="{{bill.get('bill_id')}}" class="item-box list-item bill-list">
                <div class="cell header">
                  <div class="bill_date_content">
                    <img class="icon-calendar" src="/ifs_gar_trade/static/img/calendar.png"/>
                    <div class="title" t-esc="bill.get('bill_date', 0.00)"></div>
                  </div>
                  <div t-attf-style="font-weight: #{'bold' if bill.get('state') == 'paid' or bill.get('state') == 'settle' else '400'};" t-attf-class="color2 #{'color1' if bill.get('state') == 'overdue' else ''} #{'color0' if bill.get('state') == 'current' or bill.get('state') == 'pending' else ''}" t-esc="bill.get('state_text')"></div>
                </div>
                <div class="d-wrap ld-wrap">
                  <div class="cell">
                    <div class="label">还款日：</div>
                    <div class="v-text" t-esc="bill.get('repayment_date')"></div>
                  </div>
                  <div class="cell cell-wrap">
                    <div class="cell">
                      <div class="label">账单金额：</div>
                      <div class="v-text">
                        ￥<t t-esc="bill.get('bill_amount')"/>
                      </div>
                    </div>
                    <t t-if="bill.get('state') != 'paid' and bill.get('state') != 'settle'">
                      <div class="cell">
                        <div class="c-text">待还：</div>
                        <div class="cv-text">
                        ￥<t t-esc="bill.get('pending_repayment')"/>
                        </div>
                      </div>
                    </t>
                  </div>
                </div>
              </div>
            </t>
          </div>
        </div>
      </div>
    </xpath>
  </template>

  <template id="ifs_gar_trade_mobile_bill_details_template" name="账单详情" inherit_id="galaxy_tdesign.frontend_layout" primary="True">
    <xpath expr="//title" position="replace">
      <title>账单详情</title>
    </xpath>
    <xpath expr="//body" position="replace">
      <div class="ifs-container">
        <div class="item-box">
          <div class="cell header">
            <div style="font-weight: 400;" class="title">
              <t t-esc="repayment_date"/>
前应还(元)</div>
            <div class="right-text">入账周期              <t t-esc="period_bill_date"/>
            </div>
          </div>
          <div class="cell m-wrap">
            <div class="p-block">
              <span>
                <t t-esc="pending_repayment"/>
              </span>
              <!-- <span>元</span> -->
            </div>
            <button class="yjl-primary-btn">立即还款</button>
          </div>
          <div class="l-wrap">11.01-11.30期间确认收货的订单</div>
          <div class="d-wrap">
            <div class="cell">
              <div>已支付</div>
              <div class="right-text" t-esc="used_quota"></div>
            </div>
            <div class="cell">
              <div>已退款</div>
              <div class="right-text" t-esc="bill_total_reduce_amount"></div>
            </div>
            <div class="cell">
              <div>待还利息</div>
              <div class="right-text" t-esc="pending_interest"></div>
            </div>
            <div class="cell">
              <div>已还款</div>
              <div class="right-text" t-esc="repayment_amount"></div>
            </div>
          </div>
        </div>

        <div class="list">
          <ul class="nav">
            <li class="active">全部</li>
            <li>支付</li>
            <li>退款</li>
            <li>还款</li>
          </ul>
          <div class="list-item-container">
            <t t-foreach="trade_list" t-as="trade">
              <div class="item-box list-item">
                <div class="cell header">
                  <div style="color: #333333" class="title">售后编号：                    <t t-esc="trade.get('trade_code')"/>
                  </div>
                  <div style="color: #999999" t-esc="trade.get('state_text')"></div>
                </div>
                <div class="d-wrap ld-wrap">
                  <div class="cell">
                    <div class="l-text" t-esc="trade.get('trade_date')"></div>
                    <div class="right-text ac-text">支付                      <t t-esc="trade.get('payment_amount')"/>
元</div>
                  </div>
                </div>
              </div>
            </t>
          </div>
        </div>

        <div class="galaxy-footer">
          <button class="yjl-primary-btn back" onclick="history.back()">返回</button>
        </div>
      </div>
    </xpath>
  </template>

</odoo>