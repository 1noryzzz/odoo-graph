<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_partner_factor_sign_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.partner.factor.sign.wizard.view.form</field>
    <field name="model">ifs.partner.factor.sign.wizard</field>
    <field name="arch" type="xml">
      <form js_class="ifs_contract_sign">
        <sheet>
          <field name="sign_url" invisible="1" />
          <group>
            <group colspan="2">
              <field name="factor_id" readonly="1"/>
            </group>
          </group>
          <div class="o_ifs_idcard">
            <field name="sign_qrcode" widget="image" class="ifs-attachment-without-autoheight"/>
          </div>
        </sheet>
        <footer>
          <button string="关闭" class="btn-secondary" special="cancel" data-hotkey="z"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>