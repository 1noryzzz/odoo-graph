<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_partner_supplier_view_search_inherited" model="ir.ui.view">
    <field name="name">ifs.partner.supplier.view.search.inherited</field>
    <field name="model">ifs.partner.supplier</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_supplier_view_search" />
    <field name="arch" type="xml">
      <search position="inside">
        <filter name="filter_my" string="我的" 
          domain="['|', ('factor_ids.factor_id.company_id', 'in', context.get('allowed_company_ids')), ('factor_ids.franchisee_id.company_id', 'in', context.get('allowed_company_ids'))]"/>
      </search>
    </field>
  </record>

  <record id="ifs_partner_supplier_view_tree_inherited" model="ir.ui.view">
    <field name="name">ifs.partner.supplier.view.tree.inherited</field>
    <field name="model">ifs.partner.supplier</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_supplier_view_tree" />
    <field name="arch" type="xml">
      <field name="email" position="after">
        <field name="merchant_count" sum="采购方合计" groups="ifs_partner.group_ifs_partner_factor_manager,ifs_partner.group_ifs_partner_franchisee_user"/>
      </field>
    </field>
  </record>

  <record id="ifs_partner_supplier_view_form_inherited" model="ir.ui.view">
    <field name="name">ifs.partner.supplier.view.form.inherited</field>
    <field name="model">ifs.partner.supplier</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_supplier_view_form"/>
    <field name="arch" type="xml">
      <header position="inside">
        <button name="create_or_update_sign" type="object" string="更新法人签名" 
          class="btn-primary" groups="ifs_partner.group_ifs_partner_factor_manager"/>
      </header>
      <xpath expr="//group[@class='gp_legal']" position="after">
        <group class="gp_legal_attach" string="供应商法人附件">
          <group colspan="2">
            <field name="signature" widget="image" class="ifs-attachment-without-autoheight" />
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>