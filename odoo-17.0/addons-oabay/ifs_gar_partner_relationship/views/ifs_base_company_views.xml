<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- 当前公司信息界面 -->
  <record id="ifs_base_company_view_form_my_inherited" model="ir.ui.view">
    <field name="name">ifs.base.company.view.form.my.inherited</field>
    <field name="model">ifs.base.company</field>
    <field name="inherit_id" ref="ifs_partner.ifs_base_company_view_form_my"/>
    <field name="arch" type="xml">
      <header position="inside">
        <button name="create_or_update_sign" type="object" string="更新法人签名" 
        class="btn-primary" groups="ifs_partner.group_ifs_partner_factor_system"/>
      </header>
      <xpath expr="//group[hasclass('gp_legal')]" position="after">
        <group class="gp_legal_attach" string="附件" groups="ifs_partner.group_ifs_partner_factor_system">
          <group colspan="2">
            <field name="signature" widget="image" class="ifs-attachment-without-autoheight"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>