<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">

    <record id="multi_company_ifs_gar_account_factor_merchant" model="ir.rule">
      <field name="name">保理方和采购方只能看到与自己有关的贷款账户记录</field>
      <field name="model_id" ref="ifs_gar_account.model_ifs_gar_loan_account"/>
      <field name="domain_force">['|', ('factor_id.company_id','in',company_ids), ('merchant_id.company_id','in',company_ids)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_gar_account.group_ifs_gar_account_factor_user_ro')), Command.link(ref('ifs_gar_account.group_ifs_gar_account_merchant_user_ro'))]" />
    </record>

    <record id="multi_company_ifs_gar_account_supplier_merchant" model="ir.rule">
      <field name="name">供应方和采购方只能看到与自己有关子贷款账户的记录</field>
      <field name="model_id" ref="ifs_gar_account.model_ifs_gar_sub_loan_account"/>
      <field name="domain_force">['|', '|', ('loan_account_id.factor_id.company_id','in',company_ids), ('supplier_id.company_id','in',company_ids), 
        ('merchant_id.company_id','in',company_ids)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_gar_account.group_ifs_gar_account_factor_user_ro')), Command.link(ref('ifs_gar_account.group_ifs_gar_account_supplier_user_ro')), 
        Command.link(ref('ifs_gar_account.group_ifs_gar_account_merchant_user_ro'))]" />
    </record>

    <record id="multi_company_ifs_gar_upgrade_quota_apply" model="ir.rule">
      <field name="name">供应方和采购方只能看到与自己有关的提额申请记录</field>
      <field name="model_id" ref="ifs_gar_account.model_ifs_gar_upgrade_quota_apply"/>
      <field name="domain_force">['|', '|', ('factor_id.company_id','in',company_ids), ('supplier_id.company_id','in',company_ids), 
        ('merchant_id.company_id','in',company_ids)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_gar_account.group_ifs_gar_account_factor_user_ro')), Command.link(ref('ifs_gar_account.group_ifs_gar_account_supplier_user_ro')), 
        Command.link(ref('ifs_gar_account.group_ifs_gar_account_merchant_user_ro'))]" />
    </record>
  </data>
</odoo>