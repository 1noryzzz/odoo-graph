<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--保理方权限-->
  <record id="group_ifs_gar_account_factor_user_ro" model="res.groups">
    <field name="name">贷款账户：只读</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_factor"/>
    <field name="implied_ids" eval="[Command.set([ref('ifs_partner.group_ifs_partner_factor_user')])]"/>
    <field name="comment">普惠金融场景下，可查看贷款账户的用户（保理方）</field>
  </record>
  <record id="group_ifs_gar_account_factor_user" model="res.groups">
    <field name="name">贷款账户：审核</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_factor"/>
    <field name="implied_ids" eval="[Command.set([ref('ifs_partner.group_ifs_partner_factor_manager'), ref('group_ifs_gar_account_factor_user_ro')])]"/>
    <field name="comment">普惠金融场景下，可审核贷款账户的用户（保理方）</field>
  </record>
  <record id="group_ifs_gar_account_factor_manager" model="res.groups">
    <field name="name">贷款账户：管理员</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_factor"/>
    <field name="implied_ids" eval="[Command.link(ref('ifs_partner.group_ifs_partner_factor_manager')), Command.link(ref('group_ifs_gar_account_factor_user'))]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">普惠金融场景下，可维护贷款账户的用户（保理方）</field>
  </record>

  <!--采购方权限-->
  <record id="group_ifs_gar_account_merchant_user_ro" model="res.groups">
    <field name="name">贷款账户：只读</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_merchant"/>
    <field name="implied_ids" eval="[Command.set([ref('ifs_partner.group_ifs_partner_merchant_user')])]"/>
    <field name="comment">普惠金融场景下，可查看贷款账户的用户（采购方）</field>
  </record>
  <record id="group_ifs_gar_account_merchant_user" model="res.groups">
    <field name="name">贷款账户: 使用额度</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_merchant"/>
    <field name="implied_ids" eval="[Command.set([ref('ifs_partner.group_ifs_partner_merchant_manager'), ref('group_ifs_gar_account_merchant_user_ro')])]"/>
    <field name="comment">普惠金融场景下，可使用贷款账户的用户（采购方）</field>
  </record>
  <record id="group_ifs_gar_account_merchant_user_apply" model="res.groups">
    <field name="name">贷款账户：申请</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_merchant"/>
    <field name="implied_ids" eval="[Command.set([ref('ifs_partner.group_ifs_partner_merchant_manager'), ref('group_ifs_gar_account_merchant_user')])]"/>
    <field name="comment">普惠金融场景下，可申请贷款账户的用户（采购方）</field>
  </record>

  <!--供应方权限-->
  <record id="group_ifs_gar_account_supplier_user_ro" model="res.groups">
    <field name="name">贷款账户：只读</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_supplier"/>
    <field name="implied_ids" eval="[Command.set([ref('ifs_partner.group_ifs_partner_supplier_user')])]"/>
    <field name="comment">普惠金融场景下，可查看贷款账户的用户（供应方）</field>
  </record>
  <record id="group_ifs_gar_account_supplier_user" model="res.groups">
    <field name="name">贷款账户：审批</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_supplier"/>
    <field name="implied_ids" eval="[Command.set([ref('ifs_partner.group_ifs_partner_supplier_manager'), ref('group_ifs_gar_account_supplier_user_ro')])]"/>
    <field name="comment">普惠金融场景下，可审核贷款账户的用户（供应方）</field>
  </record>
  <record id="group_ifs_gar_account_supplier_manager" model="res.groups">
    <field name="name">贷款账户：管理员</field>
    <field name="category_id" ref="ifs_partner.module_category_ifs_partner_supplier"/>
    <field name="implied_ids" eval="[Command.link(ref('ifs_partner.group_ifs_partner_supplier_manager')), Command.link(ref('group_ifs_gar_account_supplier_user'))]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">普惠金融场景下，可维护贷款账户的用户（供应方）</field>
  </record>

  <data noupdate="0">
    <record id="ifs_partner.group_ifs_partner_factor_system" model="res.groups">
      <field name="implied_ids" eval="[Command.link(ref('group_ifs_gar_account_factor_manager'))]"/>
    </record>
    <record id="ifs_partner.group_ifs_partner_merchant_system" model="res.groups">
      <field name="implied_ids" eval="[Command.link(ref('group_ifs_gar_account_merchant_user_apply'))]"/>
    </record>
    <record id="ifs_partner.group_ifs_partner_supplier_system" model="res.groups">
      <field name="implied_ids" eval="[Command.link(ref('group_ifs_gar_account_supplier_manager'))]"/>
    </record>
  </data>

</odoo>