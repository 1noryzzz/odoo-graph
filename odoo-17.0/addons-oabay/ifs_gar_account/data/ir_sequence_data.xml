<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="seq_ifs_gar_loan_account" model="ir.sequence">
      <field name="name">贷款账户编号</field>
      <field name="code">ifs.gar.loan.account</field>
      <field name="prefix">LA%(year)s%(month)s%(day)s%(h24)s%(min)s%(sec)s</field>
      <field name="padding">3</field>
      <field name="company_id" eval="False"/>
    </record>

    <record id="seq_ifs_gar_loan_account_bill_log" model="ir.sequence">
      <field name="name">贷款动支还款流水</field>
      <field name="code">ifs.gar.loan.account.bill.log</field>
      <field name="prefix">%(year)s%(month)s%(day)s%(h24)s%(min)s%(sec)s</field>
      <field name="padding">3</field>
      <field name="company_id" eval="False"/>
    </record>

    <record id="seq_ifs_gar_partner_interest_solution" model="ir.sequence">
      <field name="name">计息方案编号</field>
      <field name="code">ifs.gar.partner.interest.solution</field>
      <field name="prefix">IS%(year)s%(month)s%(day)s%(h24)s%(min)s%(sec)s</field>
      <field name="padding">3</field>
      <field name="company_id" eval="False"/>
    </record>

    <record id="seq_ifs_gar_partner_fee_solution" model="ir.sequence">
      <field name="name">收费方案编号</field>
      <field name="code">ifs.gar.partner.fee.solution</field>
      <field name="prefix">SF%(year)s%(month)s%(day)s%(h24)s%(min)s%(sec)s</field>
      <field name="padding">3</field>
      <field name="company_id" eval="False"/>
    </record>

    <record id="seq_ifs_gar_upgrade_quota_apply" model="ir.sequence">
      <field name="name">调额申请编号</field>
      <field name="code">ifs.gar.upgrade.quota.apply</field>
      <field name="prefix">UQ%(year)s%(month)s%(day)s%(h24)s%(min)s%(sec)s</field>
      <field name="padding">3</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>