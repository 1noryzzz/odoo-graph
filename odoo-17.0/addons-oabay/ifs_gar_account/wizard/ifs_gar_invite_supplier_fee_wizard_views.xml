<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_invite_supplier_fee_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.invite.supplier.fee.wizard.view.form</field>
    <field name="model">ifs.gar.invite.supplier.fee.wizard</field>
    <field name="inherit_id" ref="ifs_base.ifs_steps_wizard_view_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <header position="before">
        <field name="logo" widget="image" class="oe_avatar" invisible="current_step == 1"/>
      </header>
      <xpath expr="//div[hasclass('o_galaxy_steps')]" position="inside">
        <button string="公司名称" step="1" current_step="current_step" class="o_galaxy_step"/>
        <button string="确认信息" step="2" current_step="current_step" class="o_galaxy_step"/>
        <button string="收费方式" step="3" current_step="current_step" class="o_galaxy_step"/>
        <button string="联系人" step="4" current_step="current_step" class="o_galaxy_step"/>
      </xpath>
      <sheet position="inside">
        <field name="ifs_company_id" invisible="1"/>
        <group col="2">
          <group>
            <field name="cut_off_time" widget="float_time"></field>
          </group>
          <group>
            <field name="fee_solution_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"></field>
          </group>
          <group colspan="2">
            <field name="description" invisible="not fee_solution_id"></field>
          </group>
          <group colspan="2">
            <field name="contract_content" invisible="not fee_solution_id"></field>
          </group>
        </group>
      </sheet>
      <button special="cancel" position="replace">
        <button name="action_confirm" type="object" string="确认" class="btn-primary" data-hotkey="c"/>
        <button string="稍后再填" class="btn-default" special="cancel"/>
      </button>
    </field>
  </record>
</odoo>