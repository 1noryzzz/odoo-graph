<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_gar_partner_fee_rule_view_form_inherited" model="ir.ui.view">
    <field name="name">ifs.gar.partner.fee.rule.view.form.inherited</field>
    <field name="model">ifs.gar.partner.fee.rule</field>
    <field name="inherit_id" ref="ifs_gar_account.ifs_gar_partner_fee_rule_view_form"/>
    <field name="arch" type="xml">
      <field name="fee_mode" position="after">
        <field name="fee_model_name" invisible="1"/>
        <field name="fee" invisible="fee_model_name != 'ifs.gar.partner.fee.mode.each'" />
        <field name="rate" invisible="fee_model_name != 'ifs.gar.partner.fee.mode.amount'" />
      </field>
    </field>
  </record>

  <record id="ifs_gar_partner_fee_mode_amount_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.partner.fee.mode.amount.view.form</field>
    <field name="model">ifs.gar.partner.fee.mode.amount</field>
    <field name="arch" type="xml">
      <form class="o_galaxy_form_view">
        <sheet>
          <group string="计费方式设置" name="gp_amount" col="1">
            <group>
              <field name="name"/>
              <field name="description"/>
              <field name="rate"/>
              <field name="formula" invisible="rate" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="ifs_gar_partner_fee_mode_each_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.partner.fee.mode.each.view.form</field>
    <field name="model">ifs.gar.partner.fee.mode.each</field>
    <field name="arch" type="xml">
      <form class="o_galaxy_form_view">
        <sheet>
          <group string="计费方式设置" name="gp_amount" col="1">
            <group>
              <field name="name"/>
              <field name="description"/>
              <field name="fee"/>
              <field name="formula" invisible="fee" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

</odoo>