<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_loan_account_bill_view_search" model="ir.ui.view">
    <field name="name">ifs.gar.loan.account.bill.view.search</field>
    <field name="model">ifs.gar.loan.account.bill</field>
    <field name="arch" type="xml">
      <search>
        <field name="code" string="账单编号"/>
        <field name="merchant_id"/>
        <field name="supplier_id"/>
        <field name="sub_loan_account_id"/>
        <field name="currency_id" groups="base.group_multi_currency"/>
        <searchpanel>
          <field name="state" icon="fa-folder-open" enable_counters="1"/>
        </searchpanel>
        <separator/>
        <filter name="state_current" string="未出账单" domain="[('state', '=', 'current')]" />
        <filter name="state_pending" string="待还账单" domain="[('state', '=', 'pending')]" />
        <filter name="state_overdue" string="逾期" domain="[('state', '=', 'overdue')]" />
        <filter name="state_paid" string="已还账单" domain="[('state', '=', 'paid')]" />
        <filter name="state_plan" string="已分期" domain="[('state', '=', 'plan')]" />
        <filter name="state_settle" string="结清账单" domain="[('state', '=', 'settle')]" />
        <group>
          <filter name="group_state" context="{'group_by': 'state'}" />
          <filter name="group_merchant_id" context="{'group_by': 'merchant_id'}" />
          <filter name="group_supplier_id" context="{'group_by': 'supplier_id'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="ifs_gar_loan_account_bill_view_tree" model="ir.ui.view">
    <field name="name">ifs.gar.loan.account.bill.view.tree</field>
    <field name="model">ifs.gar.loan.account.bill</field>
    <field name="arch" type="xml">
      <tree sample="1" expand="1" create="0"
        decoration-muted="state in ['paid', 'settle']"
        decoration-danger="state == 'overdue'"
        decoration-warning="state == 'pending'">
        <field name="currency_id" column_invisible="1"/>
        <field name="code" string="账单编号"/>
        <field name="sub_loan_account_id" string="子账户" optional="hide"/>
        <field name="merchant_id"/>
        <field name="supplier_id" optional="hide"/>
        <field name="bill_date" string="账单日"/>
        <field name="repayment_date" string="还款日"/>
        <field name="bill_amount" string="账单金额" sum="总账单金额"/>
        <field name="loan_amount" string="贷款金额" optional="show"/>
        <field name="pending_interest" optional="show"/>
        <field name="pending_damages" optional="show"/>
        <field name="pending_amount" optional="show"/>
        <field name="state" string="状态" widget="badge"
          decoration-info="state == 'current'"
          decoration-warning="state == 'pending'"
          decoration-danger="state == 'overdue'"
          decoration-success="state in ['paid', 'settle']"
          decoration-muted="state == 'plan'"/>
      </tree>
    </field>
  </record>

  <record id="ifs_gar_loan_account_bill_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.loan.account.bill.view.form</field>
    <field name="model">ifs.gar.loan.account.bill</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" class="o_galaxy_form_view">
        <field name="id" invisible="1"/>
        <field name="currency_id" invisible="1"/>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="current,pending,overdue,paid,plan,settle"/>
        </header>
        <sheet>
          <notebook>
            <page name="bill_info" string="账单信息">
              <group string="基础信息" class="o_group_label_lg">
                <group>
                  <field name="code" string="账单编号"/>
                  <field name="sub_loan_account_id" options="{'no_open': True}"/>
                  <field name="merchant_id"/>
                  <field name="bill_amount" invisible="state == 'current'"/>
                  <field name="pending_interest" invisible="state == 'current'"/>
                  <field name="fee" invisible="state == 'current'"/>
                  <field name="used_quota" invisible="state != 'current'"/>
                </group>
                <group>
                  <field name="bill_date"/>
                  <field name="repayment_date"/>
                  <field name="supplier_id"/>
                  <field name="pending_damages" invisible="state == 'current'"/>
                  <field name="pending_amount" invisible="state == 'current'"/>
                  <field name="repayment_amount" invisible="state == 'current'"/>
                  <field name="freeze_quota" invisible="state != 'current'"/>
                </group>
              </group>
              <group string="动账明细" name="fields_bill_log_ids" class="o_group_label_lg">
                <group colspan="2">
                  <field name="bill_log_ids" nolabel="1" mode="tree" colspan="2">
                    <tree create="0" edit="0" delete="0">
                      <field name="seq_code" string="流水号"/>
                      <field name="operate_type" string="操作类型"/>
                      <field name="amount" string="发生金额"/>
                      <field name="bill_log_date" string="记账日期"/>
                      <field name="remark" string="备注"/>
                      <field name="order_id" string="关联单据" optional="hide"/>
                      <field name="currency_id" column_invisible="1"/>
                    </tree>
                  </field>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="ifs_gar_loan_account_bill_act_window" model="ir.actions.act_window">
    <field name="name">账单列表</field>
    <field name="res_model">ifs.gar.loan.account.bill</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_group_state': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        未查询到账单
      </p>
      <p>
        <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
      </p>
    </field>
  </record>
</odoo>
