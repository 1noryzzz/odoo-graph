<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_upgrade_quota_apply_view_search" model="ir.ui.view">
    <field name="name">ifs.gar.upgrade.quota.apply.view.search</field>
    <field name="model">ifs.gar.upgrade.quota.apply</field>
    <field name="arch" type="xml">
      <search string="查询额度申请">
        <field name="name" filter_domain="['|', '|', '|', ('name', 'ilike', self), ('company_code', 'ilike', self), ('vat', 'ilike', self), ('abbr', 'ilike', self)]"/>
        <field name="company_registry" string="统一社会信用代码"/>
        <field name="legal_name"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="apply_quota"/>
        <searchpanel>
          <field name="state" icon="fa-folder-open" enable_counters="1"/>
        </searchpanel>
        <separator/>
        <filter name="filter_process" string="待处理" domain="[('state', 'in', ['committed', 'approve'])]"/>
        <filter name="filter_rejected" string="待处理" domain="[('state', '=', 'rejected')]"/>
        <filter name="filter_approval" string="审批完成" domain="[('state', '=', 'approval')]"/>
        <group expand="1" string="Group By">
          <filter name="group_state" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="ifs_gar_upgrade_quota_apply_view_tree" model="ir.ui.view">
    <field name="name">ifs.gar.upgrade.quota.apply.view.tree</field>
    <field name="model">ifs.gar.upgrade.quota.apply</field>
    <field name="arch" type="xml">
      <tree string="额度申请列表" sample="1" expand="1"
        decoration-muted="state in ['rejected', 'approval']"
        decoration-primary="state in ['committed', 'approve']">
        <field name="company_code" optional="hide"/>
        <field name="name"/>
        <field name="company_registry" string="统一社会信用代码"/>
        <field name="principal_name" optional="hide"/>
        <field name="legal_name"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="origin_quota" sum="原额度合计"/>
        <field name="apply_quota" sum="申请调整额度合计"/>
        <field name="state" string="状态" widget="badge" 
          decoration-info="state == 'draft'" 
          decoration-primary="state in ['committed', 'approve']" 
          decoration-success="state == 'approval'"
          decoration-danger="state == 'rejected'"/>
      </tree>
    </field>
  </record>

  <record id="ifs_gar_upgrade_quota_apply_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.upgrade.quota.apply.view.form</field>
    <field name="model">ifs.gar.upgrade.quota.apply</field>
    <field name="arch" type="xml">
      <form class="o_galaxy_form_view" create="0" options="{'edit': [('state', '=', 'draft')]}">
        <field name="definition_id" invisible="1"/>
        <field name="company_id" invisible="1"/>
        <field name="ifs_company_id" invisible="1"/>
        <field name="sub_loan_account_id" invisible="1"/>
        <field name="currency_id" invisible="1"/>
        <field name="factor_can_confirm" invisible="1"/>
        <field name="supplier_can_confirm" invisible="1"/>
        <field name="merchant_can_confirm" invisible="1"/>
        <header>
          <button name="action_supplier_confirm" type="object" string="确认" 
            class="btn-primary" groups="ifs_gar_account.group_ifs_gar_account_supplier_manager" invisible="not supplier_can_confirm"/>
          <button name="action_supplier_refuse" type="object" string="取消"
            class="btn-primary" groups="ifs_gar_account.group_ifs_gar_account_supplier_manager" invisible="not supplier_can_confirm"/>
          <button name="action_factor_confirm" type="object" string="确认" 
            class="btn-primary" groups="ifs_gar_account.group_ifs_gar_account_factor_manager" invisible="not factor_can_confirm"/>
          <button name="action_factor_refuse" type="object" string="取消"
            class="btn-primary" groups="ifs_gar_account.group_ifs_gar_account_factor_manager" invisible="not factor_can_confirm"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,committed,approve,approval" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box"></div>
          <div class="oe_title">
            <field name="logo" widget='image' class="oe_avatar" readonly="1"/>
            <span>采购方编号：          <field name="merchant_code" class="oe_inline" />
            </span>
            <span>贷款账户编号：          <field name="account_code" class="oe_inline" />
            </span>
            <h1>
              <field name="name" default_focus="1" placeholder="名称" readonly="1"/>
            </h1>
          </div>
          <notebook>
            <page string="额度申请信息" name="quota_apply_info" autofocus="autofocus">
              <group string="申请信息" class="gp_info">
                <group colspan="2">
                  <field name="origin_quota"/>
                  <field name="apply_quota"/>
                  <field name="apply_reason"/>
                  <field name="apply_basis"/>
                </group>
              </group>
            </page>
            <page string="企业信息" name="company_info" groups="ifs_gar_account.group_ifs_gar_account_factor_user,ifs_gar_account.group_ifs_gar_account_supplier_user">
              <group class="gp_base o_group_label_lg" string="工商登记信息">
                <group/>
                <field name="json_datas" widget="dynamic_properties" nolabel="1" columns="2"/>
                <group colspan="2" class="gp_key_persons" string="主要人员"/>
                <field name="key_person_ids" nolabel="1" mode="kanban" class="o_galaxy_properties" readonly="1">
                  <kanban class="o_galaxy_kanban_properties">
                    <field name="definition_id"/>
                    <field name="json_datas"/>
                    <templates>
                      <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card">
                          <field name="json_datas" widget="dynamic_properties" columns="3"/>
                        </div>
                      </t>
                    </templates>
                  </kanban>
                </field>
              </group>
              
              <group class="gp_bussiness o_group_label_lg" string="企业经营信息">
                <group>
                  <field name="business_address" readonly="1"/>
                  <field name="phone" readonly="1"/>
                </group>
                <group>
                  <field name="business_date"/>
                  <field name="email" readonly="1"/>
                </group>
              </group>

              <group class="gp_docs o_group_label_lg" string="企业证件信息" name="gp_docs">
                <group colspan="2" class="o_ifs_flex_container">
                  <div class="o_ifs_center_img">
                    <div class="o_ifs_img">
                      <field name="business_license" widget="image" readonly="1" nolabel="1"/>
                      <div class="o_ifs_img_text">营业执照</div>
                    </div>
                  </div>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
        <footer>
          <button string="提交申请" class="btn-primary" name="action_commit" type="object" invisible="not merchant_can_confirm or state != 'draft'"/>
          <button string="暂存" class="btn-secondary" special="save" invisible="state != 'draft'"/>
          <button string="关闭" class="btn-secondary" special="cancel" data-hotkey="z"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="ifs_gar_upgrade_quota_apply_act_window" model="ir.actions.act_window">
    <field name="name">额度调整审批</field>
    <field name="res_model">ifs.gar.upgrade.quota.apply</field>
    <field name="view_mode">tree,form</field>
    <field name="target">current</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
         暂时还没有采购方提出额度调整申请。
      </p>
      <p>
        <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
      </p>
    </field>
     <field name="context">{ 'search_default_group_state': True }</field>
  </record>
</odoo>