<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- 当前公司信息界面 -->
  <record id="ifs_base_company_view_form_my_inherited" model="ir.ui.view">
    <field name="name">ifs.base.company.view.form.my.inherited</field>
    <field name="model">ifs.base.company</field>
    <field name="inherit_id" ref="ifs_partner.ifs_base_company_view_form_my"/>
    <field name="arch" type="xml">
      <header position="inside">
        <button name="action_apply_upgrade_quota" type="object" string="申请调整授信额度" 
          class="btn-primary" groups="ifs_gar_account.group_ifs_gar_account_merchant_user_apply"/>
      </header>
      <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
        <field name="currency_id" invisible="1"/>
        <button class="oe_stat_button" icon="fa-credit-card" name="view_merchant_quota_info" type="object"
          groups="ifs_gar_account.group_ifs_gar_account_merchant_user_ro">
          <div class="o_form_field o_stat_info">
            <span class="o_stat_text">授信额度</span>
            <field name="merchant_approved_quota"/>
          </div>
        </button>
        <button class="oe_stat_button" icon="fa-cny" name="view_sub_loan_account_info" type="object"
          groups="ifs_gar_account.group_ifs_gar_account_merchant_user_ro">
          <div class="o_form_field o_stat_info">
            <span class="o_stat_text">可用额度</span>
            <field name="merchant_available_quota"/>
          </div>
        </button>
        <button class="oe_stat_button" icon="fa-credit-card" name="view_supplier_quota_info" type="object"
          groups="ifs_partner.group_ifs_partner_supplier_user">
          <div class="o_form_field o_stat_info">
            <span class="o_stat_text">合作额度</span>
            <field name="supplier_total_quota"/>
          </div>
        </button>
        <button class="oe_stat_button" icon="fa-cny" name="view_loan_account_info" type="object"
          groups="ifs_gar_account.group_ifs_gar_account_supplier_user_ro">
          <div class="o_form_field o_stat_info">
            <span class="o_stat_text">已批额度</span>
            <field name="supplier_approved_quota"/>
          </div>
        </button>
      </xpath>
    </field>
  </record>
</odoo>