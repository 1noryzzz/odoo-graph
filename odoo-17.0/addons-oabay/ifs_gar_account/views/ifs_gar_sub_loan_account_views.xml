  <record id="ifs_gar_sub_loan_account_act_window" model="ir.actions.act_window">
    <field name="name">贷款账户</field>
    <field name="res_model">ifs.gar.sub.loan.account</field>
    <field name="view_mode">tree,form</field>
    <field name="target">current</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
         暂时还没有记录，请点击左上角“创建”
