<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_gar_sub_loan_account_view_search" model="ir.ui.view">
    <field name="name">ifs.gar.sub.loan.account.view.search</field>
    <field name="model">ifs.gar.sub.loan.account</field>
    <field name="arch" type="xml">
      <search string="贷款账户查询">
        <field name="merchant_code" />
        <field name="merchant_name" />
        <field name="supplier_code" />
        <field name="supplier_name" />
        <field name="approved_quota" />
        <field name="freeze_quota"/>
        <field name="used_quota"/>
        <field name="available_quota"/>
      </search>
    </field>
  </record>

  <record id="ifs_gar_sub_loan_account_view_tree" model="ir.ui.view">
    <field name="name">ifs.gar.sub.loan.account.view.tree</field>
    <field name="model">ifs.gar.sub.loan.account</field>
    <field name="arch" type="xml">
      <tree string="贷款账户列表" sample="1" create="0">
        <field name="currency_id" column_invisible="1"/>
        <field name="seq_code"/>
        <field name="merchant_code" optional="show" />
        <field name="merchant_name" />
        <field name="supplier_code" optional="hide" />
        <field name="supplier_name" optional="hide" />
        <field name="approved_quota" sum="总授信额度"/>
        <field name="credit_term" optional="show"/>
        <field name="repay_day" optional="show"/>
        <field name="freeze_quota" sum="总冻结额度" optional="hide"/>
        <field name="used_quota" sum="总已用额度"/>
        <field name="available_quota" sum="总可用额度"/>
        <field name="state"/>
      </tree>
    </field>
  </record>

  <record id="ifs_gar_sub_loan_account_view_selector" model="ir.ui.view">
    <field name="name">ifs.gar.sub.loan.account.view.tree.selector</field>
    <field name="model">ifs.gar.sub.loan.account</field>
    <field name="inherit_id" ref="ifs_gar_account.ifs_gar_sub_loan_account_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree position="attributes">
        <attribute name="js_class">sub_account_selector</attribute>
      </tree>
      <field name="merchant_code" position="replace"/>
      <field name="merchant_name" position="replace"/>
      <field name="state" position="replace">
        <button name="apply_quota" type="object" string="申请调额" class="btn btn-primary"/>
      </field>
    </field>
  </record>

