<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_partner_merchant_view_search_inherited" model="ir.ui.view">
    <field name="name">ifs.partner.merchant.view.search.inherited</field>
    <field name="model">ifs.partner.merchant</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_merchant_view_search" />
    <field name="arch" type="xml">
      <field name="seq_code" position="after">
        <field name="approved_quota"/>
        <field name="available_quota"/>
        <field name="used_quota"/>
      </field>
    </field>
  </record>

  <record id="ifs_partner_merchant_view_tree_inherited" model="ir.ui.view">
    <field name="name">ifs.partner.merchant.view.tree.inherited</field>
    <field name="model">ifs.partner.merchant</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_merchant_view_tree"/>
    <field name="arch" type="xml">
      <field name="state" position="before">
        <field name="currency_id" column_invisible="1"/>
        <field name="approved_quota" sum="合计授信"/>
        <field name="available_quota" sum="可用额度合计" 
          decoration-success="available_quota &gt; 100000"/>
        <field name="used_quota" sum="已用合计"
          decoration-danger="used_quota == 0"/>
      </field>
    </field>
  </record>

  <record id="ifs_partner_merchant_view_form_inherited" model="ir.ui.view">
    <field name="name">ifs.partner.merchant.view.form.inherited</field>
    <field name="model">ifs.partner.merchant</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_merchant_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
        <field name="currency_id" invisible="1"/>
        <button class="oe_stat_button" icon="fa-credit-card" name="view_quota_info" type="object">
          <div class="o_form_field o_stat_info">
            <span class="o_stat_text">授信额度</span>
            <field name="approved_quota"/>
          </div>
        </button>
        <button class="oe_stat_button" icon="fa-cny" name="view_sub_loan_account_info" type="object">
          <div class="o_form_field o_stat_info">
            <span class="o_stat_text">可用额度</span>
            <field name="available_quota"/>
          </div>
        </button>
      </xpath>
    </field>
  </record>

</odoo>