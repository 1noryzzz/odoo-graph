  <record id="ifs_partner_supplier_view_search_inherited" model="ir.ui.view">
    <field name="name">ifs.partner.supplier.view.search.inherited</field>
    <field name="model">ifs.partner.supplier</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_supplier_view_search" />
    <field name="arch" type="xml">
      <field name="email" position="after">
        <field name="total_quota" groups="ifs_partner.group_ifs_partner_factor_manager"/>
        <field name="approved_quota" groups="ifs_partner.group_ifs_partner_factor_manager"/>
      </field>
    </field>
  </record>

  <record id="ifs_partner_supplier_view_tree_inherited" model="ir.ui.view">
    <field name="name">ifs.partner.supplier.view.tree.inherited</field>
    <field name="model">ifs.partner.supplier</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_supplier_view_tree"/>
    <field name="arch" type="xml">
      <field name="state" position="before">
        <field name="currency_id" column_invisible="1"/>
        <field name="total_quota" sum="总合作额度" groups="ifs_partner.group_ifs_partner_factor_manager"/>
        <field name="approved_quota" sum="总已批额度" decoration-danger="total_quota &lt; approved_quota + 1000000" groups="ifs_partner.group_ifs_partner_factor_manager"/>
      </field>
    </field>
  </record>

  <record id="ifs_partner_supplier_view_form_inherited" model="ir.ui.view">
    <field name="name">ifs.partner.supplier.view.form.inherited</field>
    <field name="model">ifs.partner.supplier</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_supplier_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
        <field name="currency_id" invisible="1"/>
        <button class="oe_stat_button" icon="fa-credit-card" name="view_quota_info" type="object" groups="ifs_partner.group_ifs_partner_factor_manager">
          <div class="o_form_field o_stat_info">
            <span class="o_stat_text">合作额度</span>
            <field name="total_quota"/>
          </div>
        </button>
        <button class="oe_stat_button" icon="fa-cny" name="view_loan_account_info" type="object" groups="ifs_partner.group_ifs_partner_factor_manager">
          <div class="o_form_field o_stat_info">
            <span class="o_stat_text">已批额度</span>
            <field name="approved_quota"/>
          </div>
        </button>
      </xpath>
    </field>
  </record>

</odoo>