<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="brand_promotion" inherit_id="web.brand_promotion" name="Brand Promotion">
    <xpath expr="//t[@t-call='web.brand_promotion_message']" position="replace">
      <t t-call="galaxy_common.brand_promotion_message">
        <t t-set="_message">
          <a href="https://www.lifewiz.cn" target="new">云腾智慧</a>提供技术支持
        </t>
        <t t-set="_utm_medium" t-valuef=""/>
      </t>
    </xpath>
  </template>
</odoo>