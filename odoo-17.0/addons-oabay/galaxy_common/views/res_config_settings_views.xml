<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.galaxy.common</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@name='integration']" position="after">
        <block title="阿里云服务" name="galaxy_aliyun">
          <setting name="galaxy_aliyun" string="阿里云服务" help="是否使用阿里云服务">
            <field name="module_galaxy_aliyun"/>
          </setting>
        </block>
      </xpath>
    </field>
  </record>

  <record id="res_config_settings_view_form_website" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.website</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website.res_config_settings_view_form"/>
    <field name="arch" type="xml">

      <xpath expr="//field[@name='website_domain']/parent::div" position="after">
        <div class="row mt8">
          <label class="col-lg-3" string="数据库配置" for="db_list"/>
          <field name="db_list" title="选择此域名对应的数据库"/>
        </div>
        <div class="row mt8">
          <label class="col-lg-3" string="默认数据库" for="set_default_db"/>
          <field name="set_default_db"/>
        </div>

      </xpath>

      <xpath expr="//field[@name='favicon']/parent::div" position="after">
        <div class="row mt8">
          <label class="col-lg-3" string="Logo" for="website_logo"/>
          <field name="website_logo" widget="image" class="float-start oe_avatar bg-view"/>
        </div>

      </xpath>

    </field>
  </record>
</odoo>