<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="qr_login_provider_form_view" model="ir.ui.view">
      <field name="name">qr.login.provider.form</field>
      <field name="model">qr.login.provider</field>
      <field name="arch" type="xml">
        <form string="QrCode Login Provider" class="o_qr_login_form">
          <field name="id" invisible="1"/>
          <sheet>
            <div class="oe_title" style="width: 100%;">
              <h1>
                <field name="name" default_focus="1" placeholder="Offiaccount name"/>
              </h1>
            </div>
            <group>
              <group>
                <field name="app_id" />
                <field name="secret" class="oe_edit_only" />
                <field name="website_id" />
                <field name="redirect_uri" />
                <field name="scope" />
                <field name="enabled" />
                <field name="css_class" />
                <field name="body" />
                <field name="sequence" />
              </group>
            </group>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers"/>
            <field name="activity_ids" widget="mail_activity"/>
            <field name="message_ids" widget="mail_thread"/>
          </div>
        </form>
      </field>
    </record>
  </data>
</odoo>