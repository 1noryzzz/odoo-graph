<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record model="ir.ui.view" id="sms_template_preview_form">
    <field name="name">sms.template.preview.form.inherited</field>
    <field name="model">sms.template.preview</field>
    <field name="priority" eval="88"/>
    <field name="inherit_id" ref="sms.sms_template_preview_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='body']" position="after">
        <hr/>
        <label for="template_body" string="短信模板"/>
        <hr/>
        <field name="template_body">短信内容</field>
        <hr/>
        <label for="template_param" string="短信参数"/>
        <hr/>
        <field name="template_param">短信参数</field>
      </xpath>

    </field>
  </record>

</odoo>