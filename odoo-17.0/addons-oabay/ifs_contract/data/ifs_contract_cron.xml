<?xml version="1.0" ?>
<odoo>
  <data noupdate="1">
    <record id="ifs_contract_cron" model="ir.cron">
      <field name="name">云腾智慧合同：计算合同到期时间定时任务</field>
      <field name="model_id" ref="ifs_contract.model_ifs_contract_info"/>
      <field name="state">code</field>
      <field name="code">
contracts = model.search([('state', '=', 'signed')])
if contracts.exists():
  contracts._task_compute_contract_state()
      </field>
      <field name="user_id" ref="ifs_contract.ifs_contract_contract_state_user_id"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
    </record>

    <record id="commit_user_sign_cron" model="ir.cron">
      <field name="name">云腾智慧合同：提交用户已签的合同</field>
      <field name="model_id" ref="ifs_contract.model_ifs_contract_info"/>
      <field name="state">code</field>
      <field name="code">model.commit_user_sign_contract()</field>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
    </record>
  </data>
</odoo>
