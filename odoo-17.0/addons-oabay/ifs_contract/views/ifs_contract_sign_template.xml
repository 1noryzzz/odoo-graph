<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="contract_sign_before" name="签名注意事项" inherit_id="portal.portal_sidebar" primary="True">
    <xpath expr="//t[@t-call='portal.portal_layout']" position="attributes">
      <attribute name="t-call">galaxy_tdesign.portal_layout</attribute>
    </xpath>
    <xpath expr="//div" position="replace">
      <t t-set="no_breadcrumbs" t-value="1"/>
      <div class="sign_before_main">
        <div class="content_body top_content_body">
          <div class="top_content_item_title">合约签署</div>
          <div class="top-content">
            <t t-esc="sign_token.sign_company_name"/>
            <t t-esc="sign_token.sign_name"/>
 先生/女士</div>
        </div>

        <div class="content_body">
          <div class="icon-wrap">
            <img class="mark_img" src="/ifs_contract/static/img/icon_warning.png" />
					温馨提示
          </div>
          <div class="clause">
            <p>
						根据《中华人民共和国电子签名法》之相关规定，您在使用本系统需要您做核身认证及电子签名；
            </p>
            <p>
						所以我们需要您在接下来做以下签署流程并准备相应的资料；
            </p>
          </div>
        </div>

        <div class="content_body">
          <div>
					签署电子合同的目录
          </div>
          <div class="contract_item">
            <t t-foreach="contract_infos" t-as="contract">
              <div>
                <span>
                  <t t-esc="contract.name"/>
                </span>
                <a t-attf-href="/contract?contract_id={{ contract.id }}">查看</a>
              </div>
            </t>
          </div>
        </div>

        <div class="agree">
          <form class="form" action="/contract/faceid">
            <!-- <t t-call="ifs_contract.wechat_offiaccount_layout"> -->
              <div class="contract_button_container footer-btn-wrap">
                <input type="hidden" id="token" name="token" t-att-value="sign_token.token"/>
                <!-- <button class="agree_btn share-contract-btn" type="button">
                  <img class="btn-icon" src="/ifs_contract/static/img/icon_share.png" />
分享链接
                </button> -->
                <input style="font-weight: bold; appearance: none; -webkit-appearance: none;" class="agree_btn" type="submit" value="同意并继续"/>
              </div>
            <!-- </t> -->
          </form>
        </div>

        <div class="share_tip_display c-qr-mask">
          <!-- <img src="/ifs_contract/static/img/arrow.png" id="arrow_img" class="arrow_img"/>
          <div class="share_tip_text">点击屏幕右上角[...]            <br/>
用 发送给朋友 转发</div>
          <img src="/ifs_contract/static/img/share_method.png" id="share_img" class="share_img"/> -->
          <div class="qr-container">
            <img id="qrcodeImg" class="qr-img" src="" />
            <div class="label">使用微信扫一扫打开</div>
          </div>
          <div class="icon-close-container">
            <img class="close_img icon-close" src="/ifs_contract/static/img/close.png" />
          </div>
          <div class="toast"></div>
        </div>
      </div>
    </xpath>
  </template>

  <template id="contract_sign_template" name="合同手写签名" inherit_id="portal.portal_sidebar" primary="True">
    <xpath expr="//t[@t-call='portal.portal_layout']" position="attributes">
      <attribute name="t-call">ifs_gar_invite.portal_layout</attribute>
    </xpath>
    <xpath expr="//div" position="replace">
      <t t-set="no_breadcrumbs" t-value="1"/>
      <t t-call="galaxy_tdesign.signature_form">
        <t t-set="call_url" t-value="'/contract/signature?token='+sign_token.token"/>
        <t t-set="default_name" t-value="sign_token.sign_name"/>
        <t t-set="signature_ratio" t-value="0.75" />
      </t>
    </xpath>
  </template>

  <template id="contract_signed" name="签名完成" inherit_id="galaxy_tdesign.frontend_layout" primary="True">
    <xpath expr="//title" position="replace">
      <title>人脸验证</title>
    </xpath>
    <xpath expr="//body" position="replace">
      <div class="ar-main">
        <t t-if="next_url and next_url.strip()">
          <div class="tips-wrap">
            <img class="tips-icon" src="/ifs_contract/static/img/icon_right@2x.png"/>
            <div class="tips-text"><t t-esc="next_description"/></div>
          </div>
          <a class="btn btn-primary galaxy-btn-primary" t-att-href="next_url"><t t-esc="next_name"/></a>
        </t>
        <t t-else="">
          <div class="tips-wrap">
            <img class="tips-icon" src="/ifs_contract/static/img/icon_right@2x.png"/>
            <div class="tips-text">签名成功！您可以关闭此界面了</div>
          </div>
          <a class="btn btn-primary galaxy-btn-primary" t-att-href="contract_callback_url">关闭</a>
        </t>
      </div>
    </xpath>
  </template>

  <template id="contract_alert_msg" name="提示信息" inherit_id="galaxy_tdesign.frontend_layout" primary="True">
    <xpath expr="//title" position="replace">
      <title>提示信息</title>
    </xpath>
    <xpath expr="//body" position="replace">
      <div class="ar-main">
        <div class="tips-wrap">
          <img class="tips-icon" src="/ifs_contract/static/img/icon_warning@2x.png"/>
          <div class="tips-text" t-esc="alert_msg"></div>
        </div>
      </div>
    </xpath>
  </template>

  <template id="contract_details_check" name="合同详情" inherit_id="galaxy_tdesign.frontend_layout" primary="True">
    <xpath expr="//title" position="replace">
      <title><t t-esc="page_title"/></title>
      <meta content="width=device-width, initial-scale=1,maximum-scale=1,maximum-scale=1, user-scalable=no" name="viewport"/>
    </xpath>
    <xpath expr="//body" position="replace">
      <div class="details-main">
        <div class="contract_content">
          <t t-esc="report_content"/>
        </div>
        <div class="return_last_page">
          <img class="tips-icon" src="/ifs_contract/static/img/return.png"/>
          <a t-attf-href="/contract/sign?token={{sign_token}}">返回上一页</a>
        </div>
      </div>
    </xpath>
  </template>

  <template id="match_face_error_msg_page" name="人脸验证错误提示页" inherit_id="galaxy_tdesign.frontend_layout" primary="True">
    <xpath expr="//title" position="replace">
      <title>人脸验证</title>
    </xpath>
    <xpath expr="//body" position="replace">
      <div class="ar-main">
        <div class="tips-wrap">
          <img class="tips-icon" src="/ifs_contract/static/img/icon_warning@2x.png"/>
          <div class="tips-text" t-esc="alert_msg"></div>
        </div>
        <a class="btn btn-primary galaxy-btn-primary" t-attf-href="/contract/faceid?token={{sign_token}}">重新认证</a>
      </div>
      <!-- <div class="return_last_page">
        <img class="tips-icon" src="/ifs_contract/static/img/return.png"/>
        <a t-attf-href="/contract/sign?token={{sign_token}}">返回上一页</a>
      </div> -->
    </xpath>
  </template>

  <template id="wechat_offiaccount_layout" name="Wechat Inner Layout">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="true"/>
      <t t-set="no_footer" t-value="true"/>
      <t t-set="head">
        <t t-call-assets="wechat.assets_wechat_frontend" t-css="false" defer_load="True"/>
        <script type="text/javascript">
          window.addEventListener('load', function () {
            odoo.define('ifs_contract.offiaccount_entry', [], function (require) {
              wx.config({
                debug: false,
                appId: '<t t-esc="wx_config['app_id']"/>',
                timestamp: '<t t-esc="wx_config['timestamp']"/>',
                nonceStr: '<t t-esc="wx_config['nonceStr']"/>',
                signature: '<t t-esc="wx_config['signature']"/>',
                jsApiList: ['updateAppMessageShareData']
              });
              wx.ready(function () {   //需在用户可能点击分享按钮前就先调用
                wx.updateAppMessageShareData({ 
                  title: '合同签署',
                  desc: '鸥贝云，⽤数据构建诚信中国',
                  link: '<t t-esc="wx_config['url']"/>',
                  imgUrl: '<t t-esc="wx_config['domain']"/>' + '/ifs_contract/static/img/icon_sign.png?v=2',
                  success: function () {
                  }
                })
              });
            });
          });
        </script>
      </t>
      <t t-raw="0"/>
    </t>
  </template>
</odoo>