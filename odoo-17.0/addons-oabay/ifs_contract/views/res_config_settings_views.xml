<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.ifs.contract</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="100"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//setting[@name='ifs_external_api_setting_container']" position="after">
        <setting name="ifs_contract_setting_container" string="合同管理">
          <div class="text-muted">
            <field name="global_disable_faceid"/>
              全局禁用人脸核身
          </div>
          <div class="mt16">
            <label class="col-lg-3" for="face_secret_id"/>
            <field name="face_secret_id"/>
          </div>
          <div class="mt8">
            <label class="col-lg-3" for="face_secret_key"/>
            <field name="face_secret_key"/>
          </div>
          <div class="mt16">
            <label class="col-lg-3" for="face_app_id"/>
            <field name="face_app_id"/>
          </div>
          <div class="mt8">
            <label class="col-lg-3" for="face_app_secret"/>
            <field name="face_app_secret"/>
          </div>
        </setting>
      </xpath>
    </field>
  </record>
</odoo>
