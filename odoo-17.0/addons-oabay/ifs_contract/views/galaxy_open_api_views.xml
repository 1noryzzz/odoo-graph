<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="galaxy_open_api_app_view_form_inherited" model="ir.ui.view">
    <field name="name">galaxy.open.api.app.view.form.inherited</field>
    <field name="model">galaxy.open.api.app</field>
    <field name="inherit_id" ref="galaxy_open_api.galaxy_open_api_app_view_form" />
    <field name="arch" type="xml">
      <group name="message_handler" position="after">
        <group colspan="2">
          <label for="authorization_callback_url"/>
          <div class="oe_inline_container">
            <field name="authorization_callback_url" class="oe_inline oe_inline_full" />
          </div>
        </group>
        <group colspan="2">
          <label for="contract_callback_url"/>
          <div class="oe_inline_container">
            <field name="contract_callback_url" class="oe_inline oe_inline_full" />
          </div>
        </group>
        <group colspan="2">
          <label for="payment_callback_url_mini"/>
          <div class="oe_inline_container">
            <field name="payment_callback_url_mini" class="oe_inline oe_inline_full" />
          </div>
        </group>
        <group colspan="2">
          <label for="payment_callback_url_app"/>
          <div class="oe_inline_container">
            <field name="payment_callback_url_app" class="oe_inline oe_inline_full" />
          </div>
        </group>
      </group>
    </field>
  </record>

</odoo>