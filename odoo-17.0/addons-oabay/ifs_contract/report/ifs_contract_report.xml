<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="action_contract_general_report" model="ir.actions.report">
      <field name="name">普惠金融合同</field>
      <field name="model">ifs.contract.info</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">ifs_contract.print_contract</field>
      <field name="report_file">ifs_contract.print_contract</field>
      <field name="print_report_name">(object.name)</field>
      <field name="binding_model_id" ref="model_ifs_contract_info"/>
      <field name="binding_type">report</field>
    </record>
  </data>

  <template id="print_contract">
    <t t-call="web.basic_layout">
      <t t-raw="0"/>
      <t t-foreach="docs" t-as="line">
        <div class="page">
          <span t-field="line.report_content"/>
        </div>
      </t>
    </t>
  </template>
</odoo>