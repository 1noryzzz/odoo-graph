<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="group_ifs_contract_user" model="res.groups">
    <field name="name">合同管理：仅查看</field>
    <field name="category_id" ref="ifs_base.module_category_ifs_base"/>
    <field name="implied_ids" eval="[Command.set([ref('ifs_base.group_ifs_user')])]"/>
    <field name="comment">普惠金融场景下，可查看合同的用户</field>
  </record>
  
  <record id="group_ifs_contract_sign" model="res.groups">
    <field name="name">合同管理：签署</field>
    <field name="category_id" ref="ifs_base.module_category_ifs_base"/>
    <field name="implied_ids" eval="[Command.link(ref('group_ifs_contract_user'))]"/>
    <field name="comment">普惠金融场景下，可签署合同的用户</field>
  </record>

  <record id="group_ifs_contract_template_manager" model="res.groups">
    <field name="name">合同管理：模板管理</field>
    <field name="category_id" ref="ifs_base.module_category_ifs_base"/>
    <field name="implied_ids" eval="[Command.link(ref('group_ifs_contract_user')), Command.link(ref('ifs_base.group_ifs_manager'))]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">普惠金融场景下，维护合同模板的用户</field>
  </record>

</odoo>