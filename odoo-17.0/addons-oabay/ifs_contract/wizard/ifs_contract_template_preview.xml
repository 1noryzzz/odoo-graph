<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="contract_template_preview_view_form" model="ir.ui.view">
            <field name="name">contract.template.preview.view.form</field>
            <field name="model">ifs.contract.template.preview</field>
            <field name="arch" type="xml">
                <form string="contract Preview">
                    <h3><field name="contract_template_id" readonly="1" nolabel="1" options="{'no_open' : True}"/></h3>
                    <div class="alert alert-danger" role="alert" invisible="not error_msg">
                        <field name="error_msg" />
                    </div>
                    <field name="no_record" invisible="1"/>
                    <div class="container">
                        <div class="row">
                            <span class="col-md-5 col-lg-4 col-sm-12 pl-0">选择一个示例 <field name="model_id" readonly="1"/> 记录：</span>
                            <div class="col-md-7 col-lg-6 col-sm-12 pl-0">
                                <field name="resource_ref" readonly="False"
                                    options="{'hide_model': True, 'no_create': True, 'no_edit': True, 'no_open': True}"
                                    invisible="no_record"/>
                                <b invisible="not no_record" class="text-warning">No record for this model</b>
                            </div>
                        </div>
                        <div class="row">
                            <span class="col-md-5 col-lg-4 col-sm-12 pl-0">强制语言：</span>
                            <div class="col-md-7 col-lg-6 col-sm-12 pl-0">
                                <field name="lang"/>
                            </div>
                        </div>
                    </div>
                    <field name="body_html" widget="html" nolabel="1" options='{"safe": True}'/>
                   
                    <footer>
                        <button string="关闭" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="contract_template_preview_action" model="ir.actions.act_window">
            <field name="name">合同预览</field>
            <field name="res_model">ifs.contract.template.preview</field>
            <field name="binding_model_id" eval="False"/>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="contract_template_preview_view_form"/>
            <field name="target">new</field>
            <field name="context">{'default_contract_template_id':active_id}</field>
        </record>

    </data>
</odoo>
