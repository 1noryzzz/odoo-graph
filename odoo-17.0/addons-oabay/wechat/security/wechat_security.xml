<odoo>

  <!-- Default user for wechat message push service -->
  <record id="wechat_message_push_user_id" model="res.users">
    <field name="name">Wechat Message Push Service</field>
    <field name="login">wechat_msg_push</field>
    <field name="active" eval="False"/>
    <field name="lang">zh_CN</field>
    <field name="tz">Asia/Shanghai</field>
    <field name="is_company" eval="True"/>
    <field name="image_1920" type="base64" file="wechat/static/description/icon.png"/>
    <field name="groups_id" eval="[(6, 0, [ref('wechat.group_wechat_push')])]"/>
  </record>

  <record id="wechat_work_message_push_user_id" model="res.users">
    <field name="name">Wechat Work Message Push Service</field>
    <field name="login">wechat_work_msg_push</field>
    <field name="active" eval="False"/>
    <field name="lang">zh_CN</field>
    <field name="tz">Asia/Shanghai</field>
    <field name="is_company" eval="True"/>
    <field name="image_1920" type="base64" file="wechat/static/img/wework.jpg"/>
    <field name="groups_id" eval="[(6, 0, [ref('wechat.group_wechat_work_push')])]"/>
  </record>

  <record id="offiaccount_config_multi_company" model="ir.rule">
    <field name="name">Offiaccount Config Multi Company</field>
    <field name="model_id" ref="wechat.model_wechat_offiaccount_config"/>
    <field name="domain_force"> ['|', ('website_id.company_id', 'in', company_ids), ('website_id.company_id', '=', False)]</field>
    <field name="perm_read" eval="False" />
  </record>

  <record id="work_config_multi_company" model="ir.rule">
    <field name="name">Wechat Work Config Multi Company</field>
    <field name="model_id" ref="wechat.model_wechat_work_config"/>
    <field name="domain_force"> ['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
  </record>

  <record id="work_config_agent_multi_company" model="ir.rule">
    <field name="name">Wechat Work Agent Config Multi Company</field>
    <field name="model_id" ref="wechat.model_wechat_work_agent_config"/>
    <field name="domain_force"> ['|', ('work_id.company_id', 'in', company_ids), ('work_id.company_id', '=', False)]</field>
  </record>

</odoo>