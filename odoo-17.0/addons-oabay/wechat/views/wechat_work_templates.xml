<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="assets_work_frontend" name="Wechat Work Assets">
    <script type="text/javascript" src="https://res.wx.qq.com/open/js/jweixin-1.2.0.js"/>
    <script type="text/javascript" src="https://open.work.weixin.qq.com/wwopen/js/jwxwork-1.0.0.js"/>
    <script type="text/javascript" src="/wechat/static/src/js/wechat_work_base.js"/>
  </template>

  <template id="wechat_work_layout" name="Wechat Work Main Layout">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="true"/>
      <t t-set="no_footer" t-value="true"/>
      <t t-set="head">
        <t t-call-assets="wechat.assets_work_frontend" t-js="false"/>
        <t t-call-assets="wechat.assets_work_frontend" t-css="false" defer_load="True"/>
        <script type="text/javascript">
          window.addEventListener('load', function () {
            odoo.define('wechat.work_entry', function (require) {
              var rootWidget = require('root.widget');
              var work_base = require('wechat.work.base');
              
              var my_w_base = new work_base.WechatWorkBase(rootWidget, {}, <t t-esc="ww_js_options"/>);
              my_w_base.appendTo(document.body);
            });
          });
        </script>
      </t>
      <t t-raw="0"/>
    </t>
  </template>
  <template id="wechat_work_test" name="Wechat Work Test">
    <t t-call="wechat.wechat_work_layout">
      <div class="oe_website_login_container oe_login_form">Retrieve user info, Waiting....</div>
    </t>
  </template>
</odoo>