<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="wechat_menu_tree_view" model="ir.ui.view">
    <field name="name">wechat.menu.tree</field>
    <field name="model">wechat.menu</field>
    <field name="arch" type="xml">
      <tree string="menus" sample="1">
        <field name="name" />
        <field name="menu_item_ids" widget="many2many_tags" />
      </tree>
    </field>
  </record>

  <record id="wechat_menu_view_form" model="ir.ui.view">
    <field name="name">wechat.menu.view.form</field>
    <field name="model">wechat.menu</field>
    <field name="arch" type="xml">
      <form string="菜单管理">
        <header>
          <!-- <button name="to_json" string="同步数据" type="object" class="btn btn-primary" groups="base.group_system" /> -->
        </header>
        <sheet>
          <group>
            <field name="name" />
            <field name="menu_item_ids" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="wechat_menu_item_tree_view" model="ir.ui.view">
    <field name="name">wechat.menu.item.tree.view</field>
    <field name="model">wechat.menu.item</field>
    <field name="arch" type="xml">
      <tree string="menus" sample="1">
        <field name="sequence" widget="handle"/>
        <field name="name" />
        <field name="parent_id" />
        <field name="child_ids" />
        <field name="type" />
      </tree>
    </field>
  </record>

  <record id="wechat_menu_item_view_form" model="ir.ui.view">
    <field name="name">wechat.menu.item.view.form</field>
    <field name="model">wechat.menu.item</field>
    <field name="arch" type="xml">
      <form string="">
        <sheet>
          <group>
            <field name="name" />
            <field name="type" />
            <field name="child_ids" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="wechat_menu_item_action_view_form" model="ir.ui.view">
    <field name="name">wechat.menu.item.action.view.form</field>
    <field name="model">wechat.menu.item.action</field>
    <field name="arch" type="xml">
      <form string="">
        <sheet>
          <group>
            <field name="name" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="wechat_menu_kanban_view">
    <field name="name">wechat.menu.kanban.view</field>
    <field name="model">wechat.menu</field>
    <field name="arch" type="xml">
      <kanban sample="1">
        <field name="name"/>
        <field name="menu_item_ids"/>
        <field name="image_128"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
              <t t-set="placeholder" t-value="'/base/static/img/company_image.png'"/>
              <div class="o_kanban_image_fill_left o_kanban_image_full" t-attf-style="background-image: url(#{kanban_image('wechat.offiaccount.config', 'image_128', record.name, placeholder)})" role="img"/>
              <div class="oe_kanban_details">
                <strong class="o_kanban_record_title oe_wechat_heading">
                  <field name="name"/>
                </strong>
                <div class="o_kanban_tags_section oe_kanban_wechat_categories"/>
                <ul>
                  <field name="menu_item_ids" widget="many2many_tags" />
                </ul>
                <div class="oe_kanban_wechat_links"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="wechat_menu_act" model="ir.actions.act_window">
    <field name="name">菜单管理</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">wechat.menu</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
          微信公众号、企业微信等的菜单管理
      </p>
      <p>
        <a href="https://mp.weixin.qq.com" target="_blank">Click here to view wechat info.</a>
      </p>
    </field>
  </record>

  <menuitem name="企业微信配置" id="wechat_work_base_setting_menu" parent="oa_integrated.oa_setting_menu" sequence="2" action="wechat_work_base_setting_act_window"/>

  <!-- Top menu item -->
  <!--
        This menu item's purpose is to overwrite another one defined in
        the base module in order to set new groups.
    -->
  <menuitem id="wechat_menu_root" name="微信集成" web_icon="wechat,static/description/icon.png" groups="wechat.group_wechat_setting" sequence="5"/>
  <menuitem id="wechat_offiaccount_config_menu" name="公众号" parent="wechat_menu_root" action="wechat_offiaccount_config_act" groups="wechat.group_wechat_setting" sequence="1"/>
  <menuitem id="wechat_menu_menu" name="菜单管理" parent="wechat_menu_root" action="wechat_menu_act" groups="wechat.group_wechat_setting" sequence="10"/>
</odoo>
