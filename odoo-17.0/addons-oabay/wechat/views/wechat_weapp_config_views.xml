<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record model="ir.ui.view" id="wechat_weapp_config_kanban_view">
      <field name="name">wechat.weapp.config.kanban</field>
      <field name="model">wechat.weapp.config</field>
      <field name="arch" type="xml">
        <kanban class="o_wechat_weapp_config_kanban" sample="1">
          <field name="id"/>
          <field name="name"/>
          <field name="app_id"/>
          <field name="image_128"/>
          <templates>
            <t t-name="kanban-box">
              <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_wechat_wechat_kanban">
                <t t-set="placeholder" t-value="'/base/static/img/company_image.png'"/>
                <div class="o_kanban_image_fill_left o_kanban_image_full" t-attf-style="background-image: url(#{kanban_image('wechat.weapp.config', 'image_128', record.id.raw_value, placeholder)})" role="img"/>
                <div class="oe_kanban_details">
                  <strong class="o_kanban_record_title oe_wechat_heading">
                    <field name="name"/>
                  </strong>
                  <div class="o_kanban_tags_section oe_kanban_wechat_categories"/>
                  <ul>
                    <field name="website_id" />
                    <li t-if="record.app_id.raw_value">
                      <field name="app_id"/>
                    </li>
                  </ul>
                  <div class="oe_kanban_wechat_links"/>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record id="wechat_weapp_config_tree_view" model="ir.ui.view">
      <field name="name">wechat.weapp.config.tree</field>
      <field name="model">wechat.weapp.config</field>
      <field name="arch" type="xml">
        <tree string="微信小程序" sample="1">
          <field name="name" />
          <field name="app_id" />
          <field name="website_id" />
        </tree>
      </field>
    </record>

    <record id="wechat_weapp_config_form_view" model="ir.ui.view">
      <field name="name">wechat.weapp.config.form</field>
      <field name="model">wechat.weapp.config</field>
      <field name="arch" type="xml">
        <form string="微信小程序" class="o_wechat_form">
          <field name="id" invisible="1"/>
          <header>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
            </div>
            <field name="image_1920" widget='image' class="oe_avatar" options='{"preview_image": "image_128"}'/>
            <div class="oe_title" style="width: 100%;">
              <h1>
                <field name="name" default_focus="1" placeholder="小程序名称"/>
              </h1>
            </div>
            <group string="开发信息">
              <group>
                <field name="app_id" />
                <field name="website_id" />
              </group>
              <group>
                <field name="secret" class="oe_edit_only" password="True" />
              </group>
            </group>
            <group string="服务器配置">
              <group>
                <field name="message_token" />
                <field name="message_encrypt_mode" />
              </group>
              <group>
                <field name="message_encoding_aeskey" class="oe_edit_only" />
                <field name="message_format" />
              </group>
              <group colspan="4">
                <field name="message_handler_url" />
              </group>
            </group>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers"/>
            <field name="activity_ids" widget="mail_activity"/>
            <field name="message_ids" widget="mail_thread"/>
          </div>
        </form>
      </field>
    </record>

    <record id="wechat_weapp_config_act" model="ir.actions.act_window">
      <field name="name">微信小程序设置</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">wechat.weapp.config</field>
      <field name="view_mode">kanban,tree,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          添加微信小程序设置
        </p>
        <p>
          <a href="https://mp.weixin.qq.com" target="_blank">Click here to view wechat info.</a>
        </p>
      </field>
    </record>

  </data>
</odoo>