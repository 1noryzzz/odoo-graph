<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="wechat_work_config_tree_view" model="ir.ui.view">
    <field name="name">wechat.work.config.tree</field>
    <field name="model">wechat.work.config</field>
    <field name="arch" type="xml">
      <tree default_order="id desc">
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="corp_id"/>
        <field name="default_agent_id"/>
      </tree>
    </field>
  </record>

  <record id="wechat_work_config_form_view" model="ir.ui.view">
    <field name="name">wechat.work.config.form</field>
    <field name="model">wechat.work.config</field>
    <field name="arch" type="xml">
      <form class="o_galaxy_form_view">
        <header>
          <button name="wechat_work_sync" class="btn-primary" type="object" string="同步应用列表"/>
        </header>
        <sheet>
          <div class="alert alert-warning" role="alert">
            温馨提示：您可以前往企业微信管理后台得到这些信息！
            <a href='https://work.weixin.qq.com' target='_blank'>
                <span>企业微信后台管理</span>
            </a>
          </div>
          <group string="配置信息" col="1">
            <group>
              <field name="company_id" options="{'no_create_edit': '1', 'no_open':1}"/>
              <field name="corp_contact_secret"/>
            </group>
            <group>
              <field name="corp_id" placeholder="企业微信的 CorpId"/>
              <field name="external_contact_secret"/>
            </group>
          </group>
          <notebook>
            <page string="应用列表">
              <group col="1">
                <group>
                  <field name="agent_ids" mode="kanban" kanban_view_ref="wechat.wechat_work_agent_config_kanban_view" 
                    nolabel="1" context="{'default_company_id': company_id}"/>
                </group>
              </group>
            </page>
            <page string="其它设置">
              <group col="2">
                <!-- <group>
                  <field name="delete_is_sy"/>
                </group>
                <group>
                  <field name="cron_attendance"/>
                </group> -->
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="wechat_work_config_search_view">
    <field name="model">wechat.work.config</field>
    <field name="arch" type="xml">
      <search string="参数配置">
        <field name="name"/>
        <field name="agent_ids"/>
        <field name="corp_id"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <filter name="我加的" domain="[('create_uid', '=', uid)]"/>
        <separator/>
        <filter name="group_by_company_id" string="Company" context="{'group_by':'company_id'}"/>
        <separator/>
      </search>
    </field>
  </record>

  <record id="wechat_work_agent_config_tree_view" model="ir.ui.view">
    <field name="name">wechat.work.agent.config.tree</field>
    <field name="model">wechat.work.agent.config</field>
    <field name="arch" type="xml">
      <tree default_order="id desc">
        <field name="name"/>
        <field name="icon_url" width="20px" height="20px" widget="html"/>
        <field name="agent_id"/>
        <field name="remark"/>
        <field name="corpapp"/>
        <field name="state"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </tree>
    </field>
  </record>

  <record model="ir.ui.view" id="wechat_work_agent_config_kanban_view">
    <field name="name">wechat.work.agent.config.kanban</field>
    <field name="model">wechat.work.agent.config</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile">
        <field name="id"/>
        <field name="name"/>
        <field name="icon_url"/>
        <field name="agent_id"/>
        <field name="remark"/>
        <field name="corpapp"/>
        <field name="state"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click o_kanban_record_has_image_fill oe_module_vignette">
              <div class="oe_kanban_avatar float-left mr-3">
                <field name="icon_url" widget="html"/>
              </div>
              <div class="oe_kanban_details">
                <div class="o_kanban_record_top">
                  <div class="o_kanban_record_headings">
                    <strong class="o_kanban_record_title">
                      <field name="name"/>(<field name="agent_id"/>)
                    </strong>
                  </div>
                </div>
                <div>
                  <strong>
                    <field name="remark"/>
                  </strong>
                </div>
                <ul>
                  <li>
                    <strong>
                      <field name="state" widget="label_selection" 
                        options="{'classes': {'0': 'default-width-auto', '1': 'success-width-auto'}}"/>
                    </strong>
                  </li>
                </ul>
                <field name="company_id" groups="base.group_multi_company"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="wechat_work_agent_config_form_view" model="ir.ui.view">
    <field name="name">wechat.work.agent.config.form</field>
    <field name="model">wechat.work.agent.config</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <!-- <button name="get_visible_scopes" class="btn btn-success" type="object" string="Get Visible Scopes"/>
          <b utton name="(dingtalk_mc.din  gtalk_miroapp_set_visible_form_action)d" class="btn btn-warning" type="action" string="设置可见范围" context="{'default_miroapp_id': id}"/> -->
          <field name="state" widget="statusbar" modifiers="{'readonly': true}"/>
        </header>
        <sheet>
          <field name="icon_url" class="oe_avatar"/>
          <group>
            <group>
              <field name="name"/>
              <field name="agent_id"/>
              <field name="corpapp"/>
            </group>
            <group>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </group>
          <group>
            <field name="remark"/>
            <field name="home_url"/>
            <field name="redirect_domain"/>
          </group>
          <notebook>
            <!-- <page string="可见员工">
              <group>
                <field name="employee_ids" widget="many2many_tags" attrs="{'readonly': 1}"/>
              </group>
            </page>
            <page string="可见部门">
              <group>
                <field name="department_ids" widget="many2many_tags" attrs="{'readonly': 1}"/>
              </group>
            </page> -->
            <page string="开发配置">
              <group>
                <field name="agent_secret"/>
                <field name="message_token"/>
                <field name="message_encoding_aeskey"/>
                <field name="message_handler_url"/>
                <field name="qr_login_id" invisible="corpapp == False" />
              </group>
            </page>
          </notebook>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids" widget="mail_followers"/>
          <field name="activity_ids" widget="mail_activity"/>
          <field name="message_ids" widget="mail_thread"/>
        </div>
      </form>
    </field>
  </record>

  <record id="wechat_work_base_setting_act_window" model="ir.actions.act_window">
    <field name="name">参数配置</field>
    <field name="res_model">wechat.work.config</field>
    <field name="view_mode">tree,form,activity</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
                如果您注册好了企业微信账号，请在这里添加相关配置
      </p>
    </field>
  </record>
</odoo>