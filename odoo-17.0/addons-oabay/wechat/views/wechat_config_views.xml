    <record model="ir.ui.view" id="wechat_offiaccount_config_kanban_view">
      <field name="name">wechat.offiaccount.config.kanban</field>
      <field name="model">wechat.offiaccount.config</field>
      <field name="arch" type="xml">
        <kanban class="o_wechat_offiaccount_config_kanban" sample="1">
          <field name="id"/>
          <field name="name"/>
          <field name="offiaccount_type"/>
          <field name="app_id"/>
          <field name="image_128"/>
          <templates>
            <t t-name="kanban-box">
              <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_wechat_wechat_kanban">
                <t t-set="placeholder" t-value="'/base/static/img/company_image.png'"/>
                <div class="o_kanban_image_fill_left o_kanban_image_full" t-attf-style="background-image: url(#{kanban_image('wechat.offiaccount.config', 'image_128', record.id.raw_value, placeholder)})" role="img"/>
                <div class="oe_kanban_details">
                  <strong class="o_kanban_record_title oe_wechat_heading">
                    <field name="name"/>
                  </strong>
                  <div class="o_kanban_tags_section oe_kanban_wechat_categories"/>
                  <ul>
                    <field name="website_id" />
                    <li t-if="record.offiaccount_type.raw_value">
                      <field name="offiaccount_type"/>
                    </li>
                    <li t-if="record.app_id.raw_value">
                      <field name="app_id"/>
                    </li>
                  </ul>
                  <div class="oe_kanban_wechat_links"/>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record id="wechat_offiaccount_config_tree_view" model="ir.ui.view">
      <field name="name">wechat.offiaccount.config.tree</field>
      <field name="model">wechat.offiaccount.config</field>
      <field name="arch" type="xml">
        <tree string="Offiaccounts" sample="1">
          <field name="name" />
          <field name="offiaccount_type" />
          <field name="app_id" />
          <field name="website_id" />
        </tree>
      </field>
    </record>

    <record id="wechat_offiaccount_config_form_view" model="ir.ui.view">
      <field name="name">wechat.offiaccount.config.form</field>
      <field name="model">wechat.offiaccount.config</field>
      <field name="arch" type="xml">
        <form string="Offiaccount" class="o_wechat_form">
          <field name="id" invisible="1"/>
          <header>
            <!-- <button name="action_open" string="Start Wechat" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('id', '=', False)]}"/>
            <button name="action_draft" string="Set to draft" type="object" class="oe_highlight" states="closed"/>
            <button name="action_close" string="Close" type="object" class="oe_highlight" states="open"/> -->
            <!-- <button name="sync_subscriber" string="Sync subscribers" type="object" class="oe_highlight" /> -->
            <button name="sync_menu" string="同步自定义菜单" type="object" class="btn btn-primary" groups="base.group_system" 
              invisible="menu_ids == False" />
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="view_taglist" type="object" class="oe_stat_button" icon="fa-tags">
                <field name="taglist_count" widget="statinfo"/>
              </button>
              <button name="view_subscribers" type="object" class="oe_stat_button" icon="fa-users">
                <field name="subscribers_count" widget="statinfo"/>
              </button>
              <!-- <button name="view_groups" type="object" class="oe_stat_button" icon="fa-users">
                <field name="groups_count" widget="statinfo"/>
              </button> -->
              <!-- <button name="action_black_list" type="object" class="oe_stat_button" icon="fa-user-secret">
                <field string="blackList" name="black_list_count" widget="statinfo"/>
              </button> -->
            </div>
            <field name="image_1920" widget='image' class="oe_avatar" options='{"preview_image": "image_128"}'/>
            <div class="oe_title" style="width: 100%;">
              <field name="offiaccount_type" widget="radio" options="{'horizontal': true}"/>
              <h1>
                <field name="name" default_focus="1" placeholder="公众号名称"/>
              </h1>
            </div>
            <group string="公众号开发信息">
              <group>
                <field name="app_id" />
                <field name="website_id" />
              </group>
              <group>
                <field name="secret" class="oe_edit_only" password="True" />
                <field name="is_default" />
                <field name="qr_login_id" />
              </group>
            </group>
            <group title="公众号菜单配置" colspan="4">
              <field name="menu_ids" context="{'default_offiaccount_id': active_id}">
                <tree editable="bottom">
                  <field name="offiaccount_menuid" readonly="1" />
                  <field name="menu_id" />
                  <field name="tag_id" />
                </tree>
              </field>
            </group>
            <group string="服务器配置">
              <group>
                <field name="message_token" />
                <field name="message_encrypt_mode" />
              </group>
              <group>
                <field name="message_encoding_aeskey" class="oe_edit_only" />
                <field name="message_format" />
              </group>
              <group colspan="4">
                <field name="message_handler_url" />
              </group>
            </group>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers"/>
            <field name="activity_ids" widget="mail_activity"/>
            <field name="message_ids" widget="mail_thread"/>
          </div>
        </form>
      </field>
    </record>

    <record id="wechat_offiaccount_user_tree_view" model="ir.ui.view">
      <field name="name">wechat.offiaccount.user.tree</field>
      <field name="model">wechat.offiaccount.user</field>
      <field name="arch" type="xml">
        <tree string="公众号订阅用户" sample="1" js_class="wechat_integrate_tree">
          <field name="name" />
          <field name="group_id" />
          <field name="tag_ids" widget="many2many_tags" />
          <field name="offiaccount_id" />
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="wechat_offiaccount_user_kanban_view">
      <field name="name">wechat.offiaccount.user.kanban</field>
      <field name="model">wechat.offiaccount.user</field>
      <field name="arch" type="xml">
        <kanban string="公众号订阅用户" class="o_res_partner_kanban" sample="1" js_class="wechat_integrate_kanban" quick_create="false">
          <field name="id"/>
          <field name="color"/>
          <field name="display_name"/>
          <field name="title"/>
          <field name="email"/>
          <field name="parent_id"/>
          <field name="is_company"/>
          <field name="function"/>
          <field name="phone"/>
          <field name="street"/>
          <field name="street2"/>
          <field name="zip"/>
          <field name="city"/>
          <field name="country_id"/>
          <field name="mobile"/>
          <field name="state_id"/>
          <field name="category_id"/>
          <field name="image_128"/>
          <field name="type"/>
          <field name="tag_ids" />
          <field name="group_id" />
          <field name="subscribe_time" />
          <templates>
            <t t-name="kanban-box">
              <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">

                <t t-if="record.type.raw_value === 'delivery'" t-set="placeholder" t-value="'/base/static/img/truck.png'"/>
                <t t-elif="record.type.raw_value === 'invoice'" t-set="placeholder" t-value="'/base/static/img/money.png'"/>
                <t t-else="" t-set="placeholder" t-value="'/base/static/img/avatar_grey.png'"/>
                <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{kanban_image('wechat.offiaccount.user', 'image_128', record.id.raw_value,  placeholder)}')">
                  <img class="o_kanban_image_inner_pic" t-if="record.parent_id.raw_value" t-att-alt="record.parent_id.value" t-att-src="kanban_image('res.partner', 'image_128', record.parent_id.raw_value)"/>
                </div>
                <div class="o_kanban_image d-md-none" t-attf-style="background-image:url('#{kanban_image('wechat.offiaccount.user', 'image_128', record.id.raw_value,  placeholder)}')">
                  <img class="o_kanban_image_inner_pic" t-if="record.parent_id.raw_value" t-att-alt="record.parent_id.value" t-att-src="kanban_image('res.partner', 'image_128', record.parent_id.raw_value)"/>
                </div>

                <div class="oe_kanban_details d-flex flex-column">
                  <strong class="o_kanban_record_title oe_partner_heading">
                    <field name="display_name"/>
                  </strong>
                  <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                  <ul>
                    <li t-if="record.parent_id.raw_value and !record.function.raw_value">
                      <field name="parent_id"/>
                    </li>
                    <li t-if="!record.parent_id.raw_value and record.function.raw_value">
                      <field name="function"/>
                    </li>
                    <li t-if="record.parent_id.raw_value and record.function.raw_value">
                      <field name="function"/>
 at <field name="parent_id"/>
                    </li>
                    <li t-if="record.city.raw_value or record.country_id.raw_value">
                      <t t-if="record.city.raw_value">
                        <field name="city"/>
                        <t t-if="record.country_id.raw_value">, </t>
                      </t>
                      <t t-if="record.country_id.raw_value">
                        <field name="country_id"/>
                      </t>
                    </li>
                    <!-- <li t-if="record.tag_ids.raw_value">
                      <t t-foreach="tag_ids" t-as="tag">
                        <t t-esc="tag.name"/>
                      </t>
                    </li> -->
                    <li t-if="record.group_id.raw_value">
                      <field name="group_id"/>
                    </li>
                    <li t-if="record.subscribe_time.raw_value">
                      <field name="subscribe_time"/>
                    </li>
                  </ul>
                  <div class="o_row">
                    <span class="oe_kanban_partner_links"/>
                  </div>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record id="wechat_offiaccount_taglist_tree_view" model="ir.ui.view">
      <field name="name">wechat.offiaccount.taglist.tree</field>
      <field name="model">wechat.offiaccount.taglist</field>
      <field name="arch" type="xml">
        <tree string="Offiaccount Taglist" sample="1" js_class="wechat_integrate_tree" editable="bottom">
          <field name="name" />
          <field name="count" readonly="1" />
          <field name="offiaccount_id" invisible="1" />
        </tree>
      </field>
    </record>

    <record id="wechat_offiaccount_groups_tree_view" model="ir.ui.view">
      <field name="name">wechat.offiaccount.group.tree</field>
      <field name="model">wechat.offiaccount.group</field>
      <field name="arch" type="xml">
        <tree string="Offiaccount Groups" sample="1" js_class="wechat_integrate_tree" editable="bottom">
          <field name="name" />
          <field name="count" readonly="1" />
          <field name="offiaccount_id" invisible="1" />
        </tree>
      </field>
    </record>

    <record id="wechat_work_agent_config_act" model="ir.actions.act_window">
      <field name="name">企业微信应用配置</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">wechat.work.agent.config</field>
      <field name="view_mode">kanban,tree,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Add a new wechat work agent
        </p>
        <p>
          Create and manage agent in <a href="https://work.weixin.qq.com/wework_admin/loginpage_wx?from=myhome" target="_blank">WeWork platform</a> and add it in here.
        </p>
      </field>
    </record>

    <record id="wechat_offiaccount_config_act" model="ir.actions.act_window">
      <field name="name">公众号设置</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">wechat.offiaccount.config</field>
      <field name="view_mode">kanban,tree,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Add a wechat offiaccount config
        </p>
        <p>
          <a href="https://mp.weixin.qq.com" target="_blank">Click here to view wechat info.</a>
        </p>
      </field>
    </record>

    <record id="wechat_offiaccount_taglist_act" model="ir.actions.act_window">
      <field name="name">公众号标签管理</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">wechat.offiaccount.taglist</field>
      <field name="view_mode">tree</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          No Tag Defined
        </p>
      </field>
    </record>
  </data>
</odoo>