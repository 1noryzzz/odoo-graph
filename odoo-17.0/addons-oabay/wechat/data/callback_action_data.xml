<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record forcecreate="True" id="wechat_callback_action_msg_text" model="oa.callback.action">
      <field name="name">微信公众号：普通消息</field>
      <field name="model_id" ref="model_wechat_offiaccount_user"/>
      <field name="state">code</field>
      <field name="code">action = model._process_message()</field>
      <field name="user_id" ref="wechat_message_push_user_id"/>
      <field name="value_code_ids" eval="[(6, 0, [ref('wechat_callback_code_msg_text'), 
        ref('wechat_callback_code_msg_image'), ref('wechat_callback_code_msg_voice'), 
        ref('wechat_callback_code_msg_video'), ref('wechat_callback_code_msg_shortvideo'),
        ref('wechat_callback_code_msg_location'), ref('wechat_callback_code_msg_link')])]"/>
    </record>
    <record forcecreate="True" id="wechat_callback_action_event_subscribe" model="oa.callback.action">
      <field name="name">微信公众号：关注</field>
      <field name="model_id" ref="model_wechat_offiaccount_user"/>
      <field name="state">code</field>
      <field name="code">action = model._process_event_subscribe()</field>
      <field name="user_id" ref="wechat_message_push_user_id"/>
      <field name="value_code_ids" eval="[(6, 0, [ref('wechat_callback_code_event_subscribe'), 
        ref('wechat_callback_code_event_subscribe_scan'), ref('wechat_callback_code_event_scan')])]"/>
      <field name="sequence" eval="0"/>
    </record>
    <record forcecreate="True" id="wechat_callback_action_event_location" model="oa.callback.action">
      <field name="name">微信公众号：上报地理位置</field>
      <field name="model_id" ref="model_wechat_offiaccount_user"/>
      <field name="state">code</field>
      <field name="code">action = model._process_event_location()</field>
      <field name="user_id" ref="wechat_message_push_user_id"/>
      <field name="value_code_ids" eval="[(6, 0, [ref('wechat_callback_code_event_location')])]"/>
      <field name="sequence" eval="0"/>
    </record>
  </data>
</odoo>