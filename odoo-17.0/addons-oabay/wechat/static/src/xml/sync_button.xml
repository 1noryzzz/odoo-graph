<?xml version="1.0" encoding="UTF-8"?>
<templates id="sync_button_template" xml:space="preserve">

  <t t-extend="ListView.buttons" t-name="WechatIntegrateListView.buttons">
    <t t-jquery="button.o_list_button_add" t-operation="after">
      <t t-if="widget.is_action_enabled('create')">
        <button type="button" class="btn btn-secondary o_list_button_sync" accesskey="s">
          <t t-esc="_t('同步')"/>
        </button>
      </t>
    </t>
  </t>

  <t t-extend="KanbanView.buttons" t-name="WechatIntegrateKanbanView.buttons">
    <t t-jquery="button" t-operation="after">
      <button t-if="!noCreate" type="button" t-attf-class="btn btn-secondary o-kanban-button-sync" accesskey="s">
        <t t-esc="_t('同步')"/>
      </button>
    </t>
  </t>
</templates>