      <field name="name">动态令牌使用记录流水号</field>
      <field name="code">otp.authentication.log</field>
      <field name="prefix">OTP%(y)s%(month)s%(day)s%(h24)s%(min)s%(sec)s</field>
      <field name="padding">3</field>
      <field name="company_id" eval="True"/>
    </record>

  </data>
</odoo>
