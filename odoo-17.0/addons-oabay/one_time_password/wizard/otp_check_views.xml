<?xml version="1.0"?>
<odoo>
  <record id="otp_check_view_form" model="ir.ui.view">
    <field name="name">otp.check.view.form</field>
    <field name="model">otp.check</field>
    <field name="arch" type="xml">
      <form string="动态令牌认证">
        <group class="oe_title">
          <field name="otp_auth_id" options="{'no_create_edit': True}" />
          <field name="passwd" />
        </group>
        <footer>
          <button name="check_passwd" string="认证" type="object" class="btn-primary" data-hotkey="q"/>
          <button string="取消" class="btn-secondary" special="cancel" data-hotkey="z"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
