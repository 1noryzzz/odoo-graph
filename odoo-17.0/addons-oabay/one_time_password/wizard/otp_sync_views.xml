<?xml version="1.0"?>
<odoo>
  <record id="otp_sync_view_form" model="ir.ui.view">
    <field name="name">otp.sync.view.form</field>
    <field name="model">otp.sync</field>
    <field name="arch" type="xml">
      <form string="动态令牌同步">
        <group class="oe_title">
          <field name="otp_auth_id" options="{'no_create_edit': True}" />
          <field name="passwd1" />
          <field name="passwd2" />
        </group>
        <footer>
          <button name="otp_sync" string="同步" type="object" class="btn-primary" data-hotkey="q"/>
          <button string="取消" class="btn-secondary" special="cancel" data-hotkey="z"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
