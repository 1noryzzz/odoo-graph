<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="otp_authentication_view_search" model="ir.ui.view">
    <field name="name">otp.authentication.view.search</field>
    <field name="model">otp.authentication</field>
    <field name="arch" type="xml">
      <search string="动态令牌">
        <field name="device_id"/>
        <separator/>
        <filter string="可用令牌" name="active" domain="[('active', '=', True)]"/>
        <filter string="已归档" name="inactive" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>

  <record id="otp_authentication_view_tree" model="ir.ui.view">
    <field name="name">otp.authentication.view.tree</field>
    <field name="model">otp.authentication</field>
    <field name="arch" type="xml">
      <tree string="动态令牌" decoration-muted="(not active)">
        <field name="device_id"/>
        <field name="state"/>
        <field name="cycles"/>
        <field name="syncwnd"/>
        <field name="drift"/>
        <field name="active" widget="boolean_toggle"/>
      </tree>
    </field>
  </record>

  <record id="otp_authentication_view_form" model="ir.ui.view">
    <field name="name">otp.authentication.view.form</field>
    <field name="model">otp.authentication</field>
    <field name="arch" type="xml">
      <form string="动态令牌">
        <field name="id" invisible="1"/>
        <field name="active" invisible="1" />
        <header>
          <button name="action_approval" string="启用" class="btn-primary" type="object" 
            invisible="(state == 'normal')"
            groups="base.group_system"/>
          <button name="action_pause" string="停用" class="btn-primary" type="object" confirm="确认停用此动态令牌吗？" 
            invisible="(state in ('draft', 'paused'))"
            groups="base.group_system"/>

          <button name="action_check_pwd" string="认证" type="object" 
            invisible="(state == 'paused')"
            groups="base.group_system"/>
          <button name="action_sync" string="同步" type="object" 
            invisible="(state == 'paused')"
            groups="base.group_system"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,normal,paused" groups="base.group_system"/>
        </header>
        <sheet>
          <group>
            <field name="device_id" />
            <field name="auth_key" />
            <field name="cycles"/>
            <field name="syncwnd"/>
            <field name="drift"/>
            <field name="company_id"/>
          </group>
          <notebook colspan="4">
            <page string="使用记录" name="log_ids" autofocus="autofocus">
              <field name="log_ids"/>
            </page>
          </notebook>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids" widget="mail_followers"/>
          <field name="activity_ids" widget="mail_activity"/>
          <field name="message_ids" widget="mail_thread"/>
        </div>
      </form>
    </field>
  </record>

  <record id="otp_authentication_log_view_tree" model="ir.ui.view">
    <field name="name">otp.authentication.log.view.tree</field>
    <field name="model">otp.authentication.log</field>
    <field name="arch" type="xml">
      <tree string="动态令牌使用日志" create="false" edit="false">
        <field name="code"/>
        <field name="drift"/>
        <field name="result"/>
        <field name="auth_result"/>
        <field name="write_date"/>
        <field name="write_uid"/>
        <!-- <field name="partner_id" widget="res_partner_many2one"/> -->
      </tree>
    </field>
  </record>

  <record id="otp_authentication_act" model="ir.actions.act_window">
    <field name="name">动态令牌</field>
    <field name="res_model">otp.authentication</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_active': 1}</field>
  </record>

  <menuitem id="menu_otp_authentication_act" action="otp_authentication_act" parent="base.menu_security"/>

</odoo>