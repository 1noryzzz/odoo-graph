<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_base_company_root_user_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.base.company.root.user.wizard.view.form</field>
    <field name="model">ifs.base.company.root.user.wizard</field>
    <field name="inherit_id" ref="ifs_base.ifs_steps_wizard_view_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form position="attributes">
        <attribute name="string">创建根用户</attribute>
        <attribute name="class">o_galaxy_form_view</attribute>
      </form>
      <sheet position="inside">
        <field name="ifs_company_id" invisible="1"/>
        <field name="legal_id" invisible="1"/>
        <field name="root_employee_id" invisible="1"/>
        <field name="can_change_contact" invisible="1"/>
        <div class="oe_button_box" name="button_box"></div>
        <div class="oe_title">
          <label for="name"/>
          <h1>
            <field name="name" class="oe_inline" readonly="1"/>
          </h1>
        </div>
        <group string="基本信息">
          <group>
            <field name="login" readonly="1" />
            <field name="mobile_phone" readonly="not can_change_contact"/>
            <field name="gender" widget="radio" options="{'horizontal': 1}"/>
          </group>
          <group>
            <!-- <field name="work_position_ids" widget="many2many_tags" options="{'no_create': '1', 'color_field': 'color'}" readonly="1" force_save="1"/> -->
            <field name="work_email" readonly="not can_change_contact"/>
            <field name="emergency_phone" string="紧急联系电话"/>
          </group>
          <group colspan="2">
            <field name="notes"/>
          </group>
        </group>
      </sheet>
      <button special="cancel" position="replace">
        <button name="action_confirm" type="object" string="确认" class="btn-primary" data-hotkey="c"/>
        <button string="稍后再填" class="btn-default" special="cancel"/>
      </button>
    </field>
  </record>
</odoo>