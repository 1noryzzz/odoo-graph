<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="all_employee_visible_by_system" model="ir.rule">
      <field name="name">系统管理员，可以在员工管理里看到所有账户</field>
      <field name="model_id" ref="model_hr_employee"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="groups" eval="[Command.link(ref('base.group_system'))]" />
    </record>
    <record id="root_employee_invisible" model="ir.rule">
      <field name="name">各参与方的根账户，在员工管理里不可见</field>
      <field name="model_id" ref="model_hr_employee"/>
      <field name="domain_force">[('is_root', '=', False)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_base.group_ifs_user'))]" />
    </record>
  </data>
</odoo>