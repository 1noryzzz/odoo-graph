<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_partner_insurance_view_form_partner_hr_inherited" model="ir.ui.view">
    <field name="name">ifs.partner.insurance.view.form.partner.hr.inherited</field>
    <field name="model">ifs.partner.insurance</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_insurance_view_form"/>
    <field name="arch" type="xml">
      <field name="ifs_company_id" position="after">
        <field name="root_employee_id" invisible="1"/>
      </field>
      <header position="inside">
        <button name="action_create_root_user" type="object" string="创建根账户" 
          class="btn-primary" data-hotkey="a" invisible="root_employee_id"
          groups="ifs_partner.group_ifs_partner_platform_system"/>
        <button name="action_create_legal_idcard" type="object" string="更新法人身份证信息" 
          class="btn-primary" data-hotkey="a" invisible="not root_employee_id"
          groups="ifs_partner.group_ifs_partner_platform_system"/>
      </header>
    </field>
  </record>

</odoo>