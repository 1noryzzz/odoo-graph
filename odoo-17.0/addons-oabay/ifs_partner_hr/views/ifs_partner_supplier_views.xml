<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_partner_supplier_view_form_inherited" model="ir.ui.view">
    <field name="name">ifs.partner.supplier.view.form.inherited</field>
    <field name="model">ifs.partner.supplier</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_supplier_view_form" />
    <field name="arch" type="xml">
      <field name="definition_id" position="after">
        <field name="root_employee_id" invisible="1"></field>
        <field name="legal_idcard_id" invisible="1"></field>
      </field>
      <field name="legal_phone" position="after">
        <field name="legal_id_number"/>
        <field name="legal_authority"/>
      </field>
      <field name="legal_email" position="after">
        <field name="legal_address"/>
        <field name="legal_idcard_expiry_date"/>
      </field>
      <xpath expr="//group[hasclass('gp_legal')]" position="inside">
        <group>
          <field name="legal_front_image" widget="image" options="{'placeholder':'/galaxy_tdesign/static/src/img/idcard_front_image.png'}"/>
        </group>
        <group>
          <field name="legal_back_image" widget="image" options="{'placeholder':'/galaxy_tdesign/static/src/img/idcard_front_image.png'}"/>
        </group>
      </xpath>
      <xpath expr="//group[hasclass('gp_legal')]" position="after">
        <group class="gp_finance" string="财务联系人信息">
          <group>
            <field name="finance_name"/>
          </group>
          <group>
            <field name="finance_phone"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>