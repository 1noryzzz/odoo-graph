<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="multi_ifs_contract_template_system" model="ir.rule">
      <field name="name">管理员可以看到所有的合同模板</field>
      <field name="model_id" ref="ifs_contract.model_ifs_contract_template"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="groups" eval="[Command.link(ref('base.group_system'))]" />
    </record>

    <record id="multi_ifs_contract_template_factor_edit" model="ir.rule">
      <field name="name">保理方只能看到或创建和自己有关的合同模板</field>
      <field name="model_id" ref="ifs_contract.model_ifs_contract_template"/>
      <field name="domain_force">[('factor_id', '!=', False), ('factor_id.company_id','in',company_ids)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_contract.group_ifs_contract_template_manager'))]" />
    </record>

    <record id="multi_ifs_contract_template_factor_read" model="ir.rule">
      <field name="name">保理方能查看通用的合同模板</field>
      <field name="model_id" ref="ifs_contract.model_ifs_contract_template"/>
      <field name="domain_force">[('factor_id', '=', False)]</field>
      <field name="groups" eval="[Command.link(ref('ifs_contract.group_ifs_contract_template_manager'))]" />
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>
  </data>
</odoo>