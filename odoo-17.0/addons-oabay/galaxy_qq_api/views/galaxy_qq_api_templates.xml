<odoo>
    <template id="page_email_verification_error" name="邮件验证失败">
        <t t-call="http_routing.http_error">
        </t>
    </template>

    <template id="page_email_verification_success" name="邮件验证成功">
        <t t-call="web.frontend_layout">
            <div id="wrap">
                <div class="oe_structure">
                    <h1 class="container mt32">欢迎您回来：<t t-esc="user_name"/></h1>
                    <p class="container mt32">您的邮箱已经验证成功，您可以切换回APP继续您的旅程！</p>
                </div>
            </div>
        </t>
    </template>
</odoo>