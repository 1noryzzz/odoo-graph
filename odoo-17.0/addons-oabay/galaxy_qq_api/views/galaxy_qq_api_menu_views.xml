<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="galaxy_qq_api_app_act_window" model="ir.actions.act_window">
      <field name="name">前端应用列表</field>
      <field name="res_model">galaxy.qq.app</field>
      <field name="view_mode">tree,kanban,form</field>
      <field name="target">current</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          暂时还没有开放平台应用，请点击左上角“创建”
        </p>
        <p>
          <a href="https://www.lifewiz.cn" target="_blank">云腾智慧</a>
        </p>
      </field>
    </record>

    <menuitem id="galaxy_qq_api_root_menu" name="前端接口" 
      groups="group_galaxy_qq_api_manager" 
      web_icon="galaxy_qq_api,static/img/icon.png" sequence="99"/>

    <menuitem id="galaxy_qq_api_app_menu" name="前端应用列表" 
      action="galaxy_qq_api_app_act_window" groups="group_galaxy_qq_api_manager" 
      parent="galaxy_qq_api_root_menu" sequence="1"/>

    <menuitem id="galaxy_qq_api_weapp_menu" name="微信小程序" 
      action="wechat.wechat_weapp_config_act" groups="group_galaxy_qq_api_manager" 
      parent="galaxy_qq_api_root_menu" sequence="2" />
  </data>
</odoo>