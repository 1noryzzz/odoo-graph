<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="galaxy_qq_app_view_search" model="ir.ui.view">
    <field name="name">galaxy.qq.app.view.search</field>
    <field name="model">galaxy.qq.app</field>
    <field name="arch" type="xml">
      <search string="前端应用查询">
        <field name="name"/>
        <field name="app_code"/>
      </search>
    </field>
  </record>

  <record id="galaxy_qq_app_view_tree" model="ir.ui.view">
    <field name="name">galaxy.qq.app.view.tree</field>
    <field name="model">galaxy.qq.app</field>
    <field name="arch" type="xml">
      <tree string="前端应用列表" sample="1">
        <field name="name"/>
        <field name="user_id"/>
        <field name="app_code"/>
        <field name="ver_ids" widget="many2many_tags"/>
        <field name="qq_user_ids" widget="many2many_tags" optional="hide"/>
        <field name="description"/>
        <field name="state"/>
      </tree>
    </field>
  </record>

  <record id="galaxy_qq_app_view_form" model="ir.ui.view">
    <field name="name">galaxy.qq.app.view.form</field>
    <field name="model">galaxy.qq.app</field>
    <field name="arch" type="xml">
      <form class="o_galaxy_form_view">
        <header>
          <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
        </header>
        <sheet>
          <field name="active" invisible="1"/>
          <widget name="web_ribbon" title="已归档" bg_color="bg-danger"  invisible="active"/>
          <div class="oe_button_box" name="button_box"></div>
          <div class="oe_title">
            <h1>
              <field name="name" default_focus="1" placeholder="名称"/>
            </h1>
          </div>
          <group string="基本信息">
            <group>
              <field name="app_code" readonly="state != 'draft'"/>
              <field name="user_id" widget="many2one_avatar_user" options="{'no_create': true, 'no_open': true}" domain="[('company_id', '=', company_id)]"/>
            </group>
            <group>
              <field name="company_id" options="{'no_create': true, 'no_open': true}"/>
              <field name="weapp_id" options="{'no_create': true, 'no_open': true}" groups="galaxy_qq_api.group_galaxy_qq_api_manager"/>
            </group>
            <group colspan="2">
              <field name="description"/>
            </group>
          </group>
          <notebook>
            <page string="版本列表" name="versions" class="pg_versions" autofocus="autofocus">
              <field name="ver_ids" nolabel="1" mode="tree">
                <tree>
                  <field name="ver"/>
                  <field name="ver_secret"/>
                  <field name="android_download_url"/>
                  <field name="ios_download_url" optional="hide"/>
                  <field name="description"/>
                </tree>
              </field>
            </page>
            <page string="用户列表" name="qq_users" class="pg_qq_users">
              <field name="qq_user_ids" nolabel="1" mode="tree" readonly="1">
                <tree>
                  <field name="user_id"/>
                  <field name="mobile"/>
                  <field name="email"/>
                  <field name="login_time"/>
                  <field name="login_ip"/>
                  <field name="login_country" optional="hide"/>
                  <field name="login_city" optional="show"/>
                  <field name="login_phone_model" optional="show"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="galaxy_qq_user_view_from" model="ir.ui.view">
    <field name="name">galaxy.qq.users.view.form</field>
    <field name="model">galaxy.qq.users</field>
    <field name="arch" type="xml">
      <form class="o_galaxy_form_view">
        <sheet>
          <field name="app_id" string="所属APP" invisible="1"/>
          <div class="oe_title d-flex justify-content-between">
            <h1>
              <field name="user_name"/>
            </h1>
          </div>
          <group string="基本信息">
            <group>
              <field name="mobile" invisible="mobile == False"/>
              <field name="login_phone_model" invisible="mobile != False"/>
              <field name="login_ip" />
              <field name="login_country" />
            </group>
            <group>
              <field name="email" invisible="email == False"/>
              <field name="login_phone_model" invisible="email != False"/>
              <field name="login_time" />
              <field name="login_city" />
            </group>
          </group>
          <notebook>
            <page string="登录列表" name="user_keys" class="pg_versions" autofocus="autofocus">
              <field name="key_ids" nolabel="1" mode="tree">
                <tree limit="10" no_open="True">
                  <field name="ip"/>
                  <field name="country_id"/>
                  <field name="city"/>
                  <field name="phone_model"/>
                  <field name="platform_os" optional="hide"/>
                  <field name="lng" optional="show"/>
                  <field name="lat" optional="show"/>
                  <field name="postal" optional="hide"/>
                  <field name="tz" optional="hide"/>
                  <field name="expires_date"/>
                  <field name="is_invalid" widget="boolean_toggle"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="galaxy_qq_app_ver_view_form" model="ir.ui.view">
      <field name="name">galaxy.qq.app.ver.view.form</field>
      <field name="model">galaxy.qq.app.ver</field>
      <field name="arch" type="xml">
        <form string="青钱闪付APP版本" class="o_galaxy_form_view">
          <sheet>
            <group string="基本信息">
              <group>
                <field name="ver"/>
              </group>
              <group>
                <field name="ver_secret"/>
              </group>
              <group colspan="2">
                <field name="android_download_url"/>
              </group>
              <group colspan="2">
                <field name="ios_download_url"/>
              </group>
              <group colspan="2">
                <field name="description"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>
</odoo>
