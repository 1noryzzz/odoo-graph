<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="ifs_base_company_view_act" model="ir.actions.server">
      <field name="name">公司信息</field>
      <field name="model_id" ref="ifs_partner.model_ifs_base_company"/>
      <field name="state">code</field>
      <field name="code">
action = model.view_ifs_company()
      </field>
    </record>

    <record id="ifs_partner_supplier_list_act" model="ir.actions.server">
      <field name="name">企业实名认证</field>
      <field name="groups_id" eval="[(4, ref('ifs_partner.group_ifs_partner_factor_system'))]"/>
      <field name="model_id" ref="ifs_partner.model_ifs_partner_supplier"/>
      <field name="binding_model_id" ref="ifs_partner.model_ifs_partner_supplier"/>
      <field name="binding_view_types">list</field>
      <field name="state">code</field>
      <field name="code">
if records:
  action = records.action_certificate_company()
      </field>
    </record>

    <record id="ifs_partner_merchant_list_act" model="ir.actions.server">
      <field name="name">企业实名认证</field>
      <field name="groups_id" eval="[(4, ref('ifs_partner.group_ifs_partner_factor_system'))]"/>
      <field name="model_id" ref="ifs_partner.model_ifs_partner_merchant"/>
      <field name="binding_model_id" ref="ifs_partner.model_ifs_partner_merchant"/>
      <field name="binding_view_types">list</field>
      <field name="state">code</field>
      <field name="code">
if records:
  action = records.action_certificate_company()
      </field>
    </record>

    <record id="ifs_partner_funder_list_act" model="ir.actions.server">
      <field name="name">企业实名认证</field>
      <field name="groups_id" eval="[(4, ref('ifs_partner.group_ifs_partner_factor_system'))]"/>
      <field name="model_id" ref="ifs_partner.model_ifs_partner_funder"/>
      <field name="binding_model_id" ref="ifs_partner.model_ifs_partner_funder"/>
      <field name="binding_view_types">list</field>
      <field name="state">code</field>
      <field name="code">
if records:
  action = records.action_certificate_company()
      </field>
    </record>
  </data>
</odoo>