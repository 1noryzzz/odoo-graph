<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_partner_funder_view_search" model="ir.ui.view">
    <field name="name">ifs.partner.funder.view.search</field>
    <field name="model">ifs.partner.funder</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_mixin_view_search" />
    <field name="arch" type="xml">
      <search position="attributes">
        <attribute name="string">资金方查询</attribute>
      </search>
      <search position="inside">
        <field name="seq_code" string="资金方编号"/>
      </search>
    </field>
  </record>

  <record id="ifs_partner_funder_view_tree" model="ir.ui.view">
    <field name="name">ifs.partner.funder.view.tree</field>
    <field name="model">ifs.partner.funder</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_base.ifs_base_company_view_tree" />
    <field name="arch" type="xml">
      <tree position="attributes">
        <attribute name="string">资金方列表</attribute>
        <attribute name="js_class">ifs_partner_create_list</attribute>
        <attribute name="expand">1</attribute>
      </tree>
      <field name="company_code" position="before">
        <field name="seq_code" string="资金方编号"/>
      </field>
      <tree position="inside">
        <control>
          <create name="add_line_control" string="Add a line"/>
        
        </control>
      </tree>
    </field>
  </record>

  <record id="ifs_partner_funder_view_form" model="ir.ui.view">
    <field name="name">ifs.partner.funder.view.form</field>
    <field name="model">ifs.partner.funder</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_base.ifs_base_company_view_form" />
    <field name="arch" type="xml">
      <form position="attributes">
        <attribute name="js_class">ifs_partner_form</attribute>
      </form>
      <header position="inside">
        <button name="action_create_business_license" type="object" string="上传营业执照" 
          class="btn-primary" data-hotkey="a" invisible="business_license"
          groups="ifs_partner.group_ifs_partner_factor_manager"/>
        <button name="action_create_business_license" type="object" string="更新营业执照" 
          class="btn-primary" data-hotkey="a" invisible="not business_license"
          groups="ifs_partner.group_ifs_partner_factor_manager"/>
        <!-- <button name="action_update_account" type="object" string="更新银行账户" 
          class="btn-primary" data-hotkey="a" groups="ifs_partner.group_ifs_partner_factor_manager"/> -->
      </header>
      <field name="company_id" position="after">
        <field name="ifs_company_id" invisible="1"/>
      </field>
      <span name="ifs_base_company_code" position="replace">
        <span invisible="not seq_code">资金方编号：          <field name="seq_code" class="oe_inline" />
        </span>
      </span>
      <field name="name" position="attributes">
        <attribute name="placeholder">资金方名称</attribute>
      </field>
    </field>
  </record>

</odoo>