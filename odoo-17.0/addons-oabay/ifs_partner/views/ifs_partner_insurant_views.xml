<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_partner_insurant_view_search" model="ir.ui.view">
    <field name="name">ifs.partner.insurant.view.search</field>
    <field name="model">ifs.partner.insurant</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_mixin_view_search" />
    <field name="arch" type="xml">
      <search position="attributes">
        <attribute name="string">投保人查询</attribute>
      </search>
      <search position="inside">
        <field name="seq_code" string="投保人编号"/>
      </search>
    </field>
  </record>

  <record id="ifs_partner_insurant_view_tree" model="ir.ui.view">
    <field name="name">ifs.partner.insurant.view.tree</field>
    <field name="model">ifs.partner.insurant</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_base.ifs_base_company_view_tree" />
    <field name="arch" type="xml">
      <tree position="attributes">
        <attribute name="string">投保人列表</attribute>
        <attribute name="js_class">ifs_partner_create_list</attribute>
        <attribute name="expand">1</attribute>
      </tree>
      <field name="company_code" position="before">
        <field name="seq_code" string="投保人编号"/>
      </field>
      <tree position="inside">
        <control>
          <create name="add_line_control" string="Add a line"/>
          <!-- <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
          <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/> -->
        </control>
      </tree>
    </field>
  </record>

  <record id="ifs_partner_insurant_view_form" model="ir.ui.view">
    <field name="name">ifs.partner.insurant.view.form</field>
    <field name="model">ifs.partner.insurant</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_base.ifs_base_company_view_form" />
    <field name="arch" type="xml">
      <form position="attributes">
        <attribute name="js_class">ifs_partner_form</attribute>
      </form>
      <field name="company_id" position="after">
        <field name="ifs_company_id" invisible="1"/>
      </field>
      <span name="ifs_base_company_code" position="replace">
        <span invisible="not seq_code">投保人编号：<field name="seq_code" class="oe_inline" /></span>
      </span>
      <field name="name" position="attributes">
        <attribute name="placeholder">投保人名称</attribute>
      </field>
      <group name="gp_account" position="replace"/>
    </field>
  </record>

</odoo>