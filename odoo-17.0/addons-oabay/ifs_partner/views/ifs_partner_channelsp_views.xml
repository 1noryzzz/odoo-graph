<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_partner_channelsp_view_search" model="ir.ui.view">
    <field name="name">ifs.partner.channelsp.view.search</field>
    <field name="model">ifs.partner.channelsp</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_partner.ifs_partner_mixin_view_search" />
    <field name="arch" type="xml">
      <search position="attributes">
        <attribute name="string">服务商查询</attribute>
      </search>
      <search position="inside">
        <field name="seq_code" string="服务商编号"/>
      </search>
    </field>
  </record>

  <record id="ifs_partner_channelsp_view_tree" model="ir.ui.view">
    <field name="name">ifs.partner.channelsp.view.tree</field>
    <field name="model">ifs.partner.channelsp</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_base.ifs_base_company_view_tree" />
    <field name="arch" type="xml">
      <tree position="attributes">
        <attribute name="string">服务商列表</attribute>
        <attribute name="js_class">ifs_partner_create_list</attribute>
        <attribute name="expand">1</attribute>
      </tree>
      <field name="company_code" position="before">
        <field name="seq_code" string="服务商编号"/>
      </field>
      <tree position="inside">
        <control>
          <create name="add_line_control" string="Add a line"/>
        </control>
      </tree>
    </field>
  </record>

  <record id="ifs_partner_channelsp_view_form" model="ir.ui.view">
    <field name="name">ifs.partner.channelsp.view.form</field>
    <field name="model">ifs.partner.channelsp</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ifs_base.ifs_base_company_view_form" />
    <field name="arch" type="xml">
      <form position="attributes">
        <attribute name="js_class">ifs_partner_form</attribute>
      </form>
      <field name="company_id" position="after">
        <field name="ifs_company_id" invisible="1"/>
      </field>
      <span name="ifs_base_company_code" position="replace">
        <span invisible="not seq_code">服务商编号：<field name="seq_code" class="oe_inline" /></span>
      </span>
      <field name="name" position="attributes">
        <attribute name="placeholder">服务商名称</attribute>
      </field>
      <xpath expr="//group[hasclass('gp_legal')]" position="after">
        <field name="finance_id" invisible="1"/>
        <field name="partner_id" invisible="1"/>
        <group class="gp_finance" string="财务联系人信息" invisible="not finance_id">
          <group>
            <field name="finance_name"/>
          </group>
          <group>
            <field name="finance_phone"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>

</odoo>