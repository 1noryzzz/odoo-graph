"  <div class=\"word_content\">\n"
"    <div class=\"word_doc_title\">应收账款转让最高额度合同</div>\n"
"    <div class=\"word_doc_sub_title\">\n"
"        <t t-out=\"object.partner_one.business_id.name\">XXXXX有限公司</t>\n"
"    </div>\n"
