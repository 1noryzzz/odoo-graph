<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="D08_contract" model="ifs.contract.template">
      <field name="name">应收账款结清证明</field>
      <field name="model_id" ref="ifs_gar_contract.model_ifs_contract_info"/>
      <field name="code">D08</field>
      <field name="need_partner">two</field>
      <field name="need_faceid">False</field>
      <field name="category_id" ref="ifs_contract.ifs_contract_category_sup"/>
      <field name="sign_position_params">[
        {},
        {"chaptes": [{"offsetX": 0.65,"offsetY": 0.60}],"page": -1}
      ]</field>
      <field name="body_html" type="html">
        <div>
          <t t-set="params" t-value="json.loads(object.params)"/>
          <link rel="stylesheet" href="/ifs_gar_contract/static/src/css/contract.css" />
          <div class="word_content">

            <div class="word_doc_title">应收账款结清证明</div>
            <div class="word_doc_content_mini word_doc_content_mini_right">文书编号：
              <t t-out="object.code" />
            </div>
            <div class="word_content_start">致：</div>

            <div class="word_content_start">
              <t t-out="object.partner_one.name" contenteditable="false" data-oe-t-inline="true" oe-keep-contenteditable="">亚洲保理（深圳）有限公司（以下简称“亚洲保理”）</t>
            </div>


            <div class="word_inner_content">
              <p>我方已收到                <t t-out="params.get('accounts')"/>
              万元应收账款转让对价款。贵方已履行完毕                <t t-out="params.get('t19_contract_date')" />
              双方签署的《单笔应收账款确认书》（编号:                <t t-out="params.get('t19_contract_code')" />
              ）项下全部义务。
              </p>

              <p class="word_content_start">特此证明！</p>
              <div class="word_doc_content_mini word_doc_content_mini_right">
                <div style="margin-top:200px">应收账款转让方：                  <t t-out="object.partner_two.name"/>
                </div>
                <div>
                  <t t-out="format_date(object.write_date)">年 月 日</t>
                </div>
              </div>
            </div>
          </div>
        </div>
      </field>
    </record>
    
  </data>
</odoo>