<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_entry_supplier_wizard_view_form_inherited" model="ir.ui.view">
    <field name="name">ifs.gar.entry.supplier.wizard.view.inherited</field>
    <field name="model">ifs.gar.entry.step</field>
    <field name="inherit_id" ref="ifs_gar_entry.ifs_gar_entry_supplier_wizard_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@step='6']" position="replace">
        <button string="合同协议" step="6" current_step="current_step" class="o_galaxy_step"/>
        <button string="等待开通" step="7" current_step="current_step" class="o_galaxy_step"/>
      </xpath>
    </field>
  </record>
</odoo>