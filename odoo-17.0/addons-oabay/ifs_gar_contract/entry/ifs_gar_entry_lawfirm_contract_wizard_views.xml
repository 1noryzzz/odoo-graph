<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_gar_entry_lawfirm_contract_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.entry.lawfirm.contract.wizard.view.form</field>
    <field name="model">ifs.gar.entry.lawfirm.contract.wizard</field>
    <field name="inherit_id" ref="ifs_gar_entry.ifs_gar_entry_lawfirm_wizard_view_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <xpath expr="//form" position="attributes">
        <attribute name="class">o_galaxy_form_view</attribute>
      </xpath>
      <xpath expr="//group[hasclass('o_ifs_gar_step_controller')]" position="before">
        <field name="f42_contract_info_id" invisible="1"/>
        <field name="f43_contract_info_id" invisible="1"/>
        <field name="p10_contract_info_id" invisible="1"/>
        <field name="f42_contract_name" invisible="1"/>
        <field name="f43_contract_name" invisible="1"/>
        <field name="p10_contract_name" invisible="1"/>
        <field name="f42_contract_state" invisible="1"/>
        <field name="f43_contract_state" invisible="1"/>
        <field name="p10_contract_state" invisible="1"/>
        <field name="contract_state" invisible="1"/>
        <div string="企业法人签署" class="gp_contract galaxy_entry_group o_ifs_center_img">
          <div invisible="f42_contract_state != 'signed'" class="o_ifs_contract">
            <field nolabel="1" name="f42_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'f42_contract_preview','size': ['300', '190']}"/>
            <div class="o_ifs_contract_text">数字证书托管协议</div>
          </div>
          <div invisible="f43_contract_state != 'signed'" class="o_ifs_contract">
            <field nolabel="1" name="f43_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'f43_contract_preview','size': ['300', '190']}"/>
            <div class="o_ifs_contract_text">CMCA数字证书订户协议</div>
          </div>
          <div invisible="p10_contract_state != 'signed'" class="o_ifs_contract">
            <field nolabel="1" name="p10_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'p10_contract_preview','size': ['300', '190']}"/>
            <div class="o_ifs_contract_text">保理方与律师事务所合作框架协议</div>
          </div>

          <div class="field_f42_contract_info_id o_ifs_contract" invisible="f42_contract_state == 'signed'">
            <span class="o_form_label oe_inline">
              <button name="preview_contract" context="{'contract_id':f42_contract_info_id,'contract_name':f42_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
            </span>
            <div class="o_ifs_contract_text">数字证书托管协议</div>
          </div>
          <div class="field_f43_contract_info_id o_ifs_contract" invisible="f43_contract_state == 'signed'">
            <span class="o_form_label oe_inline">
              <button name="preview_contract" context="{'contract_id':f43_contract_info_id,'contract_name':f43_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
            </span>
            <div class="o_ifs_contract_text">CMCA数字证书订户协议</div>
          </div>
          <div class="field_p10_contract_info_id o_ifs_contract" invisible="p10_contract_state == 'signed'">
            <span class="o_form_label oe_inline">
              <button name="preview_contract" context="{'contract_id':p10_contract_info_id,'contract_name':p10_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
            </span>
            <div class="o_ifs_contract_text">保理方与律师事务所合作框架协议</div>
          </div>
        </div>
      </xpath>

      <xpath expr="//group[hasclass('o_ifs_gar_step_controller')]" position="replace">
        <group class="o_ifs_gar_step_controller" col="3">
          <group colspan="3"></group>
          <group></group>
          <group>
            <button name="nosave_prev" type="object" class="btn btn-secondary btn-next" invisible="not has_prev_step">上一步</button>
            <button name="sign_contract" type="object" class="btn btn-primary btn-next o_has_next" invisible="contract_state">开始签约</button>
            <button name="action_next" type="object" class="btn btn-primary btn-next o_has_next" invisible="not contract_state">确认，下一步</button>
          </group>
          <group></group>
        </group>
      </xpath>

    </field>
  </record>


</odoo>