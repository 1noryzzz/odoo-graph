<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_entry_merchant_approval_info_wizard_view_form_inherited" model="ir.ui.view">
    <field name="name">ifs.gar.entry.merchant.approval.info.wizard.view.form.inherited</field>
    <field name="model">ifs.gar.entry.merchant.approval.info.wizard</field>
    <field name="inherit_id" ref="ifs_gar_review.ifs_gar_entry_merchant_approval_info_wizard_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="attributes">
        <attribute name="js_class">sign_parent_handleNotification</attribute>
      </xpath>
      <xpath expr="//div[hasclass('word_doc_inner_title')]" position="before">
        <field name="t18_contract_info_id" invisible="1"/>
        <field name="t18a_contract_info_id" invisible="1"/>
        <field name="t18_contract_name" invisible="1"/>
        <field name="t18a_contract_name" invisible="1"/>
        <field name="t18_contract_state" invisible="1"/>
        <field name="t18a_contract_state" invisible="1"/>
        <field name="t22_contract_info_id" invisible="1"/>
        <field name="t22_contract_name" invisible="1"/>
        <field name="t22_contract_state" invisible="1"/>
        <field name="contract_state" invisible="1"/>
        <div string="企业法人签署" class="gp_contract galaxy_entry_group o_ifs_center_img">
          <div invisible="t18_contract_state != 'signed'" class="o_ifs_contract">
            <field nolabel="1" name="t18_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 't18_contract_preview','size': ['300', '190']}"/>
            <div class="o_ifs_contract_text">最高子额度合同</div>
          </div>
          <div invisible="t18a_contract_state != 'signed'" class="o_ifs_contract">
            <field nolabel="1" name="t18a_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 't18a_contract_preview','size': ['300', '190']}"/>
            <div class="o_ifs_contract_text">告知确认函</div>
          </div>
          <div invisible="t22_contract_state != 'signed'" class="o_ifs_contract">
            <field nolabel="1" name="t22_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 't22_contract_preview','size': ['300', '190']}"/>
            <div class="o_ifs_contract_text">最高额不可撤销担保书</div>
          </div>

          <div class="field_t18_contract_info_id o_ifs_contract" invisible="t18_contract_state == 'signed'">
            <span class="o_form_label oe_inline">
              <button name="preview_contract" context="{'contract_id':t18_contract_info_id,'contract_name':t18_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
            </span>
            <div class="o_ifs_contract_text">最高子额度合同</div>
          </div>
          <div class="field_t22_contract_info_id o_ifs_contract" invisible="t22_contract_state == 'signed'">
            <span class="o_form_label oe_inline">
              <button name="preview_contract" context="{'contract_id':t22_contract_info_id,'contract_name':t22_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
            </span>
            <div class="o_ifs_contract_text">最高额不可撤销担保书</div>
          </div>
        </div>
      </xpath>
      <xpath expr="//div[hasclass('word_doc_inner_title')]" position="after">
        <div class="word_doc_inner_title" style="color:red;" invisible="contract_state">
          <img src="/ifs_gar_contract/static/description/tips.png" alt="tips"/>
          <span class="entry_column_item_inform">若担保人不为法人，'开始签约'按钮点击后会连续弹出两个二维码，第一个二维码扫码签约成功以后会自动弹出第二个二维码，需要注意查收，若弹窗被关闭全部需要重签</span>
        </div>
      </xpath>
      <button name="action_sign" position="replace">
        <button name="action_sign" type="object" class="btn btn-primary btn-next" invisible="not contract_state">确认开通</button>
        <button name="sign_contract" type="object" class="btn btn-primary btn-next o_has_next" invisible="contract_state">开始签约</button>
      </button>
    </field>
  </record>
</odoo>