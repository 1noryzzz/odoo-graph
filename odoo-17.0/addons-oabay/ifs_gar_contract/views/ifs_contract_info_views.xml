<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_contract_info_view_form_inherited" model="ir.ui.view">
    <field name="name">ifs.contract.info.view.form.inherited</field>
    <field name="model">ifs.contract.info</field>
    <field name="inherit_id" ref="ifs_contract.ifs_contract_info_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/*[1]" position="before">
        <div class="oe_button_box" name="button_box">
          <button class="oe_stat_button" icon="fa-edit" name="contract_edit" type="object" 
            invisible="state not in ['draft','unconfirmed']" groups="ifs_gar_contract.group_ifs_gar_contract_factor_contract_edit">
            <div class="o_form_field o_stat_info">
              <span class="o_stat_text">编辑合同</span>
            </div>
          </button>
        </div>
      </xpath>
    </field>
  </record>

  <record id="ifs_contract_info_view_form_edit" model="ir.ui.view">
    <field name="name">ifs.contract.info.view.form.edit</field>
    <field name="model">ifs.contract.info</field>
    <field name="priority" eval="99"/>
    <field name="arch" type="xml">
      <form string="编辑合同" class="contract_sign">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" icon="fa-edit" name="contract_view" type="object">
              <div class="o_form_field o_stat_info">
                <span class="o_stat_text">合同预览</span>
              </div>
            </button>
          </div>
          <field string="模板内容" name="template_content"/>
        </sheet>
        <footer>
          <button string="保存" type="object" name="contract_view" class="btn-primary"/>
          <button string="关闭" class="btn-secondary" special="cancel" data-hotkey="z"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>