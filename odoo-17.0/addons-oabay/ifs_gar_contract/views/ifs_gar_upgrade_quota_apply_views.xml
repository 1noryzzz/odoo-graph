<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_gar_upgrade_quota_apply_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.upgrade.quota.apply.view.form</field>
    <field name="model">ifs.gar.upgrade.quota.apply</field>
    <field name="inherit_id" ref="ifs_gar_account.ifs_gar_upgrade_quota_apply_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[hasclass('gp_info')]" position="after">
        <group invisible="not x10_contract_info_id">
          <group string="额度申请书" colspan="2"/>
        </group>
        <field name="x10_contract_info_id" invisible="1"/>
        <field name="x10_contract_name" invisible="1"/>
        <field name="x10_contract_state" invisible="1"/>
        <field name="x11_contract_info_id" invisible="1"/>
        <field name="x11_contract_name" invisible="1"/>
        <field name="x11_contract_state" invisible="1"/>
        <div string="合同查阅" class="gp_contract galaxy_entry_group o_ifs_center_img">
          <div invisible="x10_contract_state != 'signed'" class="o_ifs_contract field_x10_contract_pdf"
            groups="ifs_gar_account.group_ifs_gar_account_factor_user,ifs_gar_account.group_ifs_gar_account_supplier_user">
            <field nolabel="1" name="x10_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'x10_contract_preview','size': ['300', '190']}"/>
            <div class="o_ifs_contract_text">额度调整申请书</div>
          </div>
          <div invisible="x11_contract_state != 'signed'" class="o_ifs_contract field_x11_contract_pdf"
            groups="ifs_gar_account.group_ifs_gar_account_factor_user,ifs_gar_account.group_ifs_gar_account_supplier_user">
            <field nolabel="1" name="x11_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'x11_contract_preview','size': ['300', '190']}"/>
            <div class="o_ifs_contract_text">额度调整确认书</div>
          </div>

          <div class="field_x10_contract_info_id o_ifs_contract" invisible="not x10_contract_info_id or x10_contract_state != 'signed'"
             groups="ifs_gar_account.group_ifs_gar_account_factor_user,ifs_gar_account.group_ifs_gar_account_supplier_user">
            <span class="o_form_label oe_inline">
              <button name="preview_contract" context="{'contract_id':x10_contract_info_id,'contract_name':x10_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
            </span>
            <div class="o_ifs_contract_text">额度调整申请书</div>
          </div>
          <div class="field_x11_contract_info_id o_ifs_contract" invisible="not x11_contract_info_id or x11_contract_state != 'signed'"
             groups="ifs_gar_account.group_ifs_gar_account_factor_user,ifs_gar_account.group_ifs_gar_account_supplier_user">
            <span class="o_form_label oe_inline">
              <button name="preview_contract" context="{'contract_id':x11_contract_info_id,'contract_name':x11_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
            </span>
            <div class="o_ifs_contract_text">额度调整确认书</div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>