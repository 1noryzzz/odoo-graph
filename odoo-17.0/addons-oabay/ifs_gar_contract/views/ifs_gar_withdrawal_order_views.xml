<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_gar_withdrawal_order_view_from_contract_inherited" model="ir.ui.view">
    <field name="name">ifs.gar.withdrawal.order.view.from.contract.inherited</field>
    <field name="model">ifs.gar.withdrawal.order</field>
    <field name="inherit_id" ref="ifs_gar_withdrawal.ifs_gar_withdrawal_order_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('field_t19_contract_pdf')]" position="before">
        <div class="o_ifs_contract" invisible="not pay_order"
          groups="ifs_gar_withdrawal.group_ifs_gar_withdrawal_order_merchant_withdrawal,ifs_gar_withdrawal.group_ifs_gar_withdrawal_order_factor_withdrawal">
          <field name="pay_order" widget="image" nolabel="1"/>
          <div class="o_ifs_contract_text">支付凭证</div>
        </div>
      </xpath>
      <xpath expr="//div[hasclass('field_t20_contract_info_id')]" position="after">
        <field name="d09_contract_info_id" invisible="1"/>
        <field name="d09_contract_name" invisible="1"/>
        <field name="d09_contract_state" invisible="1"/>
        <div invisible="d09_contract_state != 'signed'" class="o_ifs_contract"
          groups="ifs_gar_withdrawal.group_ifs_gar_withdrawal_order_merchant_withdrawal,ifs_gar_withdrawal.group_ifs_gar_withdrawal_order_factor_withdrawal">
          <field nolabel="1" name="d09_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','size': ['180', '270']}"/>
          <div class="o_ifs_contract_text">应付账款结清证明</div>
        </div>
        <div class="field_d09_contract_info_id o_ifs_contract" invisible="not d09_contract_info_id or d09_contract_state == 'signed'"
          groups="ifs_gar_withdrawal.group_ifs_gar_withdrawal_order_merchant_withdrawal,ifs_gar_withdrawal.group_ifs_gar_withdrawal_order_factor_withdrawal">
          <span class="o_form_label oe_inline">
            <button name="preview_contract" context="{'contract_id':d09_contract_info_id,'contract_name':d09_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
          </span>
          <div class="o_ifs_contract_text">应付账款结清证明</div>
        </div>
      </xpath>
    </field>
  </record>

</odoo>