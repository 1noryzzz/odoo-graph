<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="ifs_gar_trade_order_view_from_contract_inherited" model="ir.ui.view">
    <field name="name">ifs.gar.trade.order.view.from.contract.inherited</field>
    <field name="model">ifs.gar.trade.order</field>
    <field name="inherit_id" ref="ifs_gar_trade.ifs_gar_trade_order_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='fields_item_ids']" position="after">
        <field name="d08_contract_info_id" invisible="1"/>
        <field name="d09_contract_info_id" invisible="1"/>
        <field name="t19_contract_info_id" invisible="1"/>
        <field name="t20_contract_info_id" invisible="1"/>
        <field name="c13_contract_info_id" invisible="1"/>
        <field name="c14_contract_info_id" invisible="1"/>
        <field name="d08_contract_name" invisible="1"/>
        <field name="d09_contract_name" invisible="1"/>
        <field name="t19_contract_name" invisible="1"/>
        <field name="t20_contract_name" invisible="1"/>
        <field name="c13_contract_name" invisible="1"/>
        <field name="c14_contract_name" invisible="1"/>
        <field name="d08_contract_state" invisible="1"/>
        <field name="d09_contract_state" invisible="1"/>
        <field name="t19_contract_state" invisible="1"/>
        <field name="t20_contract_state" invisible="1"/>
        <field name="c13_contract_state" invisible="1"/>
        <field name="c14_contract_state" invisible="1"/>
        <field name="partner_in_order" invisible="1"/>
        <group>
          <group string="合同查阅" colspan="2">
            <label for="t19_contract_info_id"/>
            <div string="合同查阅" class="oe_inline gp_contract galaxy_entry_group o_ifs_center_img">
              <div invisible="partner_in_order not in ['factor', 'supplier'] or t19_contract_state != 'signed'" class="o_ifs_contract field_t19_contract_pdf"
                groups="ifs_gar_trade.group_ifs_gar_trade_order_factor_user,ifs_gar_trade.group_ifs_gar_trade_order_supplier_user">
                <field nolabel="1" name="t19_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 't19_contract_preview','size': ['300', '190']}"/>
                <div class="o_ifs_contract_text">应收账款转让确认书</div>
              </div>
              <div invisible="partner_in_order not in ['factor', 'supplier'] or d08_contract_state != 'signed'"  class="o_ifs_contract field_d08_contract_pdf"
                groups="ifs_gar_trade.group_ifs_gar_trade_order_factor_user,ifs_gar_trade.group_ifs_gar_trade_order_supplier_user">
                <field nolabel="1" name="d08_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'd08_contract_preview','size': ['300', '190']}"/>
                <div class="o_ifs_contract_text">应收账款结清证明</div>
              </div>
              <div invisible="partner_in_order not in ['factor', 'merchant'] or t20_contract_state != 'signed'"  class="o_ifs_contract field_t20_contract_pdf"
                groups="ifs_gar_trade.group_ifs_gar_trade_order_factor_user,ifs_gar_trade.group_ifs_gar_trade_order_merchant_user">
                <field nolabel="1" name="t20_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 't20_contract_preview','size': ['300', '190']}"/>
                <div class="o_ifs_contract_text">应付账款转让确认书</div>
              </div>
              <div invisible="partner_in_order not in ['factor', 'merchant'] or d09_contract_state != 'signed'"  class="o_ifs_contract field_d09_contract_pdf"
                groups="ifs_gar_trade.group_ifs_gar_trade_order_factor_user,ifs_gar_trade.group_ifs_gar_trade_order_merchant_user">
                <field nolabel="1" name="d09_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'd09_contract_preview','size': ['300', '190']}"/>
                <div class="o_ifs_contract_text">应付账款结清证明</div>
              </div>
              <div invisible="partner_in_order not in ['factor', 'supplier'] or c13_contract_state != 'signed'"  class="o_ifs_contract field_d09_contract_pdf"
                groups="ifs_gar_trade.group_ifs_gar_trade_order_factor_user,ifs_gar_trade.group_ifs_gar_trade_order_supplier_user,ifs_gar_trade.group_ifs_gar_trade_order_merchant_user">
                <field nolabel="1" name="c13_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'c13_contract_preview','size': ['300', '190']}"/>
                <div class="o_ifs_contract_text">应收账款熔断通知书</div>
              </div>
              <div invisible="partner_in_order not in ['factor', 'merchant'] or c14_contract_state != 'signed'"  class="o_ifs_contract field_d09_contract_pdf"
                groups="ifs_gar_trade.group_ifs_gar_trade_order_factor_user,ifs_gar_trade.group_ifs_gar_trade_order_supplier_user,ifs_gar_trade.group_ifs_gar_trade_order_merchant_user">
                <field nolabel="1" name="c14_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'c14_contract_preview','size': ['300', '190']}"/>
                <div class="o_ifs_contract_text">应收账款回转告知函</div>
              </div>

              <div class="field_t19_contract_info_id o_ifs_contract" invisible="partner_in_order not in ['factor', 'supplier'] or t19_contract_state == 'signed'"
                groups="ifs_gar_trade.group_ifs_gar_trade_order_factor_user,ifs_gar_trade.group_ifs_gar_trade_order_supplier_user">
                <span class="o_form_label oe_inline">
                  <button name="preview_contract" context="{'contract_id':t19_contract_info_id,'contract_name':t19_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
                </span>
                <div class="o_ifs_contract_text">应收账款转让确认书</div>
              </div>
              <div class="field_t20_contract_info_id o_ifs_contract" invisible="partner_in_order not in ['factor', 'merchant'] or t20_contract_state == 'signed'"
                groups="ifs_gar_trade.group_ifs_gar_trade_order_factor_user,ifs_gar_trade.group_ifs_gar_trade_order_merchant_user">
                <span class="o_form_label oe_inline">
                  <button name="preview_contract" context="{'contract_id':t20_contract_info_id,'contract_name':t20_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
                </span>
                <div class="o_ifs_contract_text">应付账款转让确认书</div>
              </div>
            </div>
          </group>
        </group>
      </xpath>
    </field>
  </record>

</odoo>