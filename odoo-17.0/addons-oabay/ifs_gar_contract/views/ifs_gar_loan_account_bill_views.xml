<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ifs_gar_loan_account_bill_view_form_inherited" model="ir.ui.view">
        <field name="name">ifs.gar.loan.account.bill.view.form.inherited</field>
        <field name="model">ifs.gar.loan.account.bill</field>
        <field name="inherit_id" ref="ifs_gar_trade.ifs_gar_loan_account_bill_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[hasclass('transaction_info')]" position="after">
                <group string="2/该笔交易相关附件" col="4">
                    <group groups="ifs_gar_trade.group_ifs_gar_trade_order_supplier_user, ifs_gar_trade.group_ifs_gar_trade_order_factor_user">
                        <field name="t19_contract_pdf" widget="pdf_viewer"/>
                    </group>
                    <group groups="ifs_gar_trade.group_ifs_gar_trade_order_merchant_user, ifs_gar_trade.group_ifs_gar_trade_order_factor_user">
                        <field name="t20_contract_pdf" widget="pdf_viewer"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
