<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_entry_merchant_view_form_inherit" model="ir.ui.view">
    <field name="name">ifs.gar.entry.merchant.view.form.inherit</field>
    <field name="model">ifs.gar.entry.merchant</field>
    <field name="inherit_id" ref="ifs_gar_entry.ifs_gar_entry_merchant_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//page[hasclass('pg_doc')]" position="before">
        <page string="签约合同" class="pg_contract">
          <field name="t18_contract_info_id" invisible="1"/>
          <field name="t18a_contract_info_id" invisible="1"/>
          <field name="t22_contract_info_id" invisible="1"/>
          <field name="f41_contract_info_id" invisible="1"/>
          <field name="f42_contract_info_id" invisible="1"/>
          <field name="f43_contract_info_id" invisible="1"/>
          <field name="guarantor_contract_info_id" invisible="1"/>
          <field name="t18_contract_name" invisible="1"/>
          <field name="t18a_contract_name" invisible="1"/>
          <field name="t22_contract_name" invisible="1"/>
          <field name="f41_contract_name" invisible="1"/>
          <field name="f42_contract_name" invisible="1"/>
          <field name="f43_contract_name" invisible="1"/>
          <field name="guarantor_contract_name" invisible="1"/>
          <field name="t18_contract_state" invisible="1"/>
          <field name="t18a_contract_state" invisible="1"/>
          <field name="t22_contract_state" invisible="1"/>
          <field name="f41_contract_state" invisible="1"/>
          <field name="f42_contract_state" invisible="1"/>
          <field name="f43_contract_state" invisible="1"/>
          <field name="guarantor_contract_state" invisible="1"/>
          <div string="企业法人签署" class="gp_contract galaxy_entry_group o_ifs_center_img">
            <div invisible="f41_contract_state != 'signed'" class="o_ifs_contract">
              <field nolabel="1" name="f41_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'f41_contract_preview','size': ['300', '190']}"/>
              <div class="o_ifs_contract_text">征信查询授权书</div>
            </div>
            <div invisible="f42_contract_state != 'signed'" class="o_ifs_contract">
              <field nolabel="1" name="f42_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'f42_contract_preview','size': ['300', '190']}"/>
              <div class="o_ifs_contract_text">数字证书托管协议</div>
            </div>
            <div invisible="f43_contract_state != 'signed'" class="o_ifs_contract">
              <field nolabel="1" name="f43_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'f43_contract_preview','size': ['300', '190']}"/>
              <div class="o_ifs_contract_text">CMCA数字证书订户协议</div>
            </div>
            <div invisible="t18_contract_state != 'signed'" class="o_ifs_contract">
              <field nolabel="1" name="t18_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 't18_contract_preview','size': ['300', '190']}"/>
              <div class="o_ifs_contract_text">最高子额度合同</div>
            </div>
            <div invisible="t18a_contract_state != 'signed'" class="o_ifs_contract">
              <field nolabel="1" name="t18a_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 't18a_contract_preview','size': ['300', '190']}"/>
              <div class="o_ifs_contract_text">告知确认函</div>
            </div>
            <div invisible="t22_contract_state != 'signed'" class="o_ifs_contract">
              <field nolabel="1" name="t22_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 't22_contract_preview','size': ['300', '190']}"/>
              <div class="o_ifs_contract_text">最高额不可撤销担保书</div>
            </div>
            <div invisible="guarantor_contract_state != 'signed'" class="o_ifs_contract">
              <field nolabel="1" name="guarantor_contract_pdf" widget="pdf_viewer" options="{'previewPlaceholder': 'galaxy_attachment_preview/static/img/placeholder.png','previewImage': 'guarantor_contract_preview','size': ['300', '190']}"/>
              <div class="o_ifs_contract_text">担保人征信查询授权书</div>
            </div>

            <div class="field_f41_contract_info_id o_ifs_contract" invisible="f41_contract_state == 'signed'">
              <span class="o_form_label oe_inline">
                <button name="preview_contract" context="{'contract_id':f41_contract_info_id,'contract_name':f41_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
              </span>
              <div class="o_ifs_contract_text">征信查询授权书</div>
            </div>
            <div class="field_f42_contract_info_id o_ifs_contract" invisible="f42_contract_state == 'signed'">
              <span class="o_form_label oe_inline">
                <button name="preview_contract" context="{'contract_id':f42_contract_info_id,'contract_name':f42_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
              </span>
              <div class="o_ifs_contract_text">数字证书托管协议</div>
            </div>
            <div class="field_f43_contract_info_id o_ifs_contract" invisible="f43_contract_state == 'signed'">
              <span class="o_form_label oe_inline">
                <button name="preview_contract" context="{'contract_id':f43_contract_info_id,'contract_name':f43_contract_name}" type="object" class="btn btn-secondary btn_contract"/>
              </span>
              <div class="o_ifs_contract_text">CMCA数字证书订户协议</div>
            </div>
          </div>
        </page>
      </xpath>
    </field>
  </record>
</odoo>