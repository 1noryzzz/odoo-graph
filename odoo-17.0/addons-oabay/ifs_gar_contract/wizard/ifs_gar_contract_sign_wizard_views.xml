<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ifs_gar_contract_sign_wizard_view_form" model="ir.ui.view">
    <field name="name">ifs.gar.contract.sign.wizard.view.form</field>
    <field name="model">ifs.gar.contract.sign.wizard</field>
    <field name="arch" type="xml">
      <form class="oe_form_configuration o_base_settings" js_class="ifs_contract_sign">
        <sheet>
          <field name="sign_token_id" invisible="1" />
          <field name="sign_url" invisible="1" />
          <group col="1">
            <group>
              <field name="contract_info_ids" mode="tree">
                <tree>
                  <field name="code"/>
                  <field name="name"/>
                </tree>
              </field>
            </group>
            <group class="sign_qrcode">
              <field name="sign_qrcode" widget="image" />
            </group>
          </group>
        </sheet>
        <footer>
          <button string="关闭" class="btn-secondary" special="cancel" data-hotkey="z"/>
        </footer>
      </form>
    </field>
  </record>


