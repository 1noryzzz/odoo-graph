<odoo>
  <data>

    <record id="ifs_partner_suplier_view_form_inherited" model="ir.ui.view">
      <field name="name">ifs.partner.supplier.view.form.inherited</field>
      <field name="model">ifs.partner.supplier</field>
      <field name="inherit_id" ref="ifs_partner.ifs_partner_supplier_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//page[hasclass('pg_base')]" position="after">
          <page name="supplier_business_info" string="企业信息" 
            groups="ifs_partner.group_ifs_partner_factor_user">
            <button string="刷新" name="refresh_business_registration" type="object" class="btn-primary float-right"/>
            <group title="工商信息" string="工商信息" col="2" class="ifs_group">
              <group class="o_group_label_lg">
                <field name="credit_no"/>
              </group>
              <group>
                <field name="full_name" string="名称"/>
              </group>
              <group>
                <field name="company_type" string="类型"/>
              </group>
              <group>
                <field name="legal_person" string="法定代表人"/>
              </group>
              <group>
                <field name="capital" />
              </group>
              <group>
                <field name="establish_date" />
              </group>
              <group>
                <field name="business_date_from" string="经营期限自"/>
              </group>
              <group>
                <field name="business_date_to" string="经营期限至"/>
              </group>
              <group>
                <field name="business_authority" />
              </group>
              <group>
                <field name="business_state" string="登记状态"/>
              </group>
              <group>
                <field name="address" string="地址"/>
              </group>
              <group>
                <field name="business_scope" />
              </group>
            </group>
            <group string="工商登记股东" colspan="2"  attrs="{'invisible': [('stock_ids', '=', [])]}">
              <field name="stock_ids" nolabel="1"  colspan="2" class="oe_inline oe_inline_full" mode="tree" groups="ifs_partner.group_ifs_partner_factor_user">
                <tree no_open="1" create="0" edit="0">
                  <field name="name"/>
                  <field name="stock_type"/>
                  <field name="stock_capital" />
                  <field name="stock_realcapital" />
                  <field name="stock_percent" />
                </tree>
              </field>
            </group>
            <group string="工商登记股东" attrs="{'invisible': [('stock_ids', '!=', [])]}">
              <p style="text-align: center">
                    暂无股东
              </p>
            </group>
            <group string="主要成员" colspan="2"  attrs="{'invisible': [('employee_ids', '=', [])]}">
              <field name="employee_ids" nolabel="1" colspan="2"  mode="tree" groups="ifs_partner.group_ifs_partner_factor_user">
                <tree no_open="1" create="0" edit="0">
                  <field name="name"/>
                  <field name="position"/>
                </tree>
              </field>
            </group>
            <group string="主要成员" attrs="{'invisible': [('employee_ids', '!=', [])]}">
              <p style="text-align: center">
                    暂无成员
              </p>
            </group>
          </page>
        </xpath>
      </field>
    </record>

  </data>
</odoo>