<odoo>
  <data>

    <record id="ifs_partner_merchant_view_form_business_cradits_inherited" model="ir.ui.view">
      <field name="name">ifs.partner.merchant.view.form.business.credits.inherited</field>
      <field name="model">ifs.partner.merchant</field>
      <field name="inherit_id" ref="ifs_partner.ifs_partner_merchant_view_form"/>
      <field name="arch" type="xml">
        <group name="gp_account" position="after">
          <group string="企业供应商" invisible="main_supplier_ids == []">
            <group/>
            <field name="main_supplier_ids" mode="kanban" class="o_galaxy_properties">
              <kanban class="o_galaxy_kanban_properties">
                <field name="definition_id"/>
                <field name="json_datas"/>
                <templates>
                  <t t-name="kanban-box">
                    <div t-attf-class="oe_kanban_card">
                      <field name="json_datas" widget="dynamic_properties" columns="6"/>
                    </div>
                  </t>
                </templates>
              </kanban>
            </field>
          </group>

          <group string="企业客户" invisible="main_customers_ids == []">
            <group/>
            <field name="main_customers_ids" mode="kanban" class="o_galaxy_properties">
              <kanban class="o_galaxy_kanban_properties">
                <field name="definition_id"/>
                <field name="json_datas"/>
                <templates>
                  <t t-name="kanban-box">
                    <div t-attf-class="oe_kanban_card">
                      <field name="json_datas" widget="dynamic_properties" columns="6"/>
                    </div>
                  </t>
                </templates>
              </kanban>
            </field>
          </group>

          <group string="1.3企业无形资产" col="1" class="gp_intangible_assets ifs_group">
            <group>
              <field name="trademark_ids" propertiesField="json_datas" options="{'tag_names': ['tmName']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
              <field name="software_copyright_ids" propertiesField="json_datas" options="{'tag_names': ['fullname']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
              <field name="website_ids" string="企业域名" propertiesField="json_datas" options="{'tag_names': ['ym']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
              <field name="certificate_ids" propertiesField="json_datas" options="{'tag_names': ['certificateName']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
              <field name="wechat_ids" propertiesField="json_datas" options="{'tag_names': ['title']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
              <field name="patent_ids" propertiesField="json_datas" options="{'tag_names': ['patentName']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
              <field name="copyright_ids" propertiesField="json_datas" options="{'tag_names': ['fullname']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
              <field name="website_ids" string="网址" propertiesField="json_datas" options="{'tag_names': ['webSite']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
              <field name="weibo_ids" propertiesField="json_datas" options="{'tag_names': ['name']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
              <field name="taxpayer_type_ids" propertiesField="json_datas" options="{'tag_names': ['taxpayerQualificationType']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
              <field name="history_legal_person_ids" propertiesField="json_datas" options="{'tag_names': ['name']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
              <field name="history_stock_ids" propertiesField="json_datas" options="{'tag_names': ['name']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
              <field name="history_staffer_ids" propertiesField="json_datas" options="{'tag_names': ['name']}" widget="many2many_tags_properties">
                <tree>
                  <field name="json_datas"/>
                </tree>
              </field>
            </group>
          </group>
        </group>
        <page name="contact_info" position="before">
          <page name="mechant_business_credits" string="企业信用" class="pg_business_credits" groups="ifs_partner.group_ifs_partner_factor_user,ifs_partner.group_ifs_partner_supplier_manager">
            <group string="司法协助" col="1">
              <group/>
              <field name="judicial_ids" mode="kanban" class="o_galaxy_properties" invisible="judicial_ids == []">
                <kanban class="o_galaxy_kanban_properties">
                  <field name="definition_id"/>
                  <field name="json_datas"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="2"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>
              <p style="text-align: center" invisible="judicial_ids != []" colspan="2">
                    暂无司法协助信息
              </p>
            </group>

            <group string="被执行人" col="1">
              <group/>
              <field name="executee_ids" nolabel="1" mode="kanban" class="o_galaxy_properties" invisible="executee_ids == []">
                <kanban class="o_galaxy_kanban_properties o_group_label_lg">
                  <field name="definition_id"/>
                  <field name="json_datas"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="2"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>
              <p style="text-align: center" invisible="executee_ids != []">
                    暂无被执行人信息
              </p>
            </group>

            <group string="失信被执行人" col="1">
              <group/>
              <field name="dishonest_ids" nolabel="1" mode="kanban" class="o_galaxy_properties" invisible="dishonest_ids == []">
                <kanban class="o_galaxy_kanban_properties o_group_label_lg">
                  <field name="definition_id"/>
                  <field name="json_datas"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="2"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>
              <p style="text-align: center" invisible="dishonest_ids != []">
                    暂无失信被执行人
              </p>
            </group>

            <group string="判决文书" col="1">
              <group/>
              <field name="judgment_ids" nolabel="1" mode="kanban" class="o_galaxy_properties" invisible="judgment_ids == []">
                <kanban class="o_galaxy_kanban_properties o_group_label_lg">
                  <field name="definition_id"/>
                  <field name="json_datas"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="2"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>
              <p style="text-align: center" invisible="judgment_ids != []">
                    暂无判决文书
              </p>
            </group>

            <group string="行政处罚" col="1">
              <group/>
              <field name="punishment_ids" nolabel="1" mode="kanban" invisible="punishment_ids == []">
                <kanban class="o_galaxy_kanban_properties">
                  <field name="json_datas"/>
                  <field name="definition_id"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="2"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>
              <p style="text-align: center" invisible="punishment_ids != []">
                    暂无行政处罚
              </p>
            </group>

            <group string="异常名录" col="1">
              <group/>
              <field name="abnormal_ids" nolabel="1" mode="kanban" invisible="abnormal_ids == []">
                <kanban class="o_galaxy_kanban_properties">
                  <field name="json_datas"/>
                  <field name="definition_id"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="2"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>
              <p style="text-align: center" invisible="abnormal_ids != []">
                    暂无异常信息
              </p>
            </group>

            <group string="抵押登记" col="1">
              <group/>
              <field name="mortgage_ids" nolabel="1" mode="kanban" invisible="mortgage_ids == []">
                <kanban class="o_galaxy_kanban_properties">
                  <field name="json_datas"/>
                  <field name="definition_id"/>
                  <templates>
                    <t t-name="kanban-box">
                      <div t-attf-class="oe_kanban_card">
                        <field name="json_datas" widget="dynamic_properties" columns="2"/>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>
              <p style="text-align: center" invisible="mortgage_ids != []">
                    暂无抵押登记信息
              </p>
            </group>
          </page>
        </page>
      </field>
    </record>

  </data>
</odoo>