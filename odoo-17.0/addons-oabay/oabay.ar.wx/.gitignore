# uniapp项目通用忽略规则
# 开发工具生成的文件
.idea/
.vscode/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 依赖目录
node_modules/

# 编译输出目录
dist/

# 本地配置文件
.env.local
.env.development
.env.production

# 测试报告
coverage/

# 日志文件
logs/
*.log

# 临时文件
temp/
tmp/

# HBuilderX相关
unpackage/
hbuilderx.log
manifest.json.user

# 自定义插件
custom_components/

# 微信开发者工具相关
miniprogram/.idea/
miniprogram/.vscode/
miniprogram/project.config.json

# 云函数相关
cloudfunctions-aliyun/
cloudfunctions-tcb/

# 自定义环境配置
config/

# 本地用户配置
local/

# 图片缓存
image-cache/

# 自动生成的文件
auto-generated/

# 临时构建文件
build-temp/