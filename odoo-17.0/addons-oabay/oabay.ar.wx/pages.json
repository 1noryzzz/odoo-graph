{
	"easycom": {
		"autoscan": true,
		"custom": {
			// "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
	        "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
		}
	},
	"pages": [ //pages数组中第一项表示应用启动页
		{
			"path": "pages/transition/transition",
			"style": {
			"navigationBarTitleText": "过渡页",
			"navigationStyle": "custom",
			"navigationBarHidden": true, // 隐藏导航栏（全屏过渡页）
			"enablePullDownRefresh": false // 禁用下拉刷新
			}
		},
		{
			"path": "pages/login/index",
			"style": {
				"navigationBarTitleText": "登录页"
			}
		},
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "首页",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/list/index",
			"style": {
				"navigationBarTitleText": "列表",
				"enablePullDownRefresh": true
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#f3f1f6",
		"backgroundColor": "#fdf5e6"
	},
	"tabBar": {
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页",
				"iconPath": "static/home.png",
				"selectedIconPath": "static/s-home.png"
			},
			{
				"pagePath": "pages/list/index",
				"text": "首页2",
				"iconPath": "static/user.png",
				"selectedIconPath": "static/s-user.png"
			}
			
		]
	}
}