<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_galaxy_open_api" model="ir.module.category">
    <field name="name">开放平台基础分类</field>
    <field name="visible" eval="0"/>
    <field name="description">云腾智慧开放平台基础分类</field>
  </record>

  <record id="group_galaxy_open_api_user" model="res.groups">
    <field name="name">开放平台用户</field>
    <field name="category_id" ref="galaxy_open_api.module_category_galaxy_open_api"/>
    <field name="comment">云腾智慧开放平台用户</field>
  </record>

  <record id="group_galaxy_open_api_manager" model="res.groups">
    <field name="name">外部接口管理</field>
    <field name="category_id" ref="galaxy_open_api.module_category_galaxy_open_api"/>
    <field name="implied_ids" eval="[Command.set([ref('galaxy_open_api.group_galaxy_open_api_user')])]"/>
    <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    <field name="comment">云腾智慧开放平台管理组</field>
  </record>

  <record id="group_galaxy_open_api_public_user_id" model="res.users">
    <field name="name">开发平台默认用户</field>
    <field name="login">open_api_public_user</field>
    <field name="active" eval="False"/>
    <field name="lang">zh_CN</field>
    <field name="tz">Asia/Shanghai</field>
    <field name="image_1920" type="base64" file="galaxy_open_api/static/description/icon.png"/>
    <field name="groups_id" eval="[Command.set([ref('galaxy_open_api.group_galaxy_open_api_user')])]"/>
  </record>
</odoo>
