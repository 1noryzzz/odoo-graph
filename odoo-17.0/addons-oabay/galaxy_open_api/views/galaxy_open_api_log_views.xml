<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="galaxy_open_api_log_view_search" model="ir.ui.view">
      <field name="name">galaxy.open.api.log.view.search</field>
      <field name="model">galaxy.open.api.log</field>
      <field name="arch" type="xml">
        <search string="开放平台日志查询">
          <field name="uri" string="URI"/>
          <field name="ip" string="IP"/>
          <field name="api_app_id" string="应用"/>
          <group expand="1" string="Group By">
            <filter name="group_state" context="{'group_by': 'is_error'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="galaxy_open_api_log_view_tree" model="ir.ui.view">
      <field name="name">galaxy.open.api.log.view.tree</field>
      <field name="model">galaxy.open.api.log</field>
      <field name="arch" type="xml">
        <tree string="开放平台日志列表" sample="1" default_order="create_date DESC">
          <field name="api_app_id" string="应用"/>
          <field name="ip" string="IP"/>
          <field name="uri" string="URI"/>
          <field name="create_date" string="请求时间"/>
          <field name="is_error" string="是否出错"/>
          <field name="request_data" string="请求参数" widget="json" optional="show"/>
          <field name="response_data" string="响应内容" widget="json" optional="show"/>
        </tree>
      </field>
    </record>

    <record id="galaxy_open_api_log_view_form" model="ir.ui.view">
      <field name="name">galaxy.open.api.log.view.form</field>
      <field name="model">galaxy.open.api.log</field>
      <field name="arch" type="xml">
        <form class="o_galaxy_form_view" create="0" edit="0">
          <sheet>
            <group string="基本信息">
              <group >
                <field name="api_app_id" string="应用"/>
                <field name="uri" string="URI"/>
                <field name="is_error" string="是否出错"/>
              </group>
              <group >
                <field name="ip" string="IP"/>
                <field name="create_date" string="请求时间"/>
              </group>
            </group>
            <group string="请求">
              <group colspan="2">
                <field name="request_data" widget="json"/>
              </group>
            </group>
            <group string="响应">
              <group colspan="2">
                <field name="response_data" string="响应信息" widget="json"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

  </data>
</odoo>